// Sengi OS shared component library. Every Sengi OS UI builds on these.
// Generated from ui/components.slint.in so the motion easing comes from the
// tokens; edit the .in file.

import { Tokens, ThemeSwitch } from "tokens.slint";
import { IconPaths } from "icon-paths.slint";

export { Tokens, ThemeSwitch }

// One of the Phosphor Bold icons in ui/icons/phosphor/bold, by its name without
// the "-bold" ending, filled in `ink`. It is the size of a bar icon unless
// its width and height are set. A name that has no file draws nothing.
export component SengiIcon inherits Path {
    in property <string> name;
    in property <brush> ink: Tokens.color-text;

    width: Tokens.bar-icon;
    height: Tokens.bar-icon;
    viewbox-width: 256;
    viewbox-height: 256;
    commands: IconPaths.path(root.name);
    fill: root.ink;
}

// Wi-Fi at `level` 0 to 4: no bars, one, two, or all of them. The bars that
// are not lit stay drawn in `faint`, so level 0 is still the Wi-Fi symbol
// (Phosphor's own "wifi-none" is a lone dot).
export component SengiSignalIcon inherits Rectangle {
    in property <int> level: 4;
    in property <brush> ink: Tokens.color-text;
    in property <brush> faint: Tokens.color-text-disabled;

    width: Tokens.bar-icon;
    height: Tokens.bar-icon;

    SengiIcon {
        width: parent.width;
        height: parent.height;
        name: "wifi-high";
        ink: root.faint;
    }

    SengiIcon {
        width: parent.width;
        height: parent.height;
        visible: root.level > 0;
        name: root.level >= 4 ? "wifi-high"
            : root.level == 3 ? "wifi-medium"
            : root.level == 2 ? "wifi-low" : "wifi-none";
        ink: root.ink;
    }
}

export component SengiSpeakerIcon inherits SengiIcon {
    in property <bool> muted: false;

    name: root.muted ? "speaker-x" : "speaker-high";
}

// A battery at `percent`, in the nearest of five fills, or the charging one.
// `charge` colours it while it is not charging, for a low battery.
export component SengiBatteryIcon inherits SengiIcon {
    in property <int> percent: 100;
    in property <bool> charging: false;
    in property <brush> charge: root.ink;

    name: root.charging ? "battery-charging"
        : root.percent > 87 ? "battery-full"
        : root.percent > 62 ? "battery-high"
        : root.percent > 37 ? "battery-medium"
        : root.percent > 12 ? "battery-low" : "battery-empty";
    fill: root.charging ? root.ink : root.charge;
}

export component SengiText inherits Text {
    color: Tokens.color-text;
    font-family: Tokens.font-family;
    font-size: Tokens.font-size-md;
    font-weight: Tokens.font-weight-regular;
}

export component SengiLabel inherits Text {
    color: Tokens.color-text-muted;
    font-family: Tokens.font-family;
    font-size: Tokens.font-size-sm;
    font-weight: Tokens.font-weight-medium;
}

export component SengiSurface inherits Rectangle {
    in property <bool> raised: false;
    background: root.raised ? Tokens.color-surface-raised : Tokens.color-surface;
    border-radius: Tokens.radius;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
}

// A name shown beside the control the pointer is on, as the dock names its
// icons. The window places it, above everything else.
export component SengiTooltip inherits Rectangle {
    in property <string> text;
    in property <length> limit: Tokens.menu-width;

    width: Math.min(label.preferred-width + Tokens.space-sm * 2, root.limit);
    height: Tokens.font-size-sm + Tokens.space-sm * 2;
    border-radius: Tokens.radius;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
    background: Tokens.color-surface;

    label := Text {
        x: Tokens.space-sm;
        width: parent.width - Tokens.space-sm * 2;
        height: parent.height;
        text: root.text;
        color: Tokens.color-text;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A flat square button that is only an icon, for a toolbar. It has no words,
// so it says its name through `hover`, for the window to show in a
// SengiTooltip. It is no stop for Tab: what it does has a key of its own.
export component SengiToolButton inherits Rectangle {
    in property <string> icon;
    // What it is called, in the tooltip and to a screen reader.
    in property <string> label;
    in property <bool> enabled: true;
    // A switch that is on keeps a fill.
    in property <bool> checked: false;
    in property <bool> danger: false;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    // The pointer came (true) or went; where the middle of the button's top
    // and bottom edges are in the window.
    callback hover(bool, length, length, length);

    width: Tokens.button + Tokens.space-xs;
    height: Tokens.button + Tokens.space-xs;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Tokens.radius;
    background: !root.enabled ? transparent
        : touch.has-hover ? Tokens.color-surface-hover
        : root.checked ? Tokens.color-surface-raised : transparent;
    animate background { duration: Tokens.motion-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    SengiIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        ink: !root.enabled ? Tokens.color-text-disabled
            : root.danger ? Tokens.color-danger
            : root.checked || touch.has-hover ? Tokens.color-text : Tokens.color-text-muted;
    }

    // Over a button that is off too, so that it can still be asked its name.
    touch := TouchArea {
        changed has-hover => {
            root.hover(self.has-hover,
                self.absolute-position.x + self.width / 2,
                self.absolute-position.y,
                self.absolute-position.y + self.height);
        }
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// A button that cannot be used is drawn as an outline with no fill. A
// fill in a surface colour would vanish on whichever surface has that
// colour, leaving bare words that do not look like a button at all.
//
// Three weights: `primary` is the one thing to do next, the plain button
// any other action, and `quiet`, words alone until the pointer is on
// them, the ones that should not compete: dismiss, refresh, step aside.
// High contrast draws a line around every button but the filled one,
// since its fills are too close to the surfaces to be told apart.
export component SengiButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    // The words in the danger colour: it removes or forgets something.
    in property <bool> danger: false;
    // With a line around it, for a button on a surface that may take on
    // the button's own colours, such as a list row under the pointer.
    in property <bool> outlined: false;
    in property <bool> quiet: false;
    // False for a button that only repeats, for the pointer, what a key
    // already does where the keyboard is: it is then no stop for Tab.
    in property <bool> focusable: true;
    in property <bool> enabled: true;
    out property <bool> has-focus: scope.has-focus;
    callback clicked();

    forward-focus: scope;
    min-height: Tokens.button;
    border-radius: Tokens.radius;
    border-width: scope.has-focus ? Tokens.focus-ring-width
        : root.outlined || (ThemeSwitch.high-contrast && !(root.primary && root.enabled))
            || (!root.enabled && !root.quiet) ? Tokens.border-width : 0;
    border-color: scope.has-focus ? Tokens.color-focus-ring
        : !root.enabled ? Tokens.color-outline-disabled : Tokens.color-border;
    background: !root.enabled ? transparent
        : root.primary ? (touch.has-hover ? Tokens.color-accent-hover : Tokens.color-accent)
        : root.quiet ? (touch.has-hover ? Tokens.color-surface-hover : transparent)
        : (touch.has-hover ? Tokens.color-surface-hover : Tokens.color-surface-raised);
    animate background { duration: Tokens.motion-fast; easing: @{motion.easing}; }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        Text {
            text: root.text;
            color: !root.enabled ? Tokens.color-text-disabled
                : root.primary ? Tokens.color-accent-text
                : root.danger ? Tokens.color-danger : Tokens.color-text;
            font-family: Tokens.font-family;
            font-size: Tokens.font-size-md;
            font-weight: Tokens.font-weight-medium;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Return and Space press the button when it has keyboard focus.
    scope := FocusScope {
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Switched off for good, the track is an outline, like a button's.
export component SengiToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: scope.has-focus;
    callback toggled(bool);

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    forward-focus: scope;
    width: Tokens.space-xl * 1.5;
    height: Tokens.space-lg + Tokens.space-xs;
    border-radius: self.height / 2;
    // In high contrast the track that is off is outlined: its fill alone
    // can hardly be seen on black.
    border-width: scope.has-focus ? Tokens.focus-ring-width
        : !root.enabled || (ThemeSwitch.high-contrast && !root.checked)
            ? Tokens.border-width : 0;
    border-color: scope.has-focus ? Tokens.color-focus-ring
        : root.enabled ? Tokens.color-border : Tokens.color-outline-disabled;
    background: !root.enabled ? transparent
        : root.checked ? Tokens.color-accent : Tokens.color-surface-raised;
    animate background { duration: Tokens.motion-fast; easing: @{motion.easing}; }

    knob := Rectangle {
        width: parent.height - Tokens.space-xs;
        height: self.width;
        y: Tokens.space-xxs;
        x: root.checked ? parent.width - self.width - Tokens.space-xxs : Tokens.space-xxs;
        border-radius: self.height / 2;
        background: root.enabled ? Tokens.color-text : Tokens.color-text-disabled;
        animate x { duration: Tokens.motion-base; easing: @{motion.easing}; }
    }

    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.flip(); }
    }
}

// The time, large, with the date under it. The lock screen and the login
// screen are built around this. Both strings come from the program: see
// the sengi-clock crate.
export component SengiClockBlock inherits VerticalLayout {
    // The digits: "13:07", or "1:07" with `period` beside it.
    in property <string> time;
    // "AM" or "PM" on a 12-hour clock, empty on a 24-hour one. Set small
    // on the digits' baseline, so the line is not much wider for it.
    in property <string> period;
    in property <string> date;

    alignment: center;
    spacing: Tokens.space-xs;

    HorizontalLayout {
        alignment: center;
        spacing: Tokens.space-sm;

        Text {
            text: root.time;
            color: Tokens.color-text;
            font-family: Tokens.font-family;
            font-size: Tokens.font-size-display;
            font-weight: Tokens.font-weight-regular;
        }

        if root.period != "": VerticalLayout {
            alignment: end;
            // Both boxes end one descent below their baselines, and the
            // large one's descent is the longer by this much.
            padding-bottom: (Tokens.font-size-display - Tokens.font-size-xl) * Tokens.font-descent;

            Text {
                text: root.period;
                color: Tokens.color-text-muted;
                font-family: Tokens.font-family;
                font-size: Tokens.font-size-xl;
                font-weight: Tokens.font-weight-medium;
            }
        }
    }

    Text {
        text: root.date;
        color: Tokens.color-text-muted;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-xl;
        font-weight: Tokens.font-weight-regular;
        horizontal-alignment: center;
    }
}

// A field for a password. It never holds what is typed. The program
// collects the key presses, where it can wipe them, and tells the field
// only how many characters there are; the field draws that many dots.
// There is nothing to select, copy or reveal.
//
// The same field takes an answer that is no secret, such as a user name
// on the login screen: the program then hands back what was typed as
// `plain`, and it is shown as it is.
//
// Return, Escape and Backspace are reported through the callbacks. Every
// other key is reported through `typed`, unless the program has taken it
// before it got here, as a program on sengi-layer does with
// `Handle::on_text`.
export component SengiPasswordField inherits Rectangle {
    // How many characters have been typed.
    in property <int> length;
    // What was typed, where it may be seen. Drawn in place of the dots.
    in property <string> plain;
    // Shown while nothing has been typed.
    in property <string> placeholder;
    in property <bool> enabled: true;
    // Not taking input because what was typed is being checked. Looks
    // alive, where a field that is merely not enabled looks switched off.
    in property <bool> busy: false;
    // Drawn with the focus ring. On by default while the field has the
    // keyboard; a lock screen that shows the same field on every output
    // sets it everywhere, because the keyboard belongs to all of them.
    in property <bool> active: scope.has-focus;
    // The last attempt was turned down.
    in property <bool> rejected: false;
    // A short word at the right end, such as the keyboard layout.
    in property <string> badge;
    out property <bool> has-focus: scope.has-focus;
    callback typed(string);
    callback erased();
    callback accepted();
    callback cleared();
    // Any key at all was pressed, the ones above included.
    callback touched();

    // How many dots fit beside the badge.
    property <length> room: self.width - Tokens.space-md * 2
        - (root.badge == "" ? 0px : badge-text.preferred-width + Tokens.space-sm);
    property <int> capacity: Math.max(1,
        Math.floor((root.room + Tokens.space-xs) / (Tokens.password-dot + Tokens.space-xs)));

    forward-focus: scope;
    width: Tokens.password-field-width;
    height: Tokens.password-field-height;
    border-radius: Tokens.radius;
    border-width: root.active && root.enabled ? Tokens.focus-ring-width : Tokens.border-width;
    border-color: root.rejected ? Tokens.color-danger
        : root.active && root.enabled ? Tokens.color-focus-ring
        : root.enabled || root.busy ? Tokens.color-border : Tokens.color-outline-disabled;
    background: root.enabled || root.busy ? Tokens.color-surface : transparent;
    animate border-color { duration: Tokens.motion-fast; easing: @{motion.easing}; }

    if root.length == 0: Text {
        x: Tokens.space-md;
        width: root.room;
        height: parent.height;
        text: root.plain != "" ? root.plain : root.placeholder;
        color: root.plain != "" ? (root.enabled ? Tokens.color-text : Tokens.color-text-disabled)
            : root.busy ? Tokens.color-text-muted : Tokens.color-text-disabled;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-md;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: Tokens.space-md;
        width: root.room;
        height: parent.height;
        alignment: start;
        spacing: Tokens.space-xs;

        for index in Math.min(root.length, root.capacity): VerticalLayout {
            alignment: center;
            Rectangle {
                width: Tokens.password-dot;
                height: Tokens.password-dot;
                border-radius: self.height / 2;
                background: root.enabled ? Tokens.color-text : Tokens.color-text-disabled;
            }
        }
    }

    badge-text := Text {
        x: parent.width - self.width - Tokens.space-md;
        height: parent.height;
        text: root.badge;
        color: Tokens.color-text-muted;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-sm;
        font-weight: Tokens.font-weight-medium;
        vertical-alignment: center;
    }

    scope := FocusScope {
        key-pressed(event) => {
            root.touched();
            // Left for the window, which moves the focus with them.
            if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            if !root.enabled {
                return accept;
            }
            if event.text == Key.Return {
                root.accepted();
                return accept;
            }
            if event.text == Key.Escape {
                root.cleared();
                return accept;
            }
            if event.text == Key.Backspace {
                root.erased();
                return accept;
            }
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            // Keys that type nothing arrive too, as Slint's own codes:
            // control and private-use characters, for the program to drop.
            root.typed(event.text);
            return accept;
        }
    }
}

// How far a piece of work has got, for work that can tell: a copy knows
// how many bytes are behind it. Work that cannot tell gets no bar.
export component SengiProgress inherits Rectangle {
    in property <int> percent;

    height: Tokens.space-xs;
    border-radius: self.height / 2;
    background: Tokens.color-surface-raised;

    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.percent, 0, 100) / 100;
        border-radius: parent.border-radius;
        background: Tokens.color-accent;
        animate width { duration: Tokens.motion-base; easing: @{motion.easing}; }
    }
}

export enum SengiStepState { waiting, running, done, failed }

// One step of a job that is done in steps, with a mark that says where
// it stands: an empty ring while it waits, a ring in the accent colour
// while it runs, filled when it is done, and the danger colour if it is
// where the job stopped. A running step that knows how far it is shows
// that beside its words and as a bar under them.
export component SengiStep inherits Rectangle {
    in property <string> text;
    in property <SengiStepState> state;
    // 0 to 100, or less than 0 for a step that cannot tell.
    in property <int> percent: -1;

    private property <bool> measured: root.state == SengiStepState.running && root.percent >= 0;
    // Where the words sit: in the middle, or above the bar.
    private property <length> line: root.measured
        ? (root.height - words.height - Tokens.space-sm - bar.height) / 2
        : (root.height - words.height) / 2;

    min-height: Tokens.button + Tokens.space-md;

    mark := Rectangle {
        x: Tokens.space-md;
        y: (parent.height - self.height) / 2;
        width: Tokens.space-md;
        height: Tokens.space-md;
        border-radius: self.height / 2;
        border-width: root.state == SengiStepState.running ? Tokens.focus-ring-width
            : root.state == SengiStepState.waiting ? Tokens.border-width : 0;
        border-color: root.state == SengiStepState.running ? Tokens.color-accent : Tokens.color-outline-disabled;
        background: root.state == SengiStepState.done ? Tokens.color-success
            : root.state == SengiStepState.failed ? Tokens.color-danger : transparent;
        animate background { duration: Tokens.motion-base; easing: @{motion.easing}; }
    }

    words := Text {
        x: mark.x + mark.width + Tokens.space-md;
        y: root.line;
        width: parent.width - self.x - Tokens.space-md - (root.measured ? Tokens.value-column-md : 0);
        height: self.preferred-height;
        text: root.text;
        color: root.state == SengiStepState.waiting ? Tokens.color-text-muted
            : root.state == SengiStepState.failed ? Tokens.color-danger : Tokens.color-text;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-md;
        font-weight: root.state == SengiStepState.running ? Tokens.font-weight-medium : Tokens.font-weight-regular;
        overflow: elide;
    }

    if root.measured: Text {
        x: parent.width - self.width - Tokens.space-md;
        y: root.line;
        width: Tokens.value-column-md;
        height: self.preferred-height;
        text: root.percent + "%";
        color: Tokens.color-text-muted;
        font-family: Tokens.font-family;
        font-size: Tokens.font-size-md;
        horizontal-alignment: right;
    }

    bar := SengiProgress {
        x: words.x;
        y: parent.height - self.height - Tokens.space-sm;
        width: parent.width - self.x - Tokens.space-md;
        visible: root.measured;
        percent: root.percent;
    }
}
