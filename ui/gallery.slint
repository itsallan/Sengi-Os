// Every shared component on one window, for visual review.

import { Tokens, SengiText, SengiLabel, SengiSurface, SengiButton, SengiToggle, SengiClockBlock, SengiPasswordField } from "components.slint";

export component Gallery inherits Window {
    title: "Sengi OS components";
    background: Tokens.color-bg;
    default-font-family: Tokens.font-family;

    VerticalLayout {
        padding: Tokens.space-xl;
        spacing: Tokens.space-lg;
        alignment: start;

        SengiLabel { text: "Text"; }
        SengiText { text: "Sengi OS"; }

        SengiLabel { text: "Buttons"; }
        HorizontalLayout {
            spacing: Tokens.space-sm;
            alignment: start;
            SengiButton { text: "Primary"; primary: true; }
            SengiButton { text: "Default"; }
            SengiButton { text: "Disabled"; enabled: false; }
        }

        SengiLabel { text: "Toggle"; }
        HorizontalLayout {
            alignment: start;
            SengiToggle { checked: true; }
        }

        SengiLabel { text: "Password field"; }
        HorizontalLayout {
            spacing: Tokens.space-sm;
            alignment: start;
            SengiPasswordField { placeholder: "Password"; }
            SengiPasswordField { length: 9; active: true; badge: "FR"; }
            SengiPasswordField { rejected: true; }
            SengiPasswordField { length: 4; enabled: false; }
            SengiPasswordField { placeholder: "Checking\u{2026}"; enabled: false; busy: true; }
        }

        SengiLabel { text: "Clock"; }
        HorizontalLayout {
            spacing: Tokens.space-xl;
            alignment: start;
            SengiClockBlock { time: "13:07"; date: "Thursday 12 November"; }
            SengiClockBlock { time: "1:07"; period: "PM"; date: "Thursday 12 November"; }
        }

        SengiLabel { text: "Surface"; }
        SengiSurface {
            height: Tokens.space-xl * 3;
            raised: true;
            SengiText { text: "Raised surface"; }
        }
    }
}
