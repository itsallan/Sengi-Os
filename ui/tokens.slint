// Generated from tokens/sengi.toml by scripts/render-tokens.sh.
// Edit ui/tokens.slint.in or the tokens file, never ui/tokens.slint.

// Which palette is in use. A program sets `light` once at start from the
// theme setting, see sengi-config; every colour of Tokens follows it. It is
// a global of its own so that this is all a program exports.
export global ThemeSwitch {
    in property <bool> light: false;
}

export global Tokens {
    out property <color> color-desktop: ThemeSwitch.light ? #dcdfe4 : #121316;
    out property <color> color-bg: ThemeSwitch.light ? #f3f4f6 : #16171b;
    out property <color> color-surface: ThemeSwitch.light ? #ffffff : #1f2126;
    out property <color> color-surface-raised: ThemeSwitch.light ? #e8eaee : #2a2d33;
    out property <color> color-surface-hover: ThemeSwitch.light ? #dcdfe5 : #33363d;
    out property <color> color-border: ThemeSwitch.light ? #c4c8d0 : #3a3d44;
    out property <color> color-text: ThemeSwitch.light ? #1b1d21 : #eceef2;
    out property <color> color-text-muted: ThemeSwitch.light ? #555b66 : #9a9fa8;
    out property <color> color-text-disabled: ThemeSwitch.light ? #9aa0aa : #5f636b;
    out property <color> color-accent: ThemeSwitch.light ? #2f9e6b : #2f9e6b;
    out property <color> color-accent-strong: ThemeSwitch.light ? #1a744a : #3fb27d;
    out property <color> color-accent-hover: ThemeSwitch.light ? #38ad78 : #3fb27d;
    out property <color> color-accent-text: ThemeSwitch.light ? #16171b : #16171b;
    out property <color> color-danger: ThemeSwitch.light ? #c42b24 : #ea5a52;
    out property <color> color-warning: ThemeSwitch.light ? #8f5f00 : #e0a23b;
    out property <color> color-success: ThemeSwitch.light ? #1e7a45 : #4cae6b;
    out property <color> color-bar: ThemeSwitch.light ? #f3f4f6e6 : #16171be6;
    out property <color> color-dock: ThemeSwitch.light ? #ffffffe6 : #1f2126e6;
    out property <color> color-scrim: ThemeSwitch.light ? #00000066 : #00000080;
    out property <color> color-focus-ring: ThemeSwitch.light ? #1a744a : #2f9e6b;
    out property <color> color-outline-disabled: ThemeSwitch.light ? #b4b9c2 : #4a4e56;

    // Both palettes side by side, for the theme preview in Settings.
    out property <color> dark-bg: #16171b;
    out property <color> dark-surface: #1f2126;
    out property <color> dark-text: #eceef2;
    out property <color> dark-text-muted: #9a9fa8;
    out property <color> dark-accent: #2f9e6b;
    out property <color> dark-border: #3a3d44;
    out property <color> light-bg: #f3f4f6;
    out property <color> light-surface: #ffffff;
    out property <color> light-text: #1b1d21;
    out property <color> light-text-muted: #555b66;
    out property <color> light-accent: #2f9e6b;
    out property <color> light-border: #c4c8d0;

    out property <length> radius: 6px;
    out property <length> border-width: 1px;
    out property <length> icon-stroke: 1.5px;
    out property <length> focus-ring-width: 2px;

    out property <length> space-xxs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 48px;

    out property <string> font-family: "Inter";
    out property <string> font-mono: "DejaVu Sans Mono";
    out property <length> font-size-sm: 11px;
    out property <length> font-size-md: 13px;
    out property <length> font-size-lg: 16px;
    out property <length> font-size-xl: 22px;
    out property <length> font-size-display: 96px;
    out property <float> font-descent: 24 / 100;
    out property <int> font-weight-regular: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-bold: 600;

    out property <length> bar-height: 28px;
    out property <length> menu-row: 22px;
    out property <length> menu-padding: 6px;
    out property <length> menu-separator-inset: 6px;
    out property <length> dock-icon: 40px;
    out property <length> dock-padding: 6px;
    out property <length> dock-item: 48px;
    out property <length> dock-gap: 14px;
    out property <length> dock-end-padding: 10px;
    out property <length> dock-margin: 6px;
    out property <length> dock-dot: 4px;
    out property <length> dock-dot-gap: 3px;
    out property <length> dock-bounce: 8px;
    out property <length> desktop-cell-width: 96px;
    out property <length> desktop-cell-height: 104px;
    out property <length> desktop-icon: 48px;
    out property <length> desktop-label-height: 36px;
    out property <length> titlebar-height: 30px;
    out property <length> launcher-width: 640px;
    out property <length> menu-width: 320px;
    out property <length> osd-width: 240px;
    out property <length> osd-height: 56px;
    out property <length> osd-icon: 24px;
    out property <length> osd-bar: 6px;
    out property <int> launcher-lines: 8;
    out property <int> launcher-grid-columns: 6;
    out property <int> launcher-grid-rows: 4;
    out property <length> launcher-cell-width: 104px;
    out property <length> launcher-cell-height: 100px;
    out property <length> launcher-app-icon: 48px;
    out property <length> launcher-row-icon: 24px;
    out property <length> notification-width: 360px;
    out property <length> bar-icon: 16px;
    out property <length> button: 26px;
    out property <length> password-field-width: 280px;
    out property <length> password-field-height: 36px;
    out property <length> password-dot: 8px;
    out property <length> password-note-height: 20px;
    out property <length> list-row-height: 42px;
    out property <length> dialog-width: 360px;
    out property <length> chooser-width: 480px;
    out property <int> chooser-lines: 8;
    out property <length> value-column-sm: 40px;
    out property <length> value-column-md: 60px;
    out property <length> value-column-lg: 80px;
    out property <int> scroll-page-percent: 80;
    out property <length> settings-window-width: 888px;
    out property <length> settings-window-height: 600px;
    out property <length> settings-window-min-width: 720px;
    out property <length> settings-window-min-height: 480px;
    out property <length> settings-sidebar-width: 200px;
    out property <length> settings-page-width: 640px;
    out property <length> settings-control-width: 200px;
    out property <length> settings-control-wide: 240px;
    out property <length> settings-wallpaper-preview: 144px;
    out property <length> settings-wallpaper-label: 28px;

    out property <duration> motion-fast: 120ms;
    out property <duration> motion-base: 200ms;
    out property <duration> motion-slow: 320ms;
    out property <easing> motion-easing: cubic-bezier(0.2, 0, 0, 1);
    out property <duration> motion-bounce: 300ms;
    out property <easing> motion-bounce-easing: ease-out;
    out property <duration> click-guard: 400ms;
    out property <duration> screenshot-delay: 400ms;
    out property <duration> input-settle: 300ms;
    out property <duration> notification-timeout: 5000ms;
    out property <duration> osd-timeout: 1200ms;
    out property <duration> lock-prompt-hide: 30000ms;
    out property <duration> power-confirm: 5000ms;
}
