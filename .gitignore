# Rust build output. Cargo.lock stays tracked because we ship binaries.
target/
**/*.rs.bk

# ISO and image builds. These are large and get published as releases instead.
/build/
/out/
/dist/
/rootfs/
/chroot/
*.iso
*.img
*.qcow2
*.raw
*.squashfs
*.deb
*.sha256

# Package and bootstrap caches pulled in during image builds
/cache/
/.cache/

# QEMU boot test leftovers
/test-output/
*.pid
*.log

# Agent worktrees and machine-local Claude Code settings
.claude/worktrees/
.claude/settings.local.json

# Secrets and signing material. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.gpg

# Editors and desktop clutter
.vscode/
.idea/
.zed/
*.swp
*~
.DS_Store
.directory
.claude
CLAUDE.md