// Glyphs for Settings: the shared Phosphor Bold icons, drawn in token
// colours.

import { Tokens, SengiIcon, SengiSignalIcon, SengiSpeakerIcon, SengiBatteryIcon } from "components.slint";

// An icon by its name, so that a list row or a sidebar entry can carry
// one as plain data. A name nobody knows draws nothing.
export component NamedIcon inherits Rectangle {
    in property <string> name;
    in property <int> level: 4;
    in property <brush> ink: Tokens.color-text;

    width: Tokens.bar-icon;
    height: Tokens.bar-icon;

    if root.name == "signal": SengiSignalIcon {
        level: root.level;
        ink: root.ink;
    }

    if root.name == "speaker" || root.name == "muted": SengiSpeakerIcon {
        muted: root.name == "muted";
        ink: root.ink;
    }

    if root.name == "battery": SengiBatteryIcon {
        percent: root.level <= 4 ? root.level * 25 : root.level;
        ink: root.ink;
    }

    SengiIcon {
        name: root.name == "wired" ? "network"
            : root.name == "display" ? "monitor"
            : root.name == "device" ? "device-mobile" : root.name;
        ink: root.ink;
    }
}
