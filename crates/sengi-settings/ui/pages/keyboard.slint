// The Keyboard page: layouts, the shortcut that switches between them,
// and how keys repeat.

import { Tokens, SengiButton, SengiToggle } from "components.slint";
import { Item, ItemList, Page, PageColumn, Card, Divider, SettingRow, RowValue, SectionLabel, Note, Gap, Metrics, ChoiceButton, Slider } from "../kit.slint";

export global KeyboardData {
    in property <[Item]> layouts;
    in property <bool> can-add: true;
    // More than one layout: the shortcut matters.
    in property <bool> several: false;
    in property <string> switch;
    in-out property <int> delay: 600;
    in-out property <int> rate: 25;

    // The desktop has a sheet of its shortcuts to show: only under
    // sengi-compositor.
    in property <bool> can-show-shortcuts: false;

    // Whether the compositor keeps the history of what was copied.
    in property <bool> clipboard-history: false;

    callback show-shortcuts();
    callback set-clipboard-history(bool);
    callback add();
    callback remove(string);
    callback choose-switch();
    // "repeat-delay" or "repeat-rate", and the value settled on.
    callback repeat(string, int);
}

export component KeyboardPage inherits Page {
    title: "Keyboard";
    content-height: column.preferred-height;

    column := PageColumn {
        HorizontalLayout {
            spacing: Tokens.space-md;

            SectionLabel {
                horizontal-stretch: 1;
                text: "Layouts";
                vertical-alignment: center;
            }

            SengiButton {
                text: "Add layout";
                quiet: true;
                enabled: KeyboardData.can-add;
                clicked => { KeyboardData.add(); }
            }
        }

        Card {
            ItemList {
                items: KeyboardData.layouts;
                removed(id) => { KeyboardData.remove(id); }
            }

            Divider { }

            SettingRow {
                title: "Switch layouts with";
                detail: KeyboardData.several ? "" : "Used once there is a second layout";

                VerticalLayout {
                    alignment: center;
                    ChoiceButton {
                        width: Metrics.control;
                        text: KeyboardData.switch;
                        clicked => { KeyboardData.choose-switch(); }
                    }
                }
            }
        }

        Gap { }

        SectionLabel {
            text: "Holding a key down";
        }

        Card {
            SettingRow {
                title: "Delay before it repeats";

                VerticalLayout {
                    alignment: center;
                    Slider {
                        width: Metrics.control;
                        minimum: 150;
                        maximum: 1000;
                        step: 50;
                        value <=> KeyboardData.delay;
                        released(to) => { KeyboardData.repeat("repeat-delay", to); }
                    }
                }

                RowValue {
                    width: Tokens.value-column-lg;
                    text: KeyboardData.delay + " ms";
                }
            }

            Divider { }

            SettingRow {
                title: "Repeats";

                VerticalLayout {
                    alignment: center;
                    Slider {
                        width: Metrics.control;
                        minimum: 5;
                        maximum: 60;
                        step: 5;
                        value <=> KeyboardData.rate;
                        released(to) => { KeyboardData.repeat("repeat-rate", to); }
                    }
                }

                RowValue {
                    width: Tokens.value-column-lg;
                    text: KeyboardData.rate + " per s";
                }
            }
        }

        if KeyboardData.can-show-shortcuts: Gap { }

        if KeyboardData.can-show-shortcuts: Card {
            SettingRow {
                title: "Keyboard shortcuts";
                detail: "Every key combination of the desktop. Super+/ shows it from anywhere.";

                VerticalLayout {
                    alignment: center;
                    SengiButton {
                        text: "Keyboard shortcuts…";
                        clicked => { KeyboardData.show-shortcuts(); }
                    }
                }
            }
        }

        if KeyboardData.can-show-shortcuts: Gap { }

        if KeyboardData.can-show-shortcuts: SectionLabel {
            text: "Privacy";
        }

        if KeyboardData.can-show-shortcuts: Card {
            SettingRow {
                title: "Clipboard history";
                detail: "Keeps the last 20 texts you copy, in memory only, so Super+V can paste them again. Passwords from password managers are skipped, and it is cleared when the screen locks.";

                VerticalLayout {
                    alignment: center;
                    SengiToggle {
                        checked: KeyboardData.clipboard-history;
                        toggled(on) => { KeyboardData.set-clipboard-history(on); }
                    }
                }
            }
        }
    }
}
