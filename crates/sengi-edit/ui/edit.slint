// The Text Editor window: a toolbar with the file's name in the middle, a
// find bar when it is asked for, the text edge to edge, and a quiet line of
// status. Built from the shared components, the text field of Settings' kit
// and the text area of ui/; nothing here has a colour or a size of its own.

import { Tokens, SengiText, SengiLabel, SengiButton, SengiIcon } from "components.slint";
import { TextField } from "kit.slint";
import { SengiTextArea } from "text-area.slint";
import { Tip, ToolButton, ToolGap, TipLayer } from "chrome.slint";
import { Question, FileEntry, Browse, QuestionLayer, FileLayer } from "dialogs.slint";

export { Question, FileEntry, Browse, Tip }
export { ThemeSwitch } from "components.slint";

// What the window shows and what it reports. Rust fills the one and hears
// the other.
export global Edit {
    // The text itself: the program reads it when it saves.
    in-out property <string> text;
    // The caret and the other end of the selection, in bytes.
    in-out property <int> cursor;
    in-out property <int> anchor;
    // Asks the window to select these bytes; the count goes up for each ask.
    in property <int> select-from;
    in property <int> select-to;
    in property <int> select-tick;
    // Goes up when another file is shown.
    in property <int> reset-tick;
    // The window title, and the name shown over the text.
    in property <string> title: "Text Editor";
    in property <string> name;
    in property <bool> untitled: true;
    in property <bool> dirty: false;
    // Why the file is not shown, said in place of the text. Empty when it is.
    in property <string> refusal;
    // The file is too large to be changed.
    in property <bool> read-only: false;
    // The line at the bottom: where the caret is, what just happened, how
    // much text there is and how its lines end.
    in property <string> position;
    in property <string> notice;
    in property <bool> notice-is-error: false;
    in property <string> size;
    in property <string> line-ending: "LF";
    in property <int> lines: 1;
    in property <int> line: 1;
    in-out property <bool> line-numbers: false;
    in-out property <bool> find-open: false;
    in-out property <string> find-text;
    // "2 of 5", "No match" or nothing.
    in property <string> find-result;
    in property <bool> asking: false;
    in property <Question> question;
    in property <bool> browsing: false;
    in property <Browse> browse;
    in property <[FileEntry]> entries;
    in property <int> entry: -1;
    in-out property <string> file-name;
    in property <int> name-tick;

    callback new-file();
    callback open-file();
    callback save();
    callback save-as();
    callback close();
    callback text-edited();
    callback caret-moved();
    callback tab();
    callback redone(string);
    callback find-opened();
    callback find-changed(string);
    callback find-next();
    callback find-previous();
    callback question-confirmed();
    callback question-other();
    callback question-cancelled();
    callback folder-up();
    callback entry-picked(int);
    callback entry-chosen(int);
    callback entry-stepped(int);
    callback name-typed();
    callback file-accepted();
    callback file-cancelled();
}

component FindBar inherits Rectangle {
    callback closed();

    public function take-focus() {
        field.take-focus();
        field.select-all();
    }

    height: Tokens.list-row-height;
    background: Tokens.color-bg;

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-xs;

        VerticalLayout {
            alignment: center;
            padding-right: Tokens.space-xs;
            SengiIcon {
                name: "magnifying-glass";
                ink: Tokens.color-text-muted;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            field := TextField {
                text <=> Edit.find-text;
                placeholder: "Find in text";
                edited(text) => { Edit.find-changed(text); }
                accepted(text) => { Edit.find-next(); }
                cancelled => { root.closed(); }
                stepped(direction) => {
                    if direction > 0 {
                        Edit.find-next();
                    } else {
                        Edit.find-previous();
                    }
                }
            }
        }

        SengiLabel {
            width: Tokens.value-column-lg + Tokens.space-sm;
            text: Edit.find-result;
            font-weight: Tokens.font-weight-regular;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "caret-up";
                label: "Previous match";
                keys: "Shift+F3";
                enabled: Edit.find-text != "";
                clicked => { Edit.find-previous(); }
            }
        }

        VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "caret-down";
                label: "Next match";
                keys: "F3";
                enabled: Edit.find-text != "";
                clicked => { Edit.find-next(); }
            }
        }

        VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "x";
                label: "Close";
                keys: "Esc";
                clicked => { root.closed(); }
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Tokens.border-width;
        background: Tokens.color-border;
    }
}

export component EditWindow inherits Window {
    title: Edit.title;
    preferred-width: Tokens.settings-window-width;
    preferred-height: Tokens.settings-window-height;
    min-width: Tokens.settings-window-min-width;
    min-height: Tokens.settings-window-min-height;
    background: Tokens.color-bg;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.font-size-md;

    private property <bool> shown: Edit.refusal == "";
    private property <bool> editable: root.shown && !Edit.read-only;
    private property <bool> covered: Edit.asking || Edit.browsing;
    private property <length> bar: Tokens.list-row-height + Tokens.space-xs;

    // The renderer keeps two buffers and only one of them knows after a
    // change of size or scale that it is new, so for a few frames the
    // whole window is drawn, as Settings does.
    private property <float> pixel: 1phx / 1px;
    private property <int> sheet: 0;
    private property <int> sheets-owed: 0;

    function draw-everything() {
        root.sheet += 1;
        root.sheets-owed = 3;
    }

    function open-find() {
        if !root.shown {
            return;
        }
        // The program may put the selected words in the field.
        Edit.find-opened();
        Edit.find-open = true;
        find.take-focus();
    }

    function close-find() {
        Edit.find-open = false;
        area.take-focus();
    }

    // The caret and selection, for the program, which cannot ask the text area.
    function sync() {
        Edit.cursor = area.cursor;
        Edit.anchor = area.anchor;
    }

    private property <int> select-tick: Edit.select-tick;
    changed select-tick => {
        area.select(Edit.select-from, Edit.select-to);
        root.sync();
    }
    private property <int> reset-tick: Edit.reset-tick;
    changed reset-tick => {
        area.reset();
        root.sync();
        root.come-home();
    }
    // A dialog that has gone gives the keyboard back.
    changed covered => {
        Tip.shown = false;
        Tip.text = "";
        root.come-home();
    }
    changed shown => { root.come-home(); }

    // The keyboard belongs in the text, or with the window's own keys where
    // no text is shown.
    function come-home() {
        if root.covered {
            return;
        }
        if root.shown {
            area.take-focus();
        } else {
            scope.focus();
        }
    }

    changed pixel => { root.draw-everything(); }
    changed width => { root.draw-everything(); }
    changed height => { root.draw-everything(); }

    Timer {
        interval: Tokens.motion-fast;
        running: root.sheets-owed > 0;
        triggered => {
            root.sheet += 1;
            root.sheets-owed -= 1;
        }
    }

    Rectangle {
        background: Math.mod(root.sheet, 2) == 0 ? transparent : Tokens.color-bg.transparentize(1);
    }

    scope := FocusScope {
        key-pressed(event) => {
            if root.covered {
                return EventResult.reject;
            }
            if event.modifiers.control {
                if event.text == "s" || event.text == "S" {
                    if event.modifiers.shift {
                        Edit.save-as();
                    } else {
                        Edit.save();
                    }
                } else if event.text == "o" || event.text == "O" {
                    Edit.open-file();
                } else if event.text == "n" || event.text == "N" {
                    Edit.new-file();
                } else if event.text == "f" || event.text == "F" {
                    root.open-find();
                } else if event.text == "l" || event.text == "L" {
                    Edit.line-numbers = !Edit.line-numbers;
                } else if event.text == "w" || event.text == "W" || event.text == "q" || event.text == "Q" {
                    Edit.close();
                } else {
                    return EventResult.reject;
                }
                return EventResult.accept;
            }
            if event.text == Key.F3 {
                if event.modifiers.shift {
                    Edit.find-previous();
                } else {
                    Edit.find-next();
                }
                return EventResult.accept;
            }
            if event.text == Key.Escape && Edit.find-open {
                root.close-find();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            // The toolbar. The name is placed over it, in the middle of the
            // window and not of the room the buttons leave.
            toolbar := Rectangle {
                height: root.bar;
                background: Tokens.color-bg;

                leading := HorizontalLayout {
                    x: Tokens.space-sm;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: Tokens.button + Tokens.space-xs;
                    spacing: Tokens.space-xxs;

                    ToolButton {
                        icon: "file-plus";
                        label: "New";
                        keys: "Ctrl+N";
                        clicked => { Edit.new-file(); }
                    }

                    ToolButton {
                        icon: "folder-open";
                        label: "Open";
                        keys: "Ctrl+O";
                        clicked => { Edit.open-file(); }
                    }

                    ToolButton {
                        icon: "floppy-disk";
                        label: "Save";
                        keys: "Ctrl+S";
                        enabled: root.editable;
                        clicked => {
                            Edit.save();
                            if !root.covered {
                                area.take-focus();
                            }
                        }
                    }

                    ToolGap { }

                    ToolButton {
                        icon: "arrow-counter-clockwise";
                        label: "Undo";
                        keys: "Ctrl+Z";
                        enabled: root.editable;
                        clicked => {
                            area.undo();
                            area.take-focus();
                        }
                    }

                    ToolButton {
                        icon: "arrow-clockwise";
                        label: "Redo";
                        keys: "Ctrl+Y";
                        enabled: root.editable;
                        clicked => {
                            area.redo();
                            area.take-focus();
                        }
                    }
                }

                trailing := HorizontalLayout {
                    x: parent.width - self.width - Tokens.space-sm;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: Tokens.button + Tokens.space-xs;
                    spacing: Tokens.space-xxs;

                    ToolButton {
                        icon: "list-numbers";
                        label: "Line numbers";
                        keys: "Ctrl+L";
                        enabled: root.shown;
                        active: Edit.line-numbers;
                        clicked => {
                            Edit.line-numbers = !Edit.line-numbers;
                            area.take-focus();
                        }
                    }

                    ToolButton {
                        icon: "magnifying-glass";
                        label: "Find";
                        keys: "Ctrl+F";
                        enabled: root.shown;
                        active: Edit.find-open;
                        clicked => {
                            if Edit.find-open {
                                root.close-find();
                            } else {
                                root.open-find();
                            }
                        }
                    }
                }

                // The unsaved dot, then the name.
                Rectangle {
                    // As far from each end as the wider group of buttons.
                    private property <length> side:
                        Math.max(leading.width, trailing.width) + Tokens.space-lg;

                    x: self.side;
                    width: parent.width - self.side * 2;

                    HorizontalLayout {
                        alignment: center;
                        spacing: Tokens.space-sm;

                        if Edit.dirty: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: Tokens.password-dot;
                                height: Tokens.password-dot;
                                border-radius: self.height / 2;
                                background: Tokens.color-accent;
                                accessible-role: text;
                                accessible-label: "Not saved";
                            }
                        }

                        SengiText {
                            max-width: toolbar.width - (Math.max(leading.width, trailing.width) + Tokens.space-lg) * 2
                                - (Edit.dirty ? Tokens.password-dot + Tokens.space-sm : 0px);
                            text: Edit.name;
                            font-weight: Tokens.font-weight-medium;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            Rectangle {
                height: Tokens.border-width;
                background: Tokens.color-border;
            }

            // Kept in the tree when closed, so that it can take the keyboard
            // the moment it opens.
            find := FindBar {
                visible: Edit.find-open;
                height: Edit.find-open ? Tokens.list-row-height : 0px;
                clip: true;
                closed => { root.close-find(); }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Tokens.color-surface;

                area := SengiTextArea {
                    visible: root.shown;
                    read-only: Edit.read-only;
                    text <=> Edit.text;
                    line-numbers: Edit.line-numbers;
                    lines: Edit.lines;
                    current-line: Edit.line;
                    edited => { root.sync(); Edit.text-edited(); }
                    moved => { root.sync(); Edit.caret-moved(); }
                    tab => { Edit.tab(); }
                    redone(before) => { Edit.redone(before); }
                    init => { self.take-focus(); }
                }

                // A page with no name and nothing on it yet. The caret is at
                // the top and typing begins there.
                if root.editable && Edit.untitled && Edit.text == "": VerticalLayout {
                    alignment: center;
                    spacing: Tokens.space-md;

                    HorizontalLayout {
                        alignment: center;
                        SengiIcon {
                            width: Tokens.space-xxl;
                            height: Tokens.space-xxl;
                            name: "file-text";
                            ink: Tokens.color-text-disabled;
                        }
                    }

                    VerticalLayout {
                        spacing: Tokens.space-xs;

                        SengiText {
                            text: "Start typing";
                            font-size: Tokens.font-size-lg;
                            font-weight: Tokens.font-weight-medium;
                            horizontal-alignment: center;
                        }

                        SengiText {
                            text: "or open a file to carry on with it";
                            color: Tokens.color-text-muted;
                            horizontal-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        SengiButton {
                            text: "Open a file";
                            focusable: false;
                            clicked => { Edit.open-file(); }
                        }
                    }
                }

                if !root.shown: VerticalLayout {
                    alignment: center;
                    padding: Tokens.space-xxl;
                    spacing: Tokens.space-md;

                    HorizontalLayout {
                        alignment: center;
                        SengiIcon {
                            width: Tokens.space-xxl;
                            height: Tokens.space-xxl;
                            name: "warning";
                            ink: Tokens.color-warning;
                        }
                    }

                    SengiText {
                        text: "This file is not opened";
                        font-size: Tokens.font-size-lg;
                        font-weight: Tokens.font-weight-bold;
                        horizontal-alignment: center;
                    }

                    SengiText {
                        text: Edit.refusal;
                        color: Tokens.color-text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;
                        SengiButton {
                            text: "Open another file";
                            focusable: false;
                            clicked => { Edit.open-file(); }
                        }
                    }
                }
            }

            Rectangle {
                height: Tokens.border-width;
                background: Tokens.color-border;
            }

            Rectangle {
                height: Tokens.button;
                background: Tokens.color-bg;

                HorizontalLayout {
                    padding-left: Tokens.space-md;
                    padding-right: Tokens.space-md;
                    spacing: Tokens.space-lg;

                    SengiLabel {
                        visible: root.shown;
                        text: Edit.position;
                        font-weight: Tokens.font-weight-regular;
                        vertical-alignment: center;
                    }

                    SengiLabel {
                        horizontal-stretch: 1;
                        text: Edit.notice;
                        color: Edit.notice-is-error ? Tokens.color-danger : Tokens.color-text;
                        font-weight: Tokens.font-weight-regular;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.shown: SengiLabel {
                        text: Edit.size;
                        font-weight: Tokens.font-weight-regular;
                        vertical-alignment: center;
                    }

                    if root.shown: SengiLabel {
                        text: Edit.line-ending;
                        font-weight: Tokens.font-weight-regular;
                        vertical-alignment: center;
                    }

                    if root.shown: SengiLabel {
                        text: "UTF-8";
                        font-weight: Tokens.font-weight-regular;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    TipLayer { }

    if Edit.browsing: FileLayer {
        browse: Edit.browse;
        entries: Edit.entries;
        current: Edit.entry;
        name <=> Edit.file-name;
        select-tick: Edit.name-tick;
        up => { Edit.folder-up(); }
        picked(index) => { Edit.entry-picked(index); }
        chosen(index) => { Edit.entry-chosen(index); }
        stepped(direction) => { Edit.entry-stepped(direction); }
        typed => { Edit.name-typed(); }
        accepted => { Edit.file-accepted(); }
        cancelled => { Edit.file-cancelled(); }
    }

    if Edit.asking: QuestionLayer {
        ask: Edit.question;
        confirmed => { Edit.question-confirmed(); }
        other => { Edit.question-other(); }
        cancelled => { Edit.question-cancelled(); }
    }
}
