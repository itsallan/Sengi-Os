// Glyphs for the quick settings panel: the shared Phosphor Bold icons, drawn
// in token colours. The names are kept so the panel reads as it did.

import { SengiIcon, SengiSignalIcon, SengiSpeakerIcon, SengiBatteryIcon } from "components.slint";

export component SignalIcon inherits SengiSignalIcon { }

export component WiredIcon inherits SengiIcon {
    name: "network";
}

export component BluetoothIcon inherits SengiIcon {
    name: "bluetooth";
}

export component SpeakerIcon inherits SengiSpeakerIcon { }

export component SunIcon inherits SengiIcon {
    name: "sun";
}

export component MoonIcon inherits SengiIcon {
    name: "moon";
}

export component LockIcon inherits SengiIcon {
    name: "lock";
}

export component BatteryIcon inherits SengiBatteryIcon { }
