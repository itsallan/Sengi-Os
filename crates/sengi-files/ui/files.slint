// The Files window: places on the left, a toolbar of icons with the path in
// it on top, the folder under that, one line of status at the bottom. Built from the
// shared components and Settings' kit; nothing here has a colour or a size
// of its own.
//
// Only the rows that can be seen are given to this file: Rust keeps the
// whole folder and sends the slice that is on screen, so a folder of ten
// thousand files costs no more to draw than one of thirty.

import { Tokens, SengiText, SengiLabel, SengiIcon, SengiSurface, SengiToolButton, SengiTooltip } from "components.slint";
export { ThemeSwitch } from "components.slint";
import { Scroll, TextField, DialogLayer, DialogSpec } from "kit.slint";
import { NamedIcon } from "icons.slint";
import { IconPaths } from "icon-paths.slint";

export { DialogSpec }

// A place in the sidebar. The icon is the name of a glyph in
// ui/icons/phosphor/bold; a name with no file there leaves the words alone.
export struct PlaceRow {
    name: string,
    icon: string,
}

// A USB stick, card or external disk in the sidebar. `detail` is its size and
// whether it is open.
export struct DeviceRow {
    name: string,
    detail: string,
    mounted: bool,
}

// One row of the right-click menu.
export struct MenuEntry {
    id: string,
    label: string,
    enabled: bool,
    separator: bool,
    checked: bool,
}

export struct FileRow {
    // Where it is in the whole folder.
    index: int,
    name: string,
    folder: bool,
    selected: bool,
    // Cut, and waiting to be pasted.
    cut: bool,
    // A size, or in the Trash where it was.
    size: string,
    // A time, or in the Trash when it was deleted.
    detail: string,
}

export struct Crumb {
    label: string,
}

// What the window shows and what it reports. Rust fills the one and hears
// the other.
export global Files {
    in property <[FileRow]> rows;
    // The folder index of rows[0], and how many there are in all.
    in property <int> first: 0;
    in property <int> total: 0;
    in property <int> cursor: 0;
    in property <[PlaceRow]> places;
    // Which of the places is open, or -1 for none of them.
    in property <int> place: -1;
    // The drives under the places, and which of them the folder shown is on,
    // or -1.
    in property <[DeviceRow]> devices;
    in property <int> device: -1;
    // A copy or move is running and can be stopped.
    in property <bool> cancelable: false;
    in property <[Crumb]> crumbs;
    in property <bool> in-trash: false;
    in property <bool> can-back: false;
    in property <bool> can-forward: false;
    in property <bool> can-up: false;
    in property <bool> can-paste: false;
    in property <bool> has-selection: false;
    in property <bool> busy: false;
    in-out property <bool> show-hidden: false;
    // The line at the bottom, and a note that replaces it for a while.
    in property <string> status;
    in property <string> notice;
    in property <bool> notice-is-error: false;
    // Said in place of the list when it has nothing to show.
    in property <string> hint;
    // The row being renamed, as a folder index, or -1.
    in property <int> renaming: -1;
    in property <string> rename-text;
    in property <bool> dialog-open: false;
    in property <DialogSpec> dialog;
    // Each count asks the list to do something.
    in property <int> scroll-top: 0;
    in property <int> reveal-tick: 0;
    in property <int> reveal-index: 0;
    // The right-click menu: Rust fills it and opens it, either side closes it.
    in property <[MenuEntry]> menu;
    in-out property <bool> menu-open: false;
    // What a drag in progress carries, as a name or a count.
    in property <string> drag-label;

    // What the list is showing: from `first`, this many.
    callback viewport(int, int);
    callback click(int, bool, bool);
    callback click-empty();
    callback open(int);
    callback open-selected();
    callback step(int, bool);
    callback go-place(int);
    // A drive: show it, opening it first if it is not open; and eject it.
    callback go-device(int);
    callback eject-device(int);
    callback cancel-job();
    callback go-crumb(int);
    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback new-folder();
    callback new-file();
    callback toggle-hidden(bool);
    callback start-rename();
    // The name being typed, so that a click somewhere else can keep it.
    callback rename-edited(string);
    // True when the name was taken; false leaves the field open.
    callback rename-accepted(string) -> bool;
    callback rename-cancelled();
    callback trash-selected();
    callback copy();
    callback cut();
    callback paste();
    callback select-all();
    callback restore();
    callback empty-trash();
    callback dialog-confirmed();
    callback dialog-cancelled();
    // A right-click on a row, or -1 on the empty space.
    callback context(int);
    callback menu-chosen(string);
    // The selection was dropped on a folder row (0), a place (1) or a drive (2).
    callback drop-items(int, int);
}

component MenuItem inherits Rectangle {
    in property <MenuEntry> entry;
    callback chosen();

    height: root.entry.separator ? Tokens.space-sm + Tokens.border-width : Tokens.menu-row;
    border-radius: Tokens.radius;
    background: root.entry.enabled && touch.has-hover ? Tokens.color-accent : transparent;

    if root.entry.separator: Rectangle {
        x: Tokens.menu-separator-inset;
        y: (parent.height - self.height) / 2;
        width: parent.width - Tokens.menu-separator-inset * 2;
        height: Tokens.border-width;
        background: Tokens.color-border;
    }

    if !root.entry.separator: SengiText {
        x: Tokens.space-md;
        width: parent.width - Tokens.space-md * 3 - Tokens.bar-icon;
        text: root.entry.label;
        color: !root.entry.enabled ? Tokens.color-text-disabled
            : touch.has-hover ? Tokens.color-accent-text : Tokens.color-text;
        vertical-alignment: center;
        overflow: elide;
    }

    // A switch that is on has a tick at the end of its row.
    if root.entry.checked: SengiIcon {
        x: parent.width - self.width - Tokens.space-md;
        y: (parent.height - self.height) / 2;
        name: "check";
        ink: touch.has-hover ? Tokens.color-accent-text : Tokens.color-text;
    }

    touch := TouchArea {
        enabled: root.entry.enabled && !root.entry.separator;
        clicked => { root.chosen(); }
    }
}

component Sidebar inherits Rectangle {
    // The place a drag is over, or -1.
    in property <int> drop-place: -1;
    // The drive a drag is over, or -1.
    in property <int> drop-device: -1;
    // Places and drives are rows of one height, this far apart.
    out property <length> row-height: Tokens.button + Tokens.space-sm;
    out property <length> step: root.row-height + Tokens.space-xxs;
    // Where the drives start, under their heading.
    out property <length> devices-top: Tokens.space-sm + Files.places.length * root.step
        + Tokens.space-sm + Tokens.space-xl;
    callback tip(bool, string, length, length, length);

    background: Tokens.color-surface;

    for place[index] in Files.places: Rectangle {
        private property <bool> chosen: index == Files.place;
        private property <bool> target: index == root.drop-place;

        x: Tokens.space-sm;
        y: Tokens.space-sm + index * root.step;
        width: parent.width - Tokens.space-sm * 2;
        height: root.row-height;
        border-radius: Tokens.radius;
        border-width: self.target ? Tokens.focus-ring-width : 0;
        border-color: Tokens.color-accent;
        background: self.target ? Tokens.color-surface-raised
            : self.chosen ? Tokens.color-surface-hover
            : touch.has-hover ? Tokens.color-surface-raised : transparent;
        animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

        if IconPaths.path(place.icon) != "": SengiIcon {
            x: Tokens.space-md;
            y: (parent.height - self.height) / 2;
            name: place.icon;
            ink: parent.chosen ? Tokens.color-text : Tokens.color-text-muted;
        }

        SengiText {
            x: IconPaths.path(place.icon) != "" ? Tokens.space-md * 2 + Tokens.bar-icon : Tokens.space-md;
            width: parent.width - self.x - Tokens.space-sm;
            height: parent.height;
            text: place.name;
            font-weight: parent.chosen ? Tokens.font-weight-medium : Tokens.font-weight-regular;
            vertical-alignment: center;
            overflow: elide;
        }

        touch := TouchArea {
            clicked => { Files.go-place(index); }
        }
    }

    if Files.devices.length > 0: SengiLabel {
        x: Tokens.space-md;
        y: root.devices-top - Tokens.space-xl;
        width: parent.width - Tokens.space-md * 2;
        height: Tokens.space-xl;
        text: "Devices";
        vertical-alignment: center;
    }

    for device[index] in Files.devices: dev-row := Rectangle {
        private property <bool> chosen: index == Files.device;
        private property <bool> target: index == root.drop-device;

        x: Tokens.space-sm;
        y: root.devices-top + index * root.step;
        width: parent.width - Tokens.space-sm * 2;
        height: root.row-height;
        border-radius: Tokens.radius;
        border-width: self.target ? Tokens.focus-ring-width : 0;
        border-color: Tokens.color-accent;
        background: self.target ? Tokens.color-surface-raised
            : self.chosen ? Tokens.color-surface-hover
            : row-touch.has-hover ? Tokens.color-surface-raised : transparent;
        animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

        SengiIcon {
            x: Tokens.space-md;
            y: (parent.height - self.height) / 2;
            name: "hard-drives";
            ink: parent.chosen ? Tokens.color-text : Tokens.color-text-muted;
        }

        row-touch := TouchArea {
            clicked => { Files.go-device(index); }
        }

        VerticalLayout {
            x: Tokens.space-md * 2 + Tokens.bar-icon;
            width: parent.width - self.x - (device.mounted ? eject.width + Tokens.space-xs : Tokens.space-sm);
            height: parent.height;
            alignment: center;

            SengiText {
                text: device.name;
                font-weight: dev-row.chosen ? Tokens.font-weight-medium : Tokens.font-weight-regular;
                overflow: elide;
            }

            SengiText {
                text: device.detail;
                font-size: Tokens.font-size-sm;
                color: Tokens.color-text-muted;
                overflow: elide;
            }
        }

        // Eject: unmount, then power the drive off. Over the row's own
        // touch area, so a click here is not a click on the row.
        eject := SengiToolButton {
            visible: device.mounted;
            x: parent.width - self.width - Tokens.space-xxs;
            y: (parent.height - self.height) / 2;
            icon: "eject";
            name: "Eject " + device.name;
            enabled: device.mounted;
            clicked => { Files.eject-device(index); }
            hover(on, x, top, bottom) => { root.tip(on, self.name, x, top, bottom); }
        }
    }

    // The edge against the folder.
    Rectangle {
        x: parent.width - self.width;
        width: Tokens.border-width;
        background: Tokens.color-border;
    }
}

component PathBar inherits Rectangle {
    clip: true;

    HorizontalLayout {
        alignment: start;
        spacing: Tokens.space-xs;

        for crumb[index] in Files.crumbs: HorizontalLayout {
            spacing: Tokens.space-xs;

            if index > 0: VerticalLayout {
                alignment: center;
                SengiIcon {
                    name: "caret-right";
                    ink: Tokens.color-text-disabled;
                    width: Tokens.space-md;
                    height: Tokens.space-md;
                }
            }

            Rectangle {
                private property <bool> last: index == Files.crumbs.length - 1;

                min-width: label.preferred-width + Tokens.space-md;
                height: Tokens.button;
                border-radius: Tokens.radius;
                background: touch.has-hover ? Tokens.color-surface-raised : transparent;
                animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

                label := SengiText {
                    x: Tokens.space-sm;
                    height: parent.height;
                    text: crumb.label;
                    color: parent.last ? Tokens.color-text : Tokens.color-text-muted;
                    font-weight: parent.last ? Tokens.font-weight-medium : Tokens.font-weight-regular;
                    vertical-alignment: center;
                }

                touch := TouchArea {
                    clicked => { Files.go-crumb(index); }
                }
            }
        }
    }
}

export component FilesWindow inherits Window {
    title: "Files";
    preferred-width: Tokens.settings-window-width;
    preferred-height: Tokens.settings-window-height;
    min-width: Tokens.settings-window-min-width;
    min-height: Tokens.settings-window-min-height;
    background: Tokens.color-bg;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.font-size-md;

    private property <length> line: Tokens.button + Tokens.space-md;
    // Where the folder's rows are, for the tests to point at.
    out property <length> row-height: root.line;
    out property <length> list-top: list.absolute-position.y;
    // The name of the button under the pointer, and where the button is.
    private property <string> tip-text;
    private property <length> tip-x;
    private property <length> tip-top;
    private property <length> tip-bottom;
    private property <bool> tip-wanted: false;
    out property <bool> tip-shown: false;
    // The size and time columns need room; a narrow window keeps the name.
    private property <bool> roomy: list.width > Tokens.chooser-width;
    private property <bool> roomier: list.width > Tokens.chooser-width + Tokens.settings-control-width;
    private property <length> size-width: Files.in-trash ? Tokens.settings-control-width : Tokens.value-column-lg;
    private property <length> time-width: Files.in-trash ? Tokens.settings-control-width : Tokens.value-column-lg + Tokens.space-xxl;
    private property <int> hovered: -1;
    // The right-click menu opens where the pointer was.
    private property <length> menu-x: 0;
    private property <length> menu-y: 0;
    // Dragging items: the row that was pressed and where, whether it has
    // become a drag, where the pointer is, and what it is over.
    private property <int> press-row: -1;
    private property <bool> press-selected: false;
    private property <length> press-x: 0;
    private property <length> press-y: 0;
    private property <bool> dragging: false;
    private property <length> drag-x: 0;
    private property <length> drag-y: 0;
    private property <int> drop-row: -1;
    private property <int> drop-place: -1;
    private property <int> drop-device: -1;
    // The program asks the list to move by raising a count.
    private property <int> top-tick: Files.scroll-top;
    private property <int> reveal-tick: Files.reveal-tick;

    // The renderer keeps two buffers and only one of them knows after a
    // change of size or scale that it is new, so for a few frames the
    // whole window is drawn, as Settings does.
    private property <float> pixel: 1phx / 1px;
    private property <int> sheet: 0;
    private property <int> sheets-owed: 0;

    function draw-everything() {
        root.sheet += 1;
        root.sheets-owed = 3;
    }

    function report-view() {
        Files.viewport(
            Math.max(Math.floor(list.offset / root.line), 0),
            Math.ceil(list.height / root.line) + 2);
    }

    // The keyboard goes back to the list, from a button or a field.
    public function take-focus() {
        scope.focus();
    }

    function open-menu(index: int, x: length, y: length) {
        root.hide-tip();
        root.menu-x = x;
        root.menu-y = y;
        Files.context(index);
    }

    // A right-click at (x, y) in the window while a menu is open: the menu
    // for whatever is there takes its place.
    function menu-at(x: length, y: length) {
        if x < Tokens.settings-sidebar-width {
            return;
        }
        let at = Math.floor((y - list.absolute-position.y + list.offset) / root.line);
        let on-row = y >= list.absolute-position.y && y < list.absolute-position.y + list.height
            && at >= 0 && at < Files.total
            && x >= list.absolute-position.x + Tokens.space-sm
            && x < list.absolute-position.x + list.width - Tokens.space-sm - Tokens.space-xs;
        root.open-menu(on-row ? at : -1, x, y);
    }

    function point-at(on: bool, text: string, x: length, top: length, bottom: length) {
        if on {
            root.tip-text = text;
            root.tip-x = x;
            root.tip-top = top;
            root.tip-bottom = bottom;
            root.tip-wanted = true;
        } else if root.tip-x == x && root.tip-top == top {
            root.hide-tip();
        }
    }

    function hide-tip() {
        root.tip-wanted = false;
        root.tip-shown = false;
    }

    function end-drag() {
        root.press-row = -1;
        root.dragging = false;
        root.drop-row = -1;
        root.drop-place = -1;
        root.drop-device = -1;
    }

    // The pointer is at (x, y) in the window with the button down on a row.
    function drag-to(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
        if !root.dragging {
            if Math.abs(x - root.press-x) < Tokens.space-md && Math.abs(y - root.press-y) < Tokens.space-md {
                return;
            }
            root.dragging = true;
            // Dragging a row that is not selected takes it alone.
            if !root.press-selected {
                Files.click(root.press-row, false, false);
            }
        }
        root.drop-row = -1;
        root.drop-place = -1;
        root.drop-device = -1;
        if x < Tokens.settings-sidebar-width {
            let at = Math.floor((y - Tokens.space-sm) / sidebar.step);
            if at >= 0 && at < Files.places.length
                && y - Tokens.space-sm - at * sidebar.step < sidebar.row-height {
                root.drop-place = at;
            }
            let dev = Math.floor((y - sidebar.devices-top) / sidebar.step);
            if dev >= 0 && dev < Files.devices.length
                && y - sidebar.devices-top - dev * sidebar.step < sidebar.row-height {
                root.drop-device = dev;
            }
        } else if y > list.absolute-position.y && y < list.absolute-position.y + list.height {
            let at = Math.floor((y - list.absolute-position.y + list.offset) / root.line);
            let slot = at - Files.first;
            if slot >= 0 && slot < Files.rows.length && Files.rows[slot].folder && !Files.rows[slot].selected {
                root.drop-row = at;
            }
        }
    }

    function finish-drag() {
        if root.dragging && root.drop-row >= 0 {
            Files.drop-items(0, root.drop-row);
        } else if root.dragging && root.drop-place >= 0 {
            Files.drop-items(1, root.drop-place);
        } else if root.dragging && root.drop-device >= 0 {
            Files.drop-items(2, root.drop-device);
        }
        root.end-drag();
    }

    changed top-tick => { list.reveal(0px, root.line); }
    changed reveal-tick => { list.reveal(Files.reveal-index * root.line, root.line); }
    changed pixel => { root.draw-everything(); }
    changed width => { root.draw-everything(); }
    changed height => { root.draw-everything(); }
    init => { scope.focus(); }

    Timer {
        interval: Tokens.motion-fast;
        running: root.sheets-owed > 0;
        triggered => {
            root.sheet += 1;
            root.sheets-owed -= 1;
        }
    }

    Rectangle {
        background: Math.mod(root.sheet, 2) == 0 ? transparent : Tokens.color-bg.transparentize(1);
    }

    scope := FocusScope {
        key-pressed(event) => {
            if Files.dialog-open {
                return EventResult.reject;
            }
            if Files.menu-open {
                if event.text == Key.Escape {
                    Files.menu-open = false;
                }
                return EventResult.accept;
            }
            if event.modifiers.alt {
                if event.text == Key.LeftArrow {
                    Files.back();
                    return EventResult.accept;
                }
                if event.text == Key.RightArrow {
                    Files.forward();
                    return EventResult.accept;
                }
                if event.text == Key.UpArrow {
                    Files.up();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            if event.modifiers.control {
                if event.text == "a" {
                    Files.select-all();
                } else if event.text == "c" {
                    Files.copy();
                } else if event.text == "x" {
                    Files.cut();
                } else if event.text == "v" {
                    Files.paste();
                } else if event.text == "h" {
                    Files.toggle-hidden(!Files.show-hidden);
                } else if event.text == "r" {
                    Files.refresh();
                } else if (event.text == "n" || event.text == "N") && event.modifiers.shift {
                    Files.new-folder();
                } else if (event.text == "f" || event.text == "F") && event.modifiers.shift {
                    Files.new-file();
                } else {
                    return EventResult.reject;
                }
                return EventResult.accept;
            }
            if event.text == Key.UpArrow {
                Files.step(-1, event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.DownArrow {
                Files.step(1, event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.Home {
                Files.step(-1000000, event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.End {
                Files.step(1000000, event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.PageUp {
                Files.step(-Math.max(Math.floor(list.height / root.line) - 1, 1), event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.PageDown {
                Files.step(Math.max(Math.floor(list.height / root.line) - 1, 1), event.modifiers.shift);
                list.reveal(Files.cursor * root.line, root.line);
            } else if event.text == Key.Return {
                Files.open-selected();
            } else if event.text == Key.Delete {
                Files.trash-selected();
            } else if event.text == Key.F2 {
                Files.start-rename();
            } else if event.text == Key.F5 {
                Files.refresh();
            } else if event.text == Key.Backspace {
                Files.up();
            } else if event.text == Key.Escape {
                Files.click-empty();
            } else {
                return EventResult.reject;
            }
            return EventResult.accept;
        }

        sidebar := Sidebar {
            drop-place: root.drop-place;
            drop-device: root.drop-device;
            x: 0;
            y: 0;
            width: Tokens.settings-sidebar-width;
            height: parent.height;
            tip(on, text, x, top, bottom) => { root.point-at(on, text, x, top, bottom); }
        }

        Rectangle {
            x: Tokens.settings-sidebar-width;
            width: parent.width - Tokens.settings-sidebar-width;
            height: parent.height;

            // Under the toolbar, the headings and the status line: a right
            // click on any bare part of the folder's side has its menu.
            TouchArea {
                pointer-event(event) => {
                    if event.kind != PointerEventKind.down {
                        return;
                    }
                    scope.focus();
                    if event.button == PointerEventButton.right {
                        root.open-menu(-1, self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    } else if event.button == PointerEventButton.left && Files.renaming >= 0 {
                        Files.click-empty();
                    }
                }
            }

            VerticalLayout {
                // The toolbar.
                HorizontalLayout {
                    padding: Tokens.space-sm;
                    spacing: Tokens.space-xxs;

                    SengiToolButton {
                        icon: "arrow-left";
                        name: "Back";
                        enabled: Files.can-back;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.back();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    SengiToolButton {
                        icon: "arrow-right";
                        name: "Forward";
                        enabled: Files.can-forward;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.forward();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    SengiToolButton {
                        icon: "arrow-up";
                        name: "Up";
                        enabled: Files.can-up;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.up();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    // The path, set a little apart from the buttons.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        padding-left: Tokens.space-sm;
                        padding-right: Tokens.space-sm;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            PathBar {
                                height: Tokens.button;
                            }
                        }
                    }

                    if !Files.in-trash: SengiToolButton {
                        icon: "folder-plus";
                        name: "New Folder";
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.new-folder();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    if !Files.in-trash: SengiToolButton {
                        icon: "file-plus";
                        name: "New File";
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.new-file();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    if Files.in-trash: SengiToolButton {
                        icon: "arrow-counter-clockwise";
                        name: "Restore";
                        enabled: Files.has-selection && !Files.busy;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.restore();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    if Files.in-trash: SengiToolButton {
                        icon: "trash";
                        name: "Empty Trash";
                        enabled: Files.total > 0 && !Files.busy;
                        danger: true;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.empty-trash();
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }

                    SengiToolButton {
                        icon: Files.show-hidden ? "eye" : "eye-slash";
                        name: Files.show-hidden ? "Hide Hidden Files" : "Show Hidden Files";
                        checked: Files.show-hidden;
                        clicked => {
                            root.hide-tip();
                            scope.focus();
                            Files.toggle-hidden(!Files.show-hidden);
                        }
                        hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                    }
                }

                Rectangle {
                    height: Tokens.border-width;
                    background: Tokens.color-border;
                }

                // What the columns are, over the columns.
                HorizontalLayout {
                    height: Tokens.button;
                    padding-left: Tokens.space-sm + Tokens.space-md;
                    padding-right: Tokens.space-sm + Tokens.space-xs + Tokens.space-md;
                    spacing: Tokens.space-md;

                    SengiLabel {
                        horizontal-stretch: 1;
                        min-width: 0;
                        text: "Name";
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.roomy: SengiLabel {
                        width: root.size-width;
                        text: Files.in-trash ? "Original Location" : "Size";
                        horizontal-alignment: Files.in-trash ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.roomier: SengiLabel {
                        width: root.time-width;
                        text: Files.in-trash ? "Deleted" : "Modified";
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: Tokens.border-width;
                    background: Tokens.color-border;
                }

                Rectangle {
                    vertical-stretch: 1;

                    list := Scroll {
                        // A row's height stays free after the last one, so
                        // that a full folder still has bare space to
                        // right-click.
                        content-height: Files.total == 0 ? 0px : (Files.total + 1) * root.line;
                        changed offset => { root.report-view(); }
                        changed height => { root.report-view(); }
                        init => { root.report-view(); }

                        // Under the rows: a click where there is no row.
                        TouchArea {
                            width: parent.width;
                            height: Math.max(parent.height, (Files.total + 1) * root.line);
                            pointer-event(event) => {
                                if event.kind != PointerEventKind.down {
                                    return;
                                }
                                scope.focus();
                                if event.button == PointerEventButton.right {
                                    root.open-menu(-1, self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                } else if event.button == PointerEventButton.left {
                                    Files.click-empty();
                                }
                            }
                        }

                        for row[slot] in Files.rows: Rectangle {
                            private property <bool> lit: root.hovered == row.index;

                            x: Tokens.space-sm;
                            y: row.index * root.line;
                            width: parent.width - Tokens.space-sm * 2 - Tokens.space-xs;
                            height: root.line;
                            border-radius: Tokens.radius;
                            border-width: root.drop-row == row.index ? Tokens.focus-ring-width : 0;
                            border-color: Tokens.color-accent;
                            background: row.selected ? Tokens.color-surface-hover
                                : self.lit || root.drop-row == row.index ? Tokens.color-surface-raised : transparent;
                            animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

                            TouchArea {
                                changed has-hover => {
                                    if self.has-hover {
                                        root.hovered = row.index;
                                    } else if root.hovered == row.index {
                                        root.hovered = -1;
                                    }
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.right {
                                        scope.focus();
                                        root.open-menu(row.index, self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    } else if event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left {
                                        root.press-row = row.index;
                                        root.press-selected = row.selected;
                                        root.press-x = self.absolute-position.x + self.mouse-x;
                                        root.press-y = self.absolute-position.y + self.mouse-y;
                                    } else if event.kind == PointerEventKind.up
                                        && event.button == PointerEventButton.left {
                                        if root.dragging {
                                            root.finish-drag();
                                        } else {
                                            root.end-drag();
                                            Files.click(row.index, event.modifiers.control, event.modifiers.shift);
                                        }
                                        scope.focus();
                                    } else if event.kind == PointerEventKind.cancel {
                                        root.end-drag();
                                    }
                                }
                                moved => {
                                    if self.pressed && root.press-row == row.index && !Files.in-trash {
                                        root.drag-to(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                double-clicked => { Files.open(row.index); }
                            }

                            HorizontalLayout {
                                padding-left: Tokens.space-md;
                                padding-right: Tokens.space-md;
                                spacing: Tokens.space-md;

                                VerticalLayout {
                                    alignment: center;
                                    NamedIcon {
                                        name: row.folder ? "folder" : "file";
                                        ink: row.cut ? Tokens.color-text-disabled
                                            : row.folder ? Tokens.color-accent : Tokens.color-text-muted;
                                    }
                                }

                                if Files.renaming != row.index: SengiText {
                                    horizontal-stretch: 1;
                                    text: row.name;
                                    color: row.cut ? Tokens.color-text-disabled : Tokens.color-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if Files.renaming == row.index: VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    TextField {
                                        init => {
                                            self.text = Files.rename-text;
                                            self.take-focus();
                                            self.select-all();
                                        }
                                        edited(text) => { Files.rename-edited(text); }
                                        accepted(text) => {
                                            if Files.rename-accepted(text) {
                                                scope.focus();
                                            }
                                        }
                                        cancelled => {
                                            Files.rename-cancelled();
                                            scope.focus();
                                        }
                                    }
                                }

                                if root.roomy && Files.renaming != row.index: SengiText {
                                    width: root.size-width;
                                    text: row.size;
                                    color: Tokens.color-text-muted;
                                    horizontal-alignment: Files.in-trash ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if root.roomier && Files.renaming != row.index: SengiText {
                                    width: root.time-width;
                                    text: row.detail;
                                    color: Tokens.color-text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    if Files.total == 0: SengiText {
                        width: parent.width;
                        height: parent.height;
                        text: Files.hint;
                        color: Tokens.color-text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: Tokens.border-width;
                    background: Tokens.color-border;
                }

                // The line at the bottom: what is here, or what just happened.
                HorizontalLayout {
                    height: Tokens.button + Tokens.space-xs;
                    padding-left: Tokens.space-sm + Tokens.space-md;
                    padding-right: Tokens.space-sm;
                    spacing: Tokens.space-sm;

                    SengiLabel {
                        horizontal-stretch: 1;
                        min-width: 0;
                        text: Files.notice != "" ? Files.notice : Files.status;
                        color: Files.notice == "" ? Tokens.color-text-muted
                            : Files.notice-is-error ? Tokens.color-danger : Tokens.color-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if Files.cancelable: VerticalLayout {
                        alignment: center;
                        SengiToolButton {
                            height: Tokens.button;
                            icon: "x";
                            name: "Cancel";
                            clicked => {
                                root.hide-tip();
                                Files.cancel-job();
                            }
                            hover(on, x, top, bottom) => { root.point-at(on, self.name, x, top, bottom); }
                        }
                    }
                }
            }
        }
    }

    // The tooltip comes after the pointer has rested a moment.
    Timer {
        interval: Tokens.motion-slow;
        running: root.tip-wanted && !root.tip-shown;
        triggered => { root.tip-shown = true; }
    }

    // Under the button, or over it where there is no room under.
    if root.tip-shown: SengiTooltip {
        text: root.tip-text;
        x: Math.clamp(root.tip-x - self.width / 2, Tokens.space-xs,
            root.width - self.width - Tokens.space-xs);
        y: root.tip-bottom + Tokens.space-xs + self.height < root.height
            ? root.tip-bottom + Tokens.space-xs
            : root.tip-top - self.height - Tokens.space-xs;
    }

    // What is being dragged, beside the pointer.
    if root.dragging: SengiSurface {
        raised: true;
        x: Math.min(root.drag-x + Tokens.space-md, root.width - self.width - Tokens.space-xs);
        y: Math.min(root.drag-y + Tokens.space-md, root.height - self.height - Tokens.space-xs);
        width: Math.min(ghost.preferred-width + Tokens.space-lg * 2, Tokens.menu-width);
        height: Tokens.button;

        ghost := SengiText {
            x: Tokens.space-lg;
            width: parent.width - Tokens.space-lg * 2;
            text: Files.drag-label;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if Files.menu-open: TouchArea {
        // A click outside the menu only closes it; a right-click there
        // opens the menu for the new spot.
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                let x = self.mouse-x;
                let y = self.mouse-y;
                Files.menu-open = false;
                scope.focus();
                if event.button == PointerEventButton.right {
                    root.menu-at(x, y);
                }
            }
        }
    }

    if Files.menu-open: SengiSurface {
        raised: true;
        width: Math.clamp(menu-list.preferred-width, Tokens.menu-width / 2, Tokens.menu-width);
        height: menu-list.preferred-height;
        x: Math.max(Tokens.space-xs, Math.min(root.menu-x, root.width - self.width - Tokens.space-xs));
        y: Math.max(Tokens.space-xs, Math.min(root.menu-y, root.height - self.height - Tokens.space-xs));

        // Clicks between the rows are not clicks on the list underneath.
        TouchArea { }

        menu-list := VerticalLayout {
            padding: Tokens.menu-padding;

            for entry in Files.menu: MenuItem {
                entry: entry;
                chosen => {
                    Files.menu-open = false;
                    Files.menu-chosen(entry.id);
                    scope.focus();
                }
            }
        }
    }

    if Files.dialog-open: DialogLayer {
        spec: Files.dialog;
        confirmed(text) => {
            Files.dialog-confirmed();
            scope.focus();
        }
        cancelled => {
            Files.dialog-cancelled();
            scope.focus();
        }
    }
}
