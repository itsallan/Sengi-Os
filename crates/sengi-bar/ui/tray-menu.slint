// The context menu of a tray item. The bar is too short to hold one, so it
// is drawn by a helper on a surface of its own that covers the output: the
// menu hangs under the icon and a click anywhere else closes it.
//
// Rows are sized and lit like the rows of the session menu that
// sengi-launcher draws, and the keys do the same: the arrows move the
// highlight, Return chooses, Escape closes.

import { Tokens, SengiText, SengiSurface } from "components.slint";

export struct MenuRow {
    id: int,
    label: string,
    enabled: bool,
    separator: bool,
    submenu: bool,
    check: bool,
    radio: bool,
    // Whether a check or radio row is switched on.
    on: bool,
    // Neither on nor off: it stands for several things that disagree.
    mixed: bool,
}

export struct MenuPanel {
    rows: [MenuRow],
    // Some row has a check or radio mark, so all rows leave room for one.
    marks: bool,
    // The row whose submenu is open, the highlighted row, and a row the
    // program wants to know the place of. Each is an id, or -1.
    open-id: int,
    selected-id: int,
    request-id: int,
    // For the menu itself, left is where the icon is. For a submenu these
    // are the edges of the panel it hangs off and the top of its row.
    left: length,
    right: length,
    top: length,
}

// Marks are drawn as stroked paths on the same 16 unit grid as bar icons.
component Mark inherits Path {
    in property <color> ink;
    width: Tokens.bar-icon;
    height: Tokens.bar-icon;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: root.ink;
    stroke-width: Tokens.icon-stroke;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component Row inherits Rectangle {
    in property <MenuRow> entry;
    in property <bool> marks;
    // Highlighted: under the pointer, reached with the keys, or the row
    // an open submenu hangs off.
    in property <bool> selected;
    // The program is asking where this row is.
    in property <bool> requested;
    callback chosen();
    // The pointer came over the row, or the program asked for its place.
    callback entered();

    private property <color> ink: root.entry.enabled ? Tokens.color-text : Tokens.color-text-disabled;

    // The launcher's row: a line of large text with small space above and
    // below it.
    height: root.entry.separator ? Tokens.space-sm + Tokens.border-width
        : Tokens.font-size-lg + Tokens.space-sm * 2;
    min-width: line.min-width;
    preferred-width: line.preferred-width;
    border-radius: Tokens.radius;
    background: root.selected && !root.entry.separator ? Tokens.color-surface-hover : transparent;

    changed requested => {
        if root.requested {
            root.entered();
        }
    }

    if root.entry.separator: Rectangle {
        x: Tokens.space-md;
        y: (parent.height - self.height) / 2;
        width: parent.width - Tokens.space-md * 2;
        height: Tokens.border-width;
        background: Tokens.color-border;
    }

    line := HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        spacing: Tokens.space-sm;

        if root.marks: Rectangle {
            width: Tokens.bar-icon;

            if root.entry.check && root.entry.on: Mark {
                ink: root.ink;
                commands: "M3.5 8.5l3 3 6-7";
            }
            if root.entry.check && root.entry.mixed: Mark {
                ink: root.ink;
                commands: "M4 8h8";
            }
            if root.entry.radio && root.entry.on: Rectangle {
                width: Tokens.space-sm;
                height: self.width;
                border-radius: self.width / 2;
                background: root.ink;
            }
            if root.entry.radio && root.entry.mixed: Rectangle {
                width: Tokens.space-sm;
                height: self.width;
                border-radius: self.width / 2;
                border-width: Tokens.icon-stroke;
                border-color: root.ink;
            }
        }

        SengiText {
            horizontal-stretch: 1;
            text: root.entry.label;
            color: root.ink;
            font-size: Tokens.font-size-lg;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.entry.submenu: Rectangle {
            width: Tokens.bar-icon;

            Mark {
                ink: root.ink;
                commands: "M6 3.5l4.5 4.5-4.5 4.5";
            }
        }
    }

    touch := TouchArea {
        enabled: !root.entry.separator;
        clicked => {
            if root.entry.enabled {
                root.chosen();
            }
        }
        changed has-hover => {
            if self.has-hover {
                root.entered();
            }
        }
    }
}

export component TrayMenu inherits Window {
    // The menu, then each open submenu.
    in property <[MenuPanel]> panels;

    // A row was chosen, by id.
    callback chosen(int);
    // The pointer is over a row, or the program asked where it is: the
    // panel's index, the row's id, the left and right edges of the panel
    // and the top of the row.
    callback entered(int, int, length, length, length);
    // "up", "down", "left", "right" or "return" was pressed.
    callback key(string);
    callback dismiss();

    private property <length> gap: Tokens.space-xs;

    title: "Sengi OS tray menu";
    no-frame: true;
    background: transparent;
    default-font-family: Tokens.font-family;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
            } else if event.text == Key.Return {
                root.key("return");
            } else if event.text == Key.UpArrow || event.text == Key.Backtab
                || (event.text == Key.Tab && event.modifiers.shift) {
                root.key("up");
            } else if event.text == Key.DownArrow || event.text == Key.Tab {
                root.key("down");
            } else if event.text == Key.RightArrow {
                root.key("right");
            } else if event.text == Key.LeftArrow {
                root.key("left");
            } else {
                return reject;
            }
            accept
        }
    }

    // A press outside the menu closes it, whichever button it is.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dismiss();
            }
        }
    }

    for panel[index] in root.panels: box := SengiSurface {
        property <bool> fits-right: panel.right + self.width + root.gap <= root.width;
        property <length> room: root.height - root.gap * 2
            - (index == 0 ? Tokens.bar-height : 0);

        width: Math.clamp(list.preferred-width, Tokens.menu-width / 2, Tokens.menu-width);
        height: Math.min(list.preferred-height, self.room);
        x: index == 0 ? Math.clamp(panel.left, root.gap, Math.max(root.gap, root.width - self.width - root.gap))
            : self.fits-right ? panel.right : Math.max(root.gap, panel.left - self.width);
        y: index == 0 ? Tokens.bar-height + Tokens.space-xxs
            : Math.clamp(panel.top - Tokens.space-sm, root.gap, Math.max(root.gap, root.height - self.height - root.gap));

        // Clicks between rows are not clicks outside the menu.
        TouchArea { }

        Flickable {
            content-width: self.width;
            content-height: list.preferred-height;

            list := VerticalLayout {
                padding: Tokens.space-sm;

                for row in panel.rows: item := Row {
                    entry: row;
                    marks: panel.marks;
                    selected: row.id == panel.selected-id || row.id == panel.open-id;
                    requested: row.id == panel.request-id;
                    chosen => { root.chosen(row.id); }
                    entered => {
                        root.entered(index, row.id, box.x, box.x + box.width, item.absolute-position.y);
                    }
                }
            }
        }
    }
}
