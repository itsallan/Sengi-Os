// The Sengi OS top bar: menu on the left, status and session on the right.

import { Tokens, SengiText } from "components.slint";
import { TrayMenu, MenuPanel, MenuRow } from "tray-menu.slint";

// The menu is drawn by this same program, started again for the purpose.
export { TrayMenu, MenuPanel, MenuRow }

// A piece of the bar that can be clicked.
component BarItem inherits Rectangle {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> dim: false;
    in property <bool> alert: false;
    in property <bool> caution: false;
    // Items that do nothing on click do not light up on hover either.
    in property <bool> interactive: true;
    callback clicked();

    border-radius: Tokens.radius;
    background: root.interactive && touch.has-hover ? Tokens.color-surface-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    height: Tokens.bar-height - Tokens.space-xs;
    width: content.preferred-width + Tokens.space-sm * 2;

    content := SengiText {
        text: root.text;
        color: root.alert ? Tokens.color-danger
            : root.caution ? Tokens.color-warning
            : root.dim ? Tokens.color-text-muted : Tokens.color-text;
        font-weight: root.strong ? Tokens.font-weight-bold : Tokens.font-weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }

    @children
}

// Icons are drawn as stroked paths on a 16 unit grid.
component Icon inherits Path {
    width: Tokens.bar-icon;
    height: Tokens.bar-icon;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Tokens.color-text;
    stroke-width: Tokens.icon-stroke;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component NotificationsIcon inherits Icon {
    commands: "M8 2a4 4 0 0 0-4 4v3l-1.5 2.5h11L12 9V6a4 4 0 0 0-4-4z M6.5 13.5a1.5 1.5 0 0 0 3 0";
}

component PowerIcon inherits Icon {
    commands: "M5 4.2a5 5 0 1 0 6 0 M8 2v5.5";
}

component IconItem inherits Rectangle {
    callback clicked();
    callback secondary-clicked();

    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.color-surface-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    height: Tokens.bar-height - Tokens.space-xs;
    width: Tokens.bar-icon + Tokens.space-sm * 2;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                root.secondary-clicked();
            }
        }
    }

    @children
}

export component Bar inherits Window {
    in property <string> clock;
    in property <string> network: "Offline";
    // Name of the connected Wi-Fi network, when it is known.
    in property <string> wifi-name;
    in property <bool> wifi: false;
    in property <bool> online: false;
    in property <string> volume;
    in property <bool> muted: false;
    in property <string> battery;
    in property <bool> battery-low: false;
    in property <bool> battery-warning: false;

    // Read by the program to size the layer surface.
    out property <length> bar-height: Tokens.bar-height;

    callback open-launcher();
    callback open-network();
    callback toggle-mute();
    callback show-notifications();
    callback dismiss-notifications();
    callback open-session();

    background: Tokens.color-bar;
    default-font-family: Tokens.font-family;
    height: Tokens.bar-height;

    HorizontalLayout {
        padding-left: Tokens.space-xs;
        padding-right: Tokens.space-xs;
        spacing: Tokens.space-xxs;

        VerticalLayout {
            alignment: center;
            BarItem {
                text: "Sengi OS";
                strong: true;
                clicked => { root.open-launcher(); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            BarItem {
                text: root.wifi && root.wifi-name != "" ? root.wifi-name : root.network;
                dim: !root.online;
                clicked => { root.open-network(); }
            }
        }

        if root.volume != "": VerticalLayout {
            alignment: center;
            BarItem {
                text: root.volume;
                dim: root.muted;
                clicked => { root.toggle-mute(); }
            }
        }

        if root.battery != "": VerticalLayout {
            alignment: center;
            BarItem {
                text: root.battery;
                alert: root.battery-low;
                caution: root.battery-warning;
                interactive: false;
            }
        }

        VerticalLayout {
            alignment: center;
            BarItem {
                text: root.clock;
                interactive: false;
            }
        }

        VerticalLayout {
            alignment: center;
            IconItem {
                clicked => { root.show-notifications(); }
                secondary-clicked => { root.dismiss-notifications(); }
                NotificationsIcon { }
            }
        }

        VerticalLayout {
            alignment: center;
            IconItem {
                clicked => { root.open-session(); }
                PowerIcon { }
            }
        }
    }
}
