// The Sengi OS top bar: menu on the left, status and session on the right.

import { Tokens, SengiText } from "components.slint";
import { TrayMenu, MenuPanel, MenuRow } from "tray-menu.slint";

// The menu is drawn by this same program, started again for the purpose.
export { TrayMenu, MenuPanel, MenuRow }

// One icon in the system tray.
export struct TrayEntry {
    id: int,
    icon: image,
    // False when the app gave no usable icon; the letter is shown instead.
    has-icon: bool,
    letter: string,
    // Shown beside the tray while the pointer is over the icon.
    label: string,
    attention: bool,
}

// A piece of the bar that can be clicked.
component BarItem inherits Rectangle {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> dim: false;
    in property <bool> alert: false;
    in property <bool> caution: false;
    // Items that do nothing on click do not light up on hover either.
    in property <bool> interactive: true;
    callback clicked();
    callback middle-clicked();

    border-radius: Tokens.radius;
    background: root.interactive && touch.has-hover ? Tokens.color-surface-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    height: Tokens.bar-height - Tokens.space-xs;
    width: content.preferred-width + Tokens.space-sm * 2;

    content := SengiText {
        text: root.text;
        color: root.alert ? Tokens.color-danger
            : root.caution ? Tokens.color-warning
            : root.dim ? Tokens.color-text-muted : Tokens.color-text;
        font-weight: root.strong ? Tokens.font-weight-bold : Tokens.font-weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                root.middle-clicked();
            }
        }
    }

    @children
}

// Icons are drawn as stroked paths on a 16 unit grid.
component Icon inherits Path {
    width: Tokens.bar-icon;
    height: Tokens.bar-icon;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Tokens.color-text;
    stroke-width: Tokens.icon-stroke;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component NotificationsIcon inherits Icon {
    commands: "M8 2a4 4 0 0 0-4 4v3l-1.5 2.5h11L12 9V6a4 4 0 0 0-4-4z M6.5 13.5a1.5 1.5 0 0 0 3 0";
}

component PowerIcon inherits Icon {
    commands: "M5 4.2a5 5 0 1 0 6 0 M8 2v5.5";
}

component IconItem inherits Rectangle {
    callback clicked();
    callback secondary-clicked();

    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.color-surface-hover : transparent;
    animate background { duration: Tokens.motion-fast; }
    height: Tokens.bar-height - Tokens.space-xs;
    width: Tokens.bar-icon + Tokens.space-sm * 2;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                root.secondary-clicked();
            }
        }
    }

    @children
}

// An app's icon in the tray. Sized and lit like the bar's own icon items.
component TrayItem inherits Rectangle {
    in property <TrayEntry> entry;
    out property <bool> hovered: touch.has-hover;
    // 0 is the left button, 1 the middle and 2 the right.
    callback pressed(int);
    callback scrolled(length, length);

    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.color-surface-hover : transparent;
    animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }
    height: Tokens.bar-height - Tokens.space-xs;
    width: Tokens.bar-icon + Tokens.space-sm * 2;

    if root.entry.has-icon: Image {
        width: Tokens.bar-icon;
        height: Tokens.bar-icon;
        source: root.entry.icon;
        image-fit: contain;
    }

    if !root.entry.has-icon: Rectangle {
        width: Tokens.bar-icon;
        height: Tokens.bar-icon;
        border-radius: Tokens.radius;
        background: Tokens.color-surface-raised;

        SengiText {
            text: root.entry.letter;
            font-size: Tokens.font-size-sm;
            font-weight: Tokens.font-weight-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The dot sits on the icon's top right corner, ringed in the bar's
    // colour so it reads against any icon.
    if root.entry.attention: Rectangle {
        width: Tokens.space-sm;
        height: self.width;
        x: (parent.width + Tokens.bar-icon) / 2 - self.width / 2 - Tokens.space-xxs;
        y: (parent.height - Tokens.bar-icon) / 2 - Tokens.space-xxs;
        border-radius: self.width / 2;
        border-width: Tokens.border-width;
        border-color: Tokens.color-bg;
        background: Tokens.color-accent;
    }

    touch := TouchArea {
        clicked => { root.pressed(0); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                root.pressed(1);
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                root.pressed(2);
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-x, event.delta-y);
            return accept;
        }
    }
}

export component Bar inherits Window {
    in property <string> clock;
    in property <string> network: "Offline";
    // Name of the connected Wi-Fi network, when it is known.
    in property <string> wifi-name;
    in property <bool> wifi: false;
    in property <bool> online: false;
    in property <string> volume;
    in property <bool> muted: false;
    in property <string> battery;
    in property <bool> battery-low: false;
    in property <bool> battery-warning: false;

    // Icons of the apps running in the background. Empty is no tray at all.
    in property <[TrayEntry]> tray;

    // Read by the program to size the layer surface.
    out property <length> bar-height: Tokens.bar-height;
    // Read by the program to decode tray icons at the size they are drawn.
    out property <length> tray-icon-size: Tokens.bar-icon;

    callback open-launcher();
    // The network, volume or battery item was clicked.
    callback open-quick();
    callback toggle-mute();
    callback show-notifications();
    callback dismiss-notifications();
    callback open-session();
    // A tray icon was clicked: its id, the button (0 left, 1 middle,
    // 2 right) and where its left edge is, for the menu to open under.
    callback tray-pressed(int, int, length);
    // The wheel was turned over a tray icon: its id and the distance.
    callback tray-scrolled(int, length, length);

    // The tray icon under the pointer and what it is called.
    private property <int> tray-hover: -1;
    private property <string> tray-label;

    // The program calls this when the icons change, since the one that was
    // under the pointer may be gone.
    public function tray-changed() {
        root.tray-hover = -1;
    }

    background: Tokens.color-bar;
    default-font-family: Tokens.font-family;
    height: Tokens.bar-height;

    HorizontalLayout {
        padding-left: Tokens.space-xs;
        padding-right: Tokens.space-xs;
        spacing: Tokens.space-xxs;

        VerticalLayout {
            alignment: center;
            BarItem {
                text: "Sengi OS";
                strong: true;
                clicked => { root.open-launcher(); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            // There is no room under the bar for a tooltip, so the name of
            // the tray icon under the pointer is shown beside the tray.
            SengiText {
                x: 0;
                width: parent.width - Tokens.space-sm;
                text: root.tray-label;
                color: Tokens.color-text-muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                opacity: root.tray-hover >= 0 ? 1 : 0;
                animate opacity { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }
            }
        }

        for entry in root.tray: VerticalLayout {
            alignment: center;
            item := TrayItem {
                entry: entry;
                pressed(button) => {
                    root.tray-pressed(entry.id, button, item.absolute-position.x);
                }
                scrolled(dx, dy) => { root.tray-scrolled(entry.id, dx, dy); }
                changed hovered => {
                    if self.hovered {
                        root.tray-label = entry.label;
                        root.tray-hover = entry.id;
                    } else if root.tray-hover == entry.id {
                        root.tray-hover = -1;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            BarItem {
                text: root.wifi && root.wifi-name != "" ? root.wifi-name : root.network;
                dim: !root.online;
                clicked => { root.open-quick(); }
            }
        }

        if root.volume != "": VerticalLayout {
            alignment: center;
            BarItem {
                text: root.volume;
                dim: root.muted;
                clicked => { root.open-quick(); }
                middle-clicked => { root.toggle-mute(); }
            }
        }

        if root.battery != "": VerticalLayout {
            alignment: center;
            BarItem {
                text: root.battery;
                alert: root.battery-low;
                caution: root.battery-warning;
                clicked => { root.open-quick(); }
            }
        }

        VerticalLayout {
            alignment: center;
            BarItem {
                text: root.clock;
                interactive: false;
            }
        }

        VerticalLayout {
            alignment: center;
            IconItem {
                clicked => { root.show-notifications(); }
                secondary-clicked => { root.dismiss-notifications(); }
                NotificationsIcon { }
            }
        }

        VerticalLayout {
            alignment: center;
            IconItem {
                clicked => { root.open-session(); }
                PowerIcon { }
            }
        }
    }
}
