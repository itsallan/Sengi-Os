// The store's window: a search field on top and under it a page of grids.
// The start page has a tile for each category and the featured apps, a
// category and a search show app cards. Built from the shared components
// and Settings' kit; nothing here has a colour or a size of its own.

import { Tokens, SengiText, SengiLabel, SengiButton, SengiIcon, SengiProgress } from "components.slint";
export { ThemeSwitch } from "components.slint";
import { Scroll, TextField, DialogLayer } from "kit.slint";

// What an app is doing.
export enum RowState { available, installing, installed, removing, failed }

export enum StorePage { start, category, search }

// A category on the start page.
export struct Tile {
    name: string,
    // The name of a Phosphor Bold icon.
    icon: string,
}

export struct Card {
    id: string,
    name: string,
    summary: string,
    // The icon, if Flathub's has arrived; else a placeholder with the
    // category's glyph, or the initial for an app of no category.
    icon: image,
    has-icon: bool,
    glyph: string,
    letter: string,
    // How far an install has got, 0 to 100, or less than 0 when flatpak
    // has not said.
    percent: int,
    // What step it is on and how much that downloads, and under it the
    // speed and the time left, when flatpak says.
    detail: string,
    pace: string,
    state: RowState,
    // The install was told to stop and has not yet.
    cancelling: bool,
    // Installed by this user, so it may be removed.
    removable: bool,
    // Shown by name only, because the list of apps is not there: no button
    // to install it.
    unavailable: bool,
}

// What the window shows and what it reports. Rust fills the one and hears
// the other.
export global Store {
    in property <StorePage> page;
    // The heading of a category or of the results of a search.
    in property <string> title;
    in property <[Tile]> tiles;
    in property <[Card]> cards;
    // Said in place of the cards when there are none.
    in property <string> hint;
    // A banner over the page, such as that there is no network.
    in property <string> banner;
    // With a Retry button, or with a bar that says work is going on.
    in property <bool> banner-retry;
    in property <bool> banner-busy;
    // What the search field holds when the window opens (--search).
    in property <string> start-query;
    // The line under the page.
    in property <string> message;
    in property <bool> message-is-error: false;
    // The chosen tile or card, counting tiles first, or -1 for none.
    in-out property <int> current: -1;
    // Whether the question before an app is removed is on show, and what
    // it says. The words are left as they are when it is answered.
    in property <bool> asking;
    in property <string> remove-title;
    in property <string> remove-body;

    callback search(string);
    callback install(string);
    callback open(string);
    // Stops the install of an app.
    callback cancel(string);
    // Remove was pressed, and then the question answered yes or no.
    callback ask-remove(string);
    callback confirm-remove();
    callback keep();
    callback open-category(int);
    callback back();
    callback retry();
    // Where a key leads from `current`: 0 left, 1 right, 2 up, 3 down,
    // with the tiles and the cards that fit side by side.
    callback step(int, int, int, int) -> int;
    // Physical pixels to a logical one, for the size icons are decoded to.
    callback scaled(float);
}

// Work that cannot say how far it has got: a short bar going to and fro.
component Busy inherits Rectangle {
    private property <bool> over: false;

    width: Tokens.space-xxl;
    height: Tokens.space-xs;
    border-radius: self.height / 2;
    background: Tokens.color-surface-hover;
    init => { root.over = true; }

    Rectangle {
        width: parent.width / 3;
        x: root.over ? parent.width - self.width : 0;
        border-radius: parent.border-radius;
        background: Tokens.color-accent;
        animate x {
            duration: Tokens.motion-slow * 3;
            easing: Tokens.motion-easing;
            iteration-count: -1;
            direction: alternate;
        }
    }
}

component BackButton inherits Rectangle {
    callback clicked();

    width: Tokens.button;
    height: Tokens.button;
    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.color-surface-hover : Tokens.color-surface-raised;
    animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }
    accessible-role: button;
    accessible-label: "Back";
    accessible-action-default => { root.clicked(); }

    SengiIcon {
            x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "arrow-left";
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The surface of a tile and of a card, with the ring of the one the keys
// are on.
component Panel inherits Rectangle {
    in property <bool> selected;
    in property <bool> hovered;

    border-radius: Tokens.radius;
    border-width: root.selected ? Tokens.focus-ring-width : Tokens.border-width;
    border-color: root.selected ? Tokens.color-focus-ring : Tokens.color-border;
    background: root.hovered ? Tokens.color-surface-raised : Tokens.color-surface;
    animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }
}

component CategoryTile inherits Panel {
    in property <Tile> tile;
    callback chosen();

    hovered: touch.has-hover;
    accessible-role: button;
    accessible-label: root.tile.name;
    accessible-action-default => { root.chosen(); }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-md;

        VerticalLayout {
            alignment: center;
            SengiIcon {
                width: Tokens.store-tile-icon;
                height: Tokens.store-tile-icon;
                name: root.tile.icon;
                ink: Tokens.color-accent-strong;
            }
        }

        SengiText {
            horizontal-stretch: 1;
            text: root.tile.name;
            font-weight: Tokens.font-weight-medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AppIcon inherits Rectangle {
    in property <Card> app;

    width: Tokens.store-app-icon;
    height: Tokens.store-app-icon;
    border-radius: Tokens.radius;
    background: root.app.has-icon ? transparent : Tokens.color-surface-raised;

    if root.app.has-icon: Image {
        width: parent.width;
        height: parent.height;
        source: root.app.icon;
        image-fit: contain;
    }

    if !root.app.has-icon && root.app.glyph != "": SengiIcon {
            x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Tokens.store-tile-icon;
        height: Tokens.store-tile-icon;
        name: root.app.glyph;
        ink: Tokens.color-text-muted;
    }

    if !root.app.has-icon && root.app.glyph == "": SengiText {
        width: parent.width;
        height: parent.height;
        text: root.app.letter;
        color: Tokens.color-text-muted;
        font-size: Tokens.font-size-xl;
        font-weight: Tokens.font-weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component AppCard inherits Panel {
    in property <Card> app;
    callback chosen();
    callback install();
    callback open();
    callback cancel();
    callback remove();

    // Being installed or removed.
    private property <bool> working: root.app.state == RowState.installing
        || root.app.state == RowState.removing;
    private property <length> inner: self.width - Tokens.space-md * 2;
    private property <length> words-x: Tokens.space-md * 2 + Tokens.store-app-icon;
    private property <length> foot: self.height - Tokens.space-md - Tokens.button;

    hovered: touch.has-hover;
    accessible-role: list-item;
    accessible-label: root.app.name;

    touch := TouchArea {
        clicked => { root.chosen(); }
    }

    AppIcon {
        x: Tokens.space-md;
        y: Tokens.space-md;
        app: root.app;
    }

    VerticalLayout {
        x: root.words-x;
        y: Tokens.space-md;
        width: root.width - root.words-x - Tokens.space-md;
        height: root.foot - Tokens.space-md - Tokens.space-xs;
        spacing: Tokens.space-xxs;
        alignment: start;

        SengiText {
            text: root.app.name;
            font-weight: Tokens.font-weight-medium;
            overflow: elide;
        }

        if root.app.summary != "" && !root.working: SengiLabel {
            // Two lines, and no more.
            height: Tokens.font-size-sm * 3;
            text: root.app.summary;
            font-weight: Tokens.font-weight-regular;
            wrap: word-wrap;
            overflow: elide;
        }

        // How far it is, where the summary was.
        if root.working: SengiLabel {
            text: root.app.state == RowState.removing ? "Removing"
                : root.app.cancelling ? "Cancelling"
                : root.app.detail != "" ? root.app.detail : "Installing";
            font-weight: Tokens.font-weight-regular;
            overflow: elide;
        }

        if root.app.state == RowState.installing && root.app.pace != "": SengiLabel {
            text: root.app.pace;
            font-weight: Tokens.font-weight-regular;
            overflow: elide;
        }
    }

    if root.working: HorizontalLayout {
        x: Tokens.space-md;
        y: root.foot;
        width: root.inner;
        height: Tokens.button;
        spacing: Tokens.space-sm;

        if root.app.percent >= 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            SengiProgress { percent: root.app.percent; }
        }

        if root.app.percent >= 0: SengiText {
            text: root.app.percent + "%";
            color: Tokens.color-text-muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: Tokens.space-xxl - Tokens.space-md;
        }

        if root.app.percent < 0: Rectangle {
            horizontal-stretch: 1;
            Busy {
                y: (parent.height - self.height) / 2;
                width: parent.width;
            }
        }

        if root.app.state == RowState.installing && !root.app.cancelling: SengiButton {
            horizontal-stretch: 0;
            text: "Cancel";
            outlined: true;
            focusable: false;
            clicked => { root.cancel(); }
        }
    }

    if root.app.state == RowState.failed: SengiLabel {
        x: Tokens.space-md;
        y: root.foot;
        height: Tokens.button;
        text: "Not installed";
        color: Tokens.color-danger;
        vertical-alignment: center;
    }

    if root.app.state == RowState.installed: HorizontalLayout {
        x: Tokens.space-md;
        y: root.foot;
        width: root.inner;
        height: Tokens.button;
        alignment: end;
        spacing: Tokens.space-sm;

        if root.app.removable: SengiButton {
            text: "Remove";
            danger: true;
            outlined: true;
            focusable: false;
            clicked => { root.remove(); }
        }

        SengiButton {
            text: "Open";
            primary: root.selected;
            outlined: true;
            focusable: false;
            clicked => { root.open(); }
        }
    }

    if (root.app.state == RowState.available || root.app.state == RowState.failed) && !root.app.unavailable: SengiButton {
        x: root.width - self.width - Tokens.space-md;
        y: root.foot;
        width: self.preferred-width;
        height: Tokens.button;
        text: root.app.state == RowState.failed ? "Try again" : "Install";
        primary: root.selected;
        outlined: true;
        focusable: false;
        clicked => { root.install(); }
    }
}

component Heading inherits SengiText {
    height: Tokens.button;
    font-size: Tokens.font-size-lg;
    font-weight: Tokens.font-weight-bold;
    vertical-alignment: center;
    overflow: elide;
}

export component StoreWindow inherits Window {
    title: "Store";
    preferred-width: Tokens.settings-window-width;
    preferred-height: Tokens.settings-window-height;
    min-width: Tokens.chooser-width;
    min-height: Tokens.settings-window-min-height;
    background: Tokens.color-bg;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.font-size-md;

    // However wide the window is, the grids stay no wider than this.
    private property <length> column: Math.min(root.width, Tokens.store-page-width + Tokens.space-lg * 2);
    private property <length> page-width: root.column - Tokens.space-lg * 2;
    private property <length> gap: Tokens.space-md;

    private property <int> tiles-fit: Math.clamp(
        Math.floor((root.page-width + root.gap) / (Tokens.store-tile-width + root.gap)), 2, 5);
    // A column less rather than one tile alone in the last row.
    private property <int> tile-columns: root.tiles-fit > 2 && Math.mod(Store.tiles.length, root.tiles-fit) == 1
        ? root.tiles-fit - 1 : root.tiles-fit;
    private property <int> card-columns: Math.clamp(
        Math.floor((root.page-width + root.gap) / (Tokens.store-card-width + root.gap)), 2, 4);
    private property <length> tile-width: (root.page-width - root.gap * (root.tile-columns - 1)) / root.tile-columns;
    private property <length> card-width: (root.page-width - root.gap * (root.card-columns - 1)) / root.card-columns;
    private property <length> tile-step: Tokens.store-tile-height + root.gap;
    private property <length> card-step: Tokens.store-card-height + root.gap;

    private property <bool> at-start: Store.page == StorePage.start;
    private property <length> head: Tokens.button + Tokens.space-sm;
    private property <length> tiles-height: Math.ceil(Store.tiles.length / root.tile-columns) * root.tile-step;
    private property <length> cards-heading: root.at-start ? root.head + root.tiles-height + Tokens.space-sm : 0px;
    private property <length> cards-top: root.cards-heading + root.head;
    private property <length> content: root.cards-top
        + Math.ceil(Store.cards.length / root.card-columns) * root.card-step + Tokens.space-xs;

    // The keys have gone into the grids, so left and right move there and
    // not in the text of the field.
    private property <bool> browsing: false;

    // The renderer keeps two buffers and only one of them knows after a
    // change of size or scale that it is new, so for a few frames the
    // whole window is drawn, as Settings does.
    private property <float> pixel: 1phx / 1px;
    private property <int> sheet: 0;
    private property <int> sheets-owed: 0;

    function draw-everything() {
        root.sheet += 1;
        root.sheets-owed = 3;
    }

    // No band is asked to be taller than the view, which has no height yet
    // when the window has just been made.
    function bring(top: length, height: length) {
        list.reveal(top, Math.min(height, list.height));
    }

    // Brings the chosen tile or card into view, and with the first row of
    // a grid its heading.
    function reveal-current() {
        if Store.current < 0 {
            return;
        }
        if Store.current < Store.tiles.length {
            if Store.current < root.tile-columns {
                root.bring(0px, root.head + root.tile-step);
            } else {
                root.bring(root.head + Math.floor(Store.current / root.tile-columns) * root.tile-step,
                    root.tile-step);
            }
        } else if Store.current - Store.tiles.length < root.card-columns {
            root.bring(root.cards-heading, root.head + root.card-step);
        } else {
            root.bring(root.cards-top
                    + Math.floor((Store.current - Store.tiles.length) / root.card-columns) * root.card-step,
                root.card-step);
        }
    }

    function move(key: int) {
        Store.current = Store.step(Store.current, key, root.tile-columns, root.card-columns);
        root.browsing = Store.current >= 0;
        if Store.current < 0 {
            root.bring(0px, root.head);
        } else {
            root.reveal-current();
        }
    }

    function use-current() {
        if Store.current < 0 {
            return;
        }
        if Store.current < Store.tiles.length {
            Store.open-category(Store.current);
        } else if Store.current - Store.tiles.length < Store.cards.length {
            if Store.cards[Store.current - Store.tiles.length].state == RowState.installed {
                Store.open(Store.cards[Store.current - Store.tiles.length].id);
            } else if !Store.cards[Store.current - Store.tiles.length].unavailable
                && Store.cards[Store.current - Store.tiles.length].state != RowState.installing
                && Store.cards[Store.current - Store.tiles.length].state != RowState.removing {
                Store.install(Store.cards[Store.current - Store.tiles.length].id);
            }
        }
    }

    // Delete on a card: stops its install, or asks about removing it.
    function take-away-current() -> bool {
        if Store.current < Store.tiles.length || Store.current - Store.tiles.length >= Store.cards.length {
            return false;
        }
        if Store.cards[Store.current - Store.tiles.length].state == RowState.installing {
            Store.cancel(Store.cards[Store.current - Store.tiles.length].id);
            return true;
        }
        if Store.cards[Store.current - Store.tiles.length].removable
            && Store.cards[Store.current - Store.tiles.length].state == RowState.installed {
            Store.ask-remove(Store.cards[Store.current - Store.tiles.length].id);
            return true;
        }
        return false;
    }

    // Out of a search first, then out of a category.
    function go-back() {
        root.browsing = false;
        if field.text != "" {
            field.clear();
            Store.search("");
        } else {
            Store.back();
        }
        field.take-focus();
    }

    changed pixel => {
        root.draw-everything();
        Store.scaled(root.pixel > 0 ? 1 / root.pixel : 1);
    }
    changed width => { root.draw-everything(); }
    changed height => { root.draw-everything(); }
    init => {
        field.take-focus();
        Store.scaled(root.pixel > 0 ? 1 / root.pixel : 1);
    }

    // Set by the program after the window is made, when it was started with
    // --search.
    private property <string> start-query: Store.start-query;
    // Selected, so that typing starts a search of one's own.
    changed start-query => {
        field.text = root.start-query;
        field.select-all();
    }

    // Another page starts at its top, and the chosen thing is in view.
    private property <string> shown: Store.title;
    changed shown => {
        root.bring(0px, root.head);
        root.reveal-current();
    }
    private property <int> chosen: Store.current;
    changed chosen => { root.reveal-current(); }

    // The keyboard goes back to the field when a question is answered.
    private property <bool> asking: Store.asking;
    changed asking => {
        if !root.asking {
            field.take-focus();
        }
    }

    Timer {
        interval: Tokens.motion-fast;
        running: root.sheets-owed > 0;
        triggered => {
            root.sheet += 1;
            root.sheets-owed -= 1;
        }
    }

    Rectangle {
        background: Math.mod(root.sheet, 2) == 0 ? transparent : Tokens.color-bg.transparentize(1);
    }

    // Sees keys before the field does, which keeps the keyboard all the
    // time: the grids are only marked.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.move(0);
                return accept;
            }
            if event.text == Key.Tab {
                root.move(1);
                return accept;
            }
            if event.text == Key.LeftArrow && event.modifiers.alt {
                root.go-back();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow)
                && (field.text == "" || root.browsing) {
                root.move(event.text == Key.LeftArrow ? 0 : 1);
                return accept;
            }
            if event.text == Key.Delete && (field.text == "" || root.browsing)
                && root.take-away-current() {
                return accept;
            }
            if event.text == Key.Backspace && field.text == "" && !root.at-start {
                // A held key that emptied the field goes no further.
                if !event.repeat {
                    root.go-back();
                }
                return accept;
            }
            return reject;
        }

        // However wide the window is, the page stays in the middle of it.
        Rectangle {
            width: root.column;
            x: (parent.width - self.width) / 2;

            VerticalLayout {
                padding-top: Tokens.space-lg;
                spacing: Tokens.space-md;

                HorizontalLayout {
                    padding-left: Tokens.space-lg;
                    padding-right: Tokens.space-lg;
                    spacing: Tokens.space-sm;

                    if Store.page != StorePage.start: BackButton {
                        clicked => { root.go-back(); }
                    }

                    field := TextField {
                        horizontal-stretch: 1;
                        placeholder: "Search apps by name";
                        edited(text) => {
                            root.browsing = false;
                            Store.search(text);
                        }
                        accepted => { root.use-current(); }
                        cancelled => { root.go-back(); }
                        stepped(by) => { root.move(by < 0 ? 2 : 3); }
                    }
                }

                if Store.banner != "": HorizontalLayout {
                    padding-left: Tokens.space-lg;
                    padding-right: Tokens.space-lg;
                    Rectangle {
                        height: Math.max(words.preferred-height, Tokens.button) + Tokens.space-sm * 2;
                        border-radius: Tokens.radius;
                        background: Tokens.color-surface-raised;

                        SengiIcon {
                            x: Tokens.space-md;
                            y: (parent.height - self.height) / 2;
                            name: Store.banner-busy ? "arrows-clockwise" : "wifi-slash";
                            ink: Tokens.color-text-muted;
                        }

                        words := SengiText {
                            x: Tokens.space-md * 2 + Tokens.bar-icon;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - self.x - Tokens.space-md * 2
                                - (Store.banner-retry ? retry.preferred-width : Store.banner-busy ? Tokens.space-xxl : 0px);
                            height: self.preferred-height;
                            text: Store.banner;
                            wrap: word-wrap;
                        }

                        retry := SengiButton {
                            x: parent.width - self.width - Tokens.space-sm;
                            y: (parent.height - self.height) / 2;
                            width: self.preferred-width;
                            height: Tokens.button;
                            visible: Store.banner-retry;
                            enabled: Store.banner-retry;
                            outlined: true;
                            focusable: false;
                            text: "Retry";
                            clicked => {
                                Store.retry();
                                field.take-focus();
                            }
                        }

                        if Store.banner-busy: Busy {
                            x: parent.width - self.width - Tokens.space-md;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    list := Scroll {
                        content-height: root.content;

                        if root.at-start: Heading {
                            x: Tokens.space-lg;
                            y: 0px;
                            width: root.page-width;
                            text: "Categories";
                        }

                        for tile[index] in Store.tiles: CategoryTile {
                            x: Tokens.space-lg + Math.mod(index, root.tile-columns) * (root.tile-width + root.gap);
                            y: root.head + Math.floor(index / root.tile-columns) * root.tile-step;
                            width: root.tile-width;
                            height: Tokens.store-tile-height;
                            tile: tile;
                            selected: Store.current == index;
                            chosen => {
                                root.browsing = false;
                                Store.open-category(index);
                                field.take-focus();
                            }
                        }

                        Heading {
                            x: Tokens.space-lg;
                            y: root.cards-heading;
                            width: root.page-width;
                            text: root.at-start ? "Featured" : Store.title;
                        }

                        for app[index] in Store.cards: AppCard {
                            x: Tokens.space-lg + Math.mod(index, root.card-columns) * (root.card-width + root.gap);
                            y: root.cards-top + Math.floor(index / root.card-columns) * root.card-step;
                            width: root.card-width;
                            height: Tokens.store-card-height;
                            app: app;
                            selected: Store.current == index + Store.tiles.length;
                            chosen => {
                                Store.current = index + Store.tiles.length;
                                field.take-focus();
                            }
                            install => {
                                Store.current = index + Store.tiles.length;
                                Store.install(app.id);
                                field.take-focus();
                            }
                            open => {
                                Store.current = index + Store.tiles.length;
                                Store.open(app.id);
                                field.take-focus();
                            }
                            cancel => {
                                Store.current = index + Store.tiles.length;
                                Store.cancel(app.id);
                                field.take-focus();
                            }
                            remove => {
                                Store.current = index + Store.tiles.length;
                                Store.ask-remove(app.id);
                                field.take-focus();
                            }
                        }

                        if Store.cards.length == 0: SengiText {
                            x: Tokens.space-lg;
                            y: root.cards-top + Tokens.space-xl;
                            width: root.page-width;
                            text: Store.hint;
                            color: Tokens.color-text-muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                if Store.message != "": HorizontalLayout {
                    padding-left: Tokens.space-lg;
                    padding-right: Tokens.space-lg;
                    padding-bottom: Tokens.space-md;
                    SengiText {
                        text: Store.message;
                        color: Store.message-is-error ? Tokens.color-danger : Tokens.color-text-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Outside the scope above, so that Tab and the other keys are the
    // dialog's own while it is open.
    if Store.asking: DialogLayer {
        spec: {
            title: Store.remove-title,
            body: Store.remove-body,
            confirm: "Remove",
            cancel: "Cancel",
            danger: true,
        };
        confirmed => { Store.confirm-remove(); }
        cancelled => { Store.keep(); }
    }
}
