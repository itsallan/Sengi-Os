// The store's window: a search field on top, the apps whose names match
// under it, and one line at the bottom for what is going on. Built from
// the shared components and Settings' kit; nothing here has a colour or a
// size of its own.

import { Tokens, SengiText, SengiLabel, SengiButton, SengiProgress } from "components.slint";
export { ThemeSwitch } from "components.slint";
import { Scroll, TextField } from "kit.slint";

// What an app in the list is doing.
export enum RowState { available, installing, installed, failed }

export struct Row {
    id: string,
    name: string,
    summary: string,
    // The icon, if there is one; else a tile with the initial.
    icon: image,
    has-icon: bool,
    // How far an install has got, 0 to 100, or less than 0 when flatpak
    // has not said.
    percent: int,
    // What step it is on, and the size and speed, when flatpak says.
    detail: string,
    letter: string,
    state: RowState,
    // A group's name (in `name`) and not an app: no button, no stop for
    // the keys.
    heading: bool,
    // Shown by name only, because Flathub is not there: no button.
    unavailable: bool,
}

// What the window shows and what it reports. Rust fills the one and hears
// the other.
export global Store {
    in property <[Row]> rows;
    // Said in place of the list when it has nothing to show.
    in property <string> hint;
    // A note over the list, such as that Flathub cannot be reached.
    in property <string> notice;
    // What the search field holds when the window opens (--search).
    in property <string> start-query;
    // The line under the list.
    in property <string> message;
    in property <bool> message-is-error: false;
    in-out property <int> current: 0;
    // The chips under the search field, and the one that is chosen.
    // All of them in order, and the same in two rows, because they do
    // not fit in one.
    in property <[string]> chips;
    in property <[string]> chips-first;
    in property <[string]> chips-second;
    in-out property <int> chip: 0;
    callback chip-selected(int);
    // The row `by` (1 or -1) from `current` that is not a heading.
    callback step-row(int, int) -> int;
    callback search(string);
    callback install(string);
    callback open(string);
}

// Work that cannot say how far it has got: a short bar going to and fro.
component Busy inherits Rectangle {
    private property <bool> over: false;

    width: Tokens.space-xxl;
    height: Tokens.space-xs;
    border-radius: self.height / 2;
    background: Tokens.color-surface-raised;
    init => { root.over = true; }

    Rectangle {
        width: parent.width / 3;
        x: root.over ? parent.width - self.width : 0;
        border-radius: parent.border-radius;
        background: Tokens.color-accent;
        animate x {
            duration: Tokens.motion-slow * 3;
            easing: Tokens.motion-easing;
            iteration-count: -1;
            direction: alternate;
        }
    }
}

// One choice among the groups of apps.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: Tokens.button;
    preferred-width: label.preferred-width + Tokens.space-md * 2;
    border-radius: Tokens.radius;
    background: root.selected ? Tokens.color-accent
        : touch.has-hover ? Tokens.color-surface-hover : Tokens.color-surface-raised;
    animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

    label := SengiText {
        text: root.text;
        color: root.selected ? Tokens.color-accent-text : Tokens.color-text;
        font-weight: Tokens.font-weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AppTile inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> letter;

    width: Tokens.dock-icon;
    height: Tokens.dock-icon;
    border-radius: Tokens.radius;
    background: root.has-icon ? transparent : Tokens.color-surface-raised;
    border-width: root.has-icon ? 0 : Tokens.border-width;
    border-color: Tokens.color-border;

    if root.has-icon: Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }

    if !root.has-icon: SengiText {
        text: root.letter;
        font-size: Tokens.font-size-xl;
        font-weight: Tokens.font-weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component StoreWindow inherits Window {
    title: "Store";
    preferred-width: Tokens.settings-page-width + Tokens.space-xxl;
    preferred-height: Tokens.settings-window-height;
    min-width: Tokens.chooser-width;
    min-height: Tokens.settings-window-min-height;
    background: Tokens.color-bg;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.font-size-md;

    private property <length> line: Tokens.dock-icon + Tokens.space-sm;
    // However wide the window is, the list stays as wide as it opens.
    private property <length> widest: Tokens.settings-page-width + Tokens.space-xxl;
    private property <int> hovered: -1;

    // The renderer keeps two buffers and only one of them knows after a
    // change of size or scale that it is new, so for a few frames the
    // whole window is drawn, as Settings does.
    private property <float> pixel: 1phx / 1px;
    private property <int> sheet: 0;
    private property <int> sheets-owed: 0;

    function draw-everything() {
        root.sheet += 1;
        root.sheets-owed = 3;
    }

    function step(by: int) {
        if Store.rows.length > 0 {
            Store.current = Store.step-row(Store.current, by);
            // The heading above the first app of a group comes into
            // view with it.
            if Store.current > 0 && Store.rows[Store.current - 1].heading {
                list.reveal((Store.current - 1) * root.line, root.line * 2);
            } else {
                list.reveal(Store.current * root.line, root.line);
            }
        }
    }

    function use-current() {
        if Store.current >= 0 && Store.current < Store.rows.length
            && !Store.rows[Store.current].heading {
            if Store.rows[Store.current].state == RowState.installed {
                Store.open(Store.rows[Store.current].id);
            } else if !Store.rows[Store.current].unavailable {
                Store.install(Store.rows[Store.current].id);
            }
        }
    }

    function pick-chip(index: int) {
        if index >= 0 && index < Store.chips.length {
            Store.chip = index;
            Store.chip-selected(index);
            list.reveal(0, root.line);
        }
    }

    changed pixel => { root.draw-everything(); }
    changed width => { root.draw-everything(); }
    changed height => { root.draw-everything(); }
    init => { field.take-focus(); }

    // Set by the program after the window is made, when it was started with
    // --search.
    private property <string> start-query: Store.start-query;
    changed start-query => { field.text = root.start-query; }

    Timer {
        interval: Tokens.motion-fast;
        running: root.sheets-owed > 0;
        triggered => {
            root.sheet += 1;
            root.sheets-owed -= 1;
        }
    }

    Rectangle {
        background: Math.mod(root.sheet, 2) == 0 ? transparent : Tokens.color-bg.transparentize(1);
    }

    // Sees Tab before the field does: it moves along the chips, and
    // Shift+Tab back, so the keyboard never leaves the search field.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                root.pick-chip(Math.mod(Store.chip - 1 + Store.chips.length, Store.chips.length));
                return accept;
            }
            if event.text == Key.Tab {
                root.pick-chip(Math.mod(Store.chip + 1, Store.chips.length));
                return accept;
            }
            return reject;
        }

    Rectangle {
        width: Math.min(parent.width, root.widest);
        x: (parent.width - self.width) / 2;

        VerticalLayout {
            padding: Tokens.space-lg;
            spacing: Tokens.space-md;

            field := TextField {
                placeholder: "Search apps by name";
                edited(text) => {
                    Store.current = 0;
                    Store.search(text);
                }
                accepted => { root.use-current(); }
                cancelled => {
                    self.clear();
                    Store.current = 0;
                    Store.search("");
                }
                stepped(by) => { root.step(by); }
            }

            // The chips in two rows, because all of them do not fit in one.
            VerticalLayout {
                spacing: Tokens.space-sm;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    alignment: start;
                    for label[index] in Store.chips-first: Chip {
                        text: label;
                        selected: Store.chip == index;
                        clicked => {
                            root.pick-chip(index);
                            field.take-focus();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    alignment: start;
                    for label[index] in Store.chips-second: Chip {
                        text: label;
                        selected: Store.chip == index + Store.chips-first.length;
                        clicked => {
                            root.pick-chip(index + Store.chips-first.length);
                            field.take-focus();
                        }
                    }
                }
            }

            if Store.notice != "": Rectangle {
                height: notice-text.preferred-height + Tokens.space-sm * 2;
                border-radius: Tokens.radius;
                background: Tokens.color-surface-raised;
                notice-text := SengiText {
                    x: Tokens.space-md;
                    y: Tokens.space-sm;
                    width: parent.width - Tokens.space-md * 2;
                    text: Store.notice;
                    color: Tokens.color-text;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                vertical-stretch: 1;

                list := Scroll {
                    content-height: Store.rows.length * root.line;

                    for app[index] in Store.rows: Rectangle {
                        private property <bool> lit: !app.heading
                            && (root.hovered == index || Store.current == index);

                        y: index * root.line;
                        height: root.line;
                        border-radius: Tokens.radius;
                        background: self.lit ? Tokens.color-surface-hover : transparent;
                        animate background { duration: Tokens.motion-fast; easing: Tokens.motion-easing; }

                        if app.heading: SengiText {
                            x: Tokens.space-sm;
                            width: parent.width - Tokens.space-sm * 2;
                            height: parent.height - Tokens.space-xs;
                            text: app.name;
                            color: Tokens.color-text-muted;
                            font-weight: Tokens.font-weight-medium;
                            vertical-alignment: bottom;
                            overflow: elide;
                        }

                        TouchArea {
                            enabled: !app.heading;
                            visible: !app.heading;
                            changed has-hover => {
                                if self.has-hover {
                                    root.hovered = index;
                                } else if root.hovered == index {
                                    root.hovered = -1;
                                }
                            }
                            clicked => {
                                Store.current = index;
                                field.take-focus();
                            }

                            HorizontalLayout {
                                padding-left: Tokens.space-sm;
                                padding-right: Tokens.space-md;
                                spacing: Tokens.space-md;

                                VerticalLayout {
                                    alignment: center;
                                    AppTile {
                                        icon: app.icon;
                                        has-icon: app.has-icon;
                                        letter: app.letter;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Tokens.space-xxs;

                                    SengiText {
                                        text: app.name;
                                        font-weight: Tokens.font-weight-medium;
                                        overflow: elide;
                                    }

                                    if app.summary != "": SengiLabel {
                                        text: app.summary;
                                        font-weight: Tokens.font-weight-regular;
                                        overflow: elide;
                                    }
                                }

                                if app.state == RowState.installing && app.percent >= 0: VerticalLayout {
                                    width: Tokens.dialog-width * 2 / 3;
                                    alignment: center;
                                    spacing: Tokens.space-xs;
                                    SengiLabel {
                                        text: app.detail;
                                        font-weight: Tokens.font-weight-regular;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: Tokens.space-sm;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            SengiProgress { percent: app.percent; }
                                        }
                                        SengiText {
                                            text: app.percent + "%";
                                            color: Tokens.color-text-muted;
                                            horizontal-alignment: right;
                                            min-width: Tokens.space-xxl - Tokens.space-md;
                                        }
                                    }
                                }

                                if app.state == RowState.installing && app.percent < 0: HorizontalLayout {
                                    spacing: Tokens.space-sm;
                                    alignment: end;
                                    VerticalLayout {
                                        alignment: center;
                                        Busy { }
                                    }
                                    SengiText {
                                        text: app.detail != "" ? app.detail : "Installing";
                                        color: Tokens.color-text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                if app.state == RowState.installed: VerticalLayout {
                                    alignment: center;
                                    SengiButton {
                                        text: "Open";
                                        primary: Store.current == index;
                                        focusable: false;
                                        clicked => {
                                            Store.current = index;
                                            Store.open(app.id);
                                            field.take-focus();
                                        }
                                    }
                                }

                                if (app.state == RowState.available || app.state == RowState.failed) && !app.unavailable: VerticalLayout {
                                    alignment: center;
                                    SengiButton {
                                        text: app.state == RowState.failed ? "Try again" : "Install";
                                        primary: Store.current == index;
                                        focusable: false;
                                        clicked => {
                                            Store.current = index;
                                            Store.install(app.id);
                                            field.take-focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if Store.rows.length == 0: SengiText {
                    width: parent.width;
                    height: parent.height;
                    text: Store.hint;
                    color: Tokens.color-text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            SengiLabel {
                text: Store.message;
                color: Store.message-is-error ? Tokens.color-danger : Tokens.color-text-muted;
                font-weight: Tokens.font-weight-regular;
                font-size: Tokens.font-size-md;
                height: Tokens.list-row-height;
                vertical-alignment: top;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
    }
}
