// The Sengi OS dock: a centred panel of app icons at the bottom of the screen.

import { Tokens, SengiText, SengiIcon } from "components.slint";
import { DockMenu } from "menu.slint";

export enum DockIcon {
    // The search button, drawn here.
    search,
    // The terminal, drawn here.
    terminal,
    // A bitmap in `image`, already at the size it is drawn.
    image,
    // No icon was found: a tile with the app's initial.
    letter,
}

export struct DockItem {
    name: string,
    icon: DockIcon,
    image: image,
    letter: string,
    running: bool,
    focused: bool,
    windows: int,
    // Clicked to start, and no window yet.
    launching: bool,
    // False while the item slides in or out. The program adds a row with
    // this off and turns it on, and turns it off before removing the row.
    present: bool,
}

component Tile inherits Rectangle {
    width: Tokens.dock-item;
    height: Tokens.dock-item;
    border-radius: Tokens.radius;
}

component SearchIcon inherits Tile {
    background: Tokens.color-bg;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
    SengiIcon {
        name: "magnifying-glass";
        ink: Tokens.color-accent;
        width: Tokens.dock-item / 2;
        height: self.width;
    }
}

component TerminalIcon inherits Tile {
    background: Tokens.color-bg;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
    SengiIcon {
        name: "terminal";
        ink: Tokens.color-accent;
        width: Tokens.dock-item / 2;
        height: self.width;
    }
}

component LetterIcon inherits Tile {
    in property <string> letter;
    background: Tokens.color-surface-raised;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
    SengiText {
        text: root.letter;
        font-size: Tokens.font-size-xl;
        font-weight: Tokens.font-weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The mark under a running app: a dot, which widens into a bar for the app
// that has focus. An app that has been clicked and is still starting gets
// the dot in a muted colour, so the click is seen to have landed.
component Indicator inherits Rectangle {
    in property <bool> running;
    in property <bool> focused;
    in property <bool> launching;

    height: Tokens.dock-dot;
    width: root.focused ? Tokens.space-lg : root.running || root.launching ? Tokens.dock-dot : 0;
    border-radius: self.height / 2;
    background: root.running ? Tokens.color-accent : Tokens.color-text-muted;
    opacity: root.running || root.launching ? 1 : 0;
    animate width, opacity, background {
        duration: Tokens.motion-base;
        easing: Tokens.motion-easing;
    }
}

component Slot inherits Rectangle {
    in property <DockItem> item;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback middle-clicked();
    // A right click.
    callback context();

    // A click with Ctrl or Shift held counts as a middle click.
    property <bool> modified: false;
    // Room above the panel for the icon to jump into while it launches.
    property <length> top: Tokens.dock-bounce;
    property <bool> launching: root.item.launching;
    property <bool> lifted: false;

    // Half the gap on each side of the icon, so two icons are a gap apart.
    width: root.item.present ? Tokens.dock-item + Tokens.dock-gap : 0;
    opacity: root.item.present ? 1 : 0;
    clip: true;
    animate width, opacity {
        duration: Tokens.motion-base;
        easing: Tokens.motion-easing;
    }

    // The icon jumps once when the app is clicked: up for half the bounce
    // time and back down for the other half.
    changed launching => {
        if self.launching {
            root.lifted = true;
            bounce-timer.running = true;
        }
    }

    bounce-timer := Timer {
        interval: Tokens.motion-bounce / 2;
        running: false;
        triggered => {
            root.lifted = false;
            self.running = false;
        }
    }

    // Reaches around the icon and its indicator, so it shows as a clear
    // band even behind an icon that is itself a solid tile.
    Rectangle {
        x: Tokens.dock-gap / 2 - Tokens.space-xs;
        width: Tokens.dock-item + Tokens.space-xs * 2;
        y: root.top + Tokens.space-xxs;
        height: parent.height - root.top - Tokens.space-xxs * 2;
        border-radius: Tokens.radius;
        background: touch.pressed ? Tokens.color-surface-raised
            : touch.has-hover ? Tokens.color-surface-hover : transparent;
        animate background {
            duration: Tokens.motion-fast;
            easing: Tokens.motion-easing;
        }
    }

    icon := Rectangle {
        x: Tokens.dock-gap / 2;
        y: root.top + Tokens.dock-padding - (root.lifted ? Tokens.dock-bounce : 0px);
        width: Tokens.dock-item;
        height: Tokens.dock-item;
        animate y {
            duration: Tokens.motion-bounce / 2;
            easing: Tokens.motion-bounce-easing;
        }

        if root.item.icon == DockIcon.search: SearchIcon { }
        if root.item.icon == DockIcon.terminal: TerminalIcon { }
        if root.item.icon == DockIcon.letter: LetterIcon {
            letter: root.item.letter;
        }
        if root.item.icon == DockIcon.image: Image {
            width: Tokens.dock-item;
            height: Tokens.dock-item;
            source: root.item.image;
        }
    }

    Indicator {
        x: Tokens.dock-gap / 2 + (Tokens.dock-item - self.width) / 2;
        y: root.top + Tokens.dock-padding + Tokens.dock-item + Tokens.dock-dot-gap;
        running: root.item.running;
        focused: root.item.focused;
        launching: root.item.launching;
    }

    touch := TouchArea {
        y: root.top;
        height: parent.height - root.top;
        enabled: root.item.present;
        clicked => {
            if root.modified {
                root.middle-clicked();
            } else {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.modified = event.modifiers.control || event.modifiers.shift;
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.context();
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle
                && self.has-hover {
                root.middle-clicked();
            }
        }
    }
}

// The app's name, shown above the icon the pointer is on.
component NameLabel inherits Rectangle {
    in property <string> text;
    in property <length> limit;

    width: min(label.preferred-width + Tokens.space-sm * 2, root.limit);
    height: Tokens.font-size-sm + Tokens.space-sm * 2;
    border-radius: Tokens.radius;
    border-width: Tokens.border-width;
    border-color: Tokens.color-border;
    background: Tokens.color-surface;

    label := SengiText {
        width: parent.width - Tokens.space-sm * 2;
        text: root.text;
        font-size: Tokens.font-size-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Dock inherits Window {
    // The rows, in dock order. Row indexes are what the callbacks report.
    in property <[DockItem]> items;
    // Whether to show the app's name above the hovered icon, and to have
    // room above the panel for the right-click menu. The room is part of
    // dock-height all the time, not only while hovering or while a menu is
    // open: a
    // surface that grows under the pointer shifts its own coordinates and
    // loses the hover. So with labels on, limit the surface's input region
    // to the panel, or it takes the clicks in a strip above it as well.
    in property <bool> show-labels: true;

    // The size the layer surface should have. The width counts every row,
    // including rows still sliding out, so resize when it changes.
    out property <length> dock-width:
        root.items.length * root.slot-width + root.side-padding * 2;
    out property <length> dock-height: root.panel-height
        + (root.show-labels ? Math.max(root.label-space, root.menu-space) : 0);
    // The panel alone: what to reserve as the exclusive zone, plus the margin.
    // The icons have their padding above and below, and the running dot sits
    // in the room under them.
    out property <length> panel-height: Tokens.dock-padding + Tokens.dock-item + Tokens.dock-dot-gap + Tokens.dock-dot + Tokens.dock-padding;
    // The panel's width at this moment, which moves while rows slide.
    out property <length> panel-width: panel.width;
    // Gap between the panel and the bottom edge of the screen.
    out property <length> bottom-margin: Tokens.dock-margin;
    // Logical size of the bitmaps to put in DockItem.image.
    out property <length> icon-size: Tokens.dock-item;
    // How long a row takes to slide in or out; remove a row this long after
    // turning `present` off.
    out property <duration> slide-duration: Tokens.motion-base;

    // One physical pixel in logical units, which follows the output's scale.
    out property <length> physical-pixel: 1phx;

    // The output's scale changed, so icons need decoding at another size.
    callback rescaled();
    callback clicked(int);
    // Also sent for a click with Ctrl or Shift held.
    callback middle-clicked(int);
    // A right click on a tile; the program fills `menu-rows` and sets
    // `menu-index` to open the menu.
    callback context-clicked(int);
    // A row of the menu was chosen. The program closes the menu.
    callback menu-chosen(int);
    // The menu closed itself because the pointer left it.
    callback menu-closed();

    // The rows of the menu, and the tile it belongs to, or -1 for no menu.
    in property <[string]> menu-rows;
    in-out property <int> menu-index: -1;
    // Where the menu is, for the program to open the surface to it.
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    // The gap between the menu and the panel, which is part of the menu's
    // reach.
    out property <length> menu-gap: Tokens.space-xs;

    // The width one item takes, and the padding at each end of the panel:
    // what decides how many items fit across a screen.
    out property <length> slot-width: Tokens.dock-item + Tokens.dock-gap;
    out property <length> side-padding: Tokens.dock-end-padding - Tokens.dock-gap / 2;
    property <length> label-space: Tokens.font-size-sm + Tokens.space-sm * 2 + Tokens.space-xs;
    // The most rows a menu has: open or start, keep or remove, quit, of
    // which at most two are there at once.
    property <length> menu-space: Tokens.menu-row * 2 + Tokens.menu-padding * 2 + Tokens.space-xs;
    property <length> menu-centre;
    property <bool> menu-near: menu.hovered || bridge.has-hover
        || (root.hovered >= 0 && root.hovered == root.menu-index);
    property <int> hovered: -1;
    property <string> hovered-name;
    property <length> hovered-centre;

    background: transparent;
    default-font-family: Tokens.font-family;
    preferred-width: self.dock-width;
    preferred-height: self.dock-height;

    changed physical-pixel => { root.rescaled(); }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        width: row.preferred-width;
        height: root.panel-height;
        background: Tokens.color-dock;
        border-width: Tokens.border-width;
        border-color: Tokens.color-border;
        border-radius: Tokens.radius;

        row := HorizontalLayout {
            // Taller than the panel by the height of the launch bounce, which
            // reaches above it.
            y: -Tokens.dock-bounce;
            height: root.panel-height + Tokens.dock-bounce;
            padding-left: root.side-padding;
            padding-right: root.side-padding;

            for item[index] in root.items: slot := Slot {
                item: item;
                clicked => { root.clicked(index); }
                middle-clicked => { root.middle-clicked(index); }
                context => {
                    root.menu-centre = panel.x + self.x + self.width / 2;
                    root.context-clicked(index);
                }
                changed hovered => {
                    if self.hovered {
                        root.hovered = index;
                        root.hovered-name = item.name;
                        root.hovered-centre = panel.x + self.x + self.width / 2;
                    } else if root.hovered == index {
                        root.hovered = -1;
                    }
                }
            }
        }
    }

    menu := DockMenu {
        visible: root.menu-index >= 0;
        rows: root.menu-rows;
        x: clamp(root.menu-centre - self.width / 2, 0, root.width - self.width);
        y: root.height - root.panel-height - Tokens.space-xs - self.height;
        chosen(row) => { root.menu-chosen(row); }
    }

    // The gap between the menu and the panel: crossing it is not leaving.
    bridge := TouchArea {
        x: menu.x;
        y: menu.y + menu.height;
        width: menu.width;
        height: Tokens.space-xs;
        enabled: root.menu-index >= 0;
    }

    // The menu goes when the pointer has been away from it and its tile for
    // a moment.
    close-timer := Timer {
        interval: Tokens.motion-base;
        running: false;
        triggered => {
            self.running = false;
            if root.menu-index >= 0 && !root.menu-near {
                root.menu-index = -1;
                root.menu-closed();
            }
        }
    }

    changed menu-near => {
        close-timer.running = root.menu-index >= 0 && !root.menu-near;
    }
    changed menu-index => {
        close-timer.running = root.menu-index >= 0 && !root.menu-near;
    }

    if root.show-labels: NameLabel {
        text: root.hovered-name;
        limit: root.width;
        x: clamp(root.hovered-centre - self.width / 2, 0, root.width - self.width);
        y: 0;
        opacity: root.hovered >= 0 && root.menu-index < 0 ? 1 : 0;
        animate opacity {
            duration: Tokens.motion-fast;
            easing: Tokens.motion-easing;
        }
    }
}
