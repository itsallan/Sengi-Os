// The Sengi OS launcher: a search field over a short list of results.
// Used for both the application search and the menu mode.

import { Tokens, SengiText, SengiSurface } from "components.slint";

// A run of characters in a result name. Matched runs are highlighted.
export struct Segment {
    text: string,
    matched: bool,
}

export struct Row {
    name: [Segment],
    // Shown dimmed at the right edge, e.g. "Web Browser". May be empty.
    detail: string,
    // The name in one piece, for the grid.
    title: string,
    // The app's icon, once it has been decoded.
    icon: image,
    has-icon: bool,
    // What the tile shows until there is an icon, or when there never is.
    letter: string,
}

// An app's picture, or a tile with its first letter where there is none.
component AppIcon inherits Rectangle {
    in property <image> source;
    in property <bool> loaded: false;
    in property <string> letter;

    if root.loaded: Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }

    if !root.loaded: Rectangle {
        width: root.width;
        height: root.height;
        border-radius: Tokens.radius;
        background: Tokens.color-surface-raised;
        border-width: Tokens.border-width;
        border-color: Tokens.color-border;

        SengiText {
            width: parent.width;
            height: parent.height;
            text: root.letter;
            font-weight: Tokens.font-weight-bold;
            font-size: root.width / 2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One row of the menu a right click on an app opens.
component MenuRow inherits Rectangle {
    in property <string> label;
    callback chosen();

    height: Tokens.menu-row;
    border-radius: Tokens.radius;
    background: touch.has-hover ? Tokens.color-accent : transparent;

    SengiText {
        x: Tokens.space-md;
        width: parent.width - Tokens.space-md * 2;
        text: root.label;
        color: touch.has-hover ? Tokens.color-accent-text : Tokens.color-text;
        font-size: Tokens.font-size-md;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
}

component AppMenu inherits SengiSurface {
    in property <[string]> rows;
    callback chosen(int);

    width: Tokens.menu-width / 2;
    height: root.rows.length * Tokens.menu-row + Tokens.menu-padding * 2;

    // Clicks between rows are not clicks on whatever is behind the menu.
    TouchArea { }

    VerticalLayout {
        padding: Tokens.menu-padding;
        for label[index] in root.rows: MenuRow {
            label: label;
            chosen => { root.chosen(index); }
        }
    }
}

// One app in the grid: its icon with its name under it.
component GridCell inherits Rectangle {
    in property <Row> data;
    in property <bool> selected: false;
    callback clicked();
    callback scrolled(length);
    // A right click, with the pointer's place in the window.
    callback context(length, length);

    border-radius: Tokens.radius;
    background: root.selected ? Tokens.color-surface-hover : transparent;

    AppIcon {
        x: (parent.width - self.width) / 2;
        y: Tokens.space-md;
        width: Tokens.launcher-app-icon;
        height: Tokens.launcher-app-icon;
        source: root.data.icon;
        loaded: root.data.has-icon;
        letter: root.data.letter;
    }

    SengiText {
        x: Tokens.space-xs;
        y: Tokens.space-md + Tokens.launcher-app-icon + Tokens.space-sm;
        width: parent.width - Tokens.space-xs * 2;
        text: root.data.title;
        font-size: Tokens.font-size-sm;
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }

    TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            return EventResult.accept;
        }
    }
}

component ResultRow inherits Rectangle {
    in property <Row> data;
    in property <bool> selected: false;
    // Whether the rows of this list carry an icon in front of the name.
    in property <bool> show-icon: false;
    callback clicked();
    callback scrolled(length);
    // A right click, with the pointer's place in the window.
    callback context(length, length);

    border-radius: Tokens.radius;
    background: root.selected ? Tokens.color-surface-hover : transparent;

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        spacing: Tokens.space-lg;

        if root.show-icon: Rectangle {
            horizontal-stretch: 0;
            width: Tokens.launcher-row-icon;

            AppIcon {
                y: (parent.height - self.height) / 2;
                width: Tokens.launcher-row-icon;
                height: Tokens.launcher-row-icon;
                source: root.data.icon;
                loaded: root.data.has-icon;
                letter: root.data.letter;
            }
        }

        // A name too long for the row is cut off and ends in an ellipsis.
        // It is drawn in pieces, so the text cannot elide itself.
        name-box := Rectangle {
            horizontal-stretch: 1;
            min-width: 0;
            clip: true;

            name-run := HorizontalLayout {
                x: 0;
                width: self.preferred-width;
                for segment in root.data.name: SengiText {
                    text: segment.text;
                    color: !segment.matched ? Tokens.color-text
                        : root.selected ? Tokens.color-accent-hover : Tokens.color-accent;
                    font-size: Tokens.font-size-lg;
                    vertical-alignment: center;
                }
            }

            if name-run.preferred-width > name-box.width: Rectangle {
                x: parent.width - self.width;
                width: ellipsis.preferred-width + Tokens.space-xxs;
                background: root.selected ? Tokens.color-surface-hover : Tokens.color-surface;

                ellipsis := SengiText {
                    x: Tokens.space-xxs;
                    height: parent.height;
                    text: "\u{2026}";
                    font-size: Tokens.font-size-lg;
                    vertical-alignment: center;
                }
            }
        }

        if root.data.detail != "": SengiText {
            horizontal-stretch: 0;
            max-width: root.width / 3;
            text: root.data.detail;
            color: Tokens.color-text-muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            return EventResult.accept;
        }
    }
}

export component LauncherWindow inherits Window {
    // Label in front of the search field. May be empty.
    in property <string> prompt: "Search";
    // What has been typed. Set it to start with text already in the field.
    in-out property <string> query <=> input.text;
    // The rows on screen; never more than max-lines of them.
    in property <[Row]> rows;
    // Index into rows of the highlighted one.
    in property <int> selected: 0;
    // All results, and which of them is the first of rows. Only used to draw
    // the scroll position when there are more results than rows.
    in property <int> total-rows: 0;
    in property <int> first-row: 0;
    in property <int> max-lines: Tokens.launcher-lines;
    // The length of a full list, for the program to size shorter ones by.
    out property <int> full-lines: Tokens.launcher-lines;
    in property <string> empty-text: "No results";
    // Why the last choice could not be carried out. Shown under the list.
    in property <string> error;
    // The narrow menu width, for menus with a few short lines.
    in property <bool> compact: false;
    // The rows are the apps laid out in a grid of icons with names, as shown
    // before anything is typed. Otherwise they are a list.
    in property <bool> grid: false;
    // The application search can show a grid, a menu cannot.
    in property <bool> grid-capable: false;
    // Whether list rows carry an icon in front of the name.
    in property <bool> icons: false;
    out property <int> columns: Tokens.launcher-grid-columns;
    out property <int> grid-rows: Tokens.launcher-grid-rows;
    // The size icons are wanted at, in pixels.
    out property <float> app-icon-px: Tokens.launcher-app-icon / 1px;

    // The window covers the whole output and is see-through around the
    // panel. The panel starts where the taller of a full list and a full
    // grid would be centred, so the search field stays put while what is
    // under it grows, shrinks and changes between the two, and a click
    // anywhere else lands on the window and closes it.
    out property <length> panel-width: root.compact ? Tokens.menu-width : Tokens.launcher-width;
    out property <length> full-height: root.grid-capable
        ? Math.max(root.height-for(root.max-lines), root.grid-height-for(root.grid-rows))
        : root.height-for(root.max-lines);
    out property <length> panel-height: (root.grid
        ? root.grid-height-for(root.grid-lines)
        : root.height-for(root.shown-lines)) + (root.error != "" ? root.row-height : 0);

    // The menu a right click on an app opens: its rows, and the row of the
    // list or grid it is on, or -1 for none.
    in property <[string]> menu-rows;
    in-out property <int> menu-row: -1;
    // A row of the menu was chosen, by index into menu-rows.
    callback menu-chosen(int);
    // The app on this row of the list or grid was right-clicked, or the
    // menu key was pressed on it. The program fills in menu-rows.
    callback context-requested(int);

    callback query-edited(string);
    // Move the highlight by this many rows; negative is up.
    callback move-selection(int);
    // Return was pressed on the highlighted row.
    callback accept();
    // A row was clicked, by index into rows.
    callback row-clicked(int);
    callback dismiss();

    public function focus-search() {
        input.focus();
    }

    private property <length> field-height: Tokens.font-size-lg + Tokens.space-lg * 2;
    private property <length> row-height: Tokens.font-size-lg + Tokens.space-sm * 2;
    private property <int> shown-lines: Math.clamp(root.rows.length, 1, root.max-lines);
    // Rows of the grid on screen: as many as the apps shown need, up to the
    // most the token allows.
    private property <int> grid-lines: Math.clamp(Math.ceil(root.rows.length / root.columns), 1, root.grid-rows);
    private property <length> list-top: root.field-height + Tokens.border-width + Tokens.space-sm;

    // Touchpad scrolling that has not yet added up to a row.
    private property <length> scroll-rest;

    // What one step of scrolling is: a list row, or a row of the grid.
    private property <length> step-height: root.grid ? Tokens.launcher-cell-height : root.row-height;
    private property <int> step: root.grid ? root.columns : 1;

    // Scrolling moves the highlight: one row for a notch of a wheel, and one
    // row for each row's height of touchpad travel.
    function wheel(delta: length) {
        if delta >= root.step-height || delta <= -root.step-height {
            root.scroll-rest = 0;
            root.move-selection(delta < 0 ? root.step : -root.step);
        } else {
            root.scroll-rest += delta;
            if root.scroll-rest >= root.step-height || root.scroll-rest <= -root.step-height {
                root.move-selection(root.scroll-rest < 0 ? root.step : -root.step);
                root.scroll-rest = 0;
            }
        }
    }

    private property <length> menu-x;
    private property <length> menu-y;
    private property <length> panel-x: (root.width - root.panel-width) / 2;
    private property <length> panel-y: (root.height - root.full-height) / 2;

    function open-context(row: int, x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        root.context-requested(row);
    }

    // The menu key: the menu goes by the highlighted app.
    function open-context-on-selected() {
        if root.selected < 0 {
            return;
        }
        if root.grid {
            root.open-context(root.selected,
                root.panel-x + Tokens.space-sm + (Math.mod(root.selected, root.columns) + 0.5) * Tokens.launcher-cell-width,
                root.panel-y + root.list-top + (Math.floor(root.selected / root.columns) + 0.5) * Tokens.launcher-cell-height);
        } else {
            root.open-context(root.selected,
                root.panel-x + Tokens.space-sm + Tokens.space-md,
                root.panel-y + root.list-top + (root.selected + 0.5) * root.row-height);
        }
    }

    pure function height-for(lines: int) -> length {
        root.list-top + lines * root.row-height + Tokens.space-sm
    }

    pure function grid-height-for(lines: int) -> length {
        root.list-top + lines * Tokens.launcher-cell-height + Tokens.space-sm
    }

    title: "Sengi OS launcher";
    no-frame: true;
    background: transparent;
    default-font-family: Tokens.font-family;
    preferred-width: root.panel-width;
    preferred-height: root.full-height;
    forward-focus: input;

    // A click outside the panel closes it.
    TouchArea {
        clicked => { root.dismiss(); }
    }

    SengiSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - root.full-height) / 2;
        width: root.panel-width;
        height: root.panel-height;

        TouchArea {
            clicked => { input.focus(); }
            scroll-event(event) => {
                root.wheel(event.delta-y);
                return EventResult.accept;
            }
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.field-height;
            padding-left: Tokens.space-sm + Tokens.space-md;
            padding-right: Tokens.space-sm + Tokens.space-md;
            spacing: Tokens.space-sm;

            if root.prompt != "": SengiText {
                horizontal-stretch: 0;
                text: root.prompt;
                color: Tokens.color-text-muted;
                font-size: Tokens.font-size-lg;
                vertical-alignment: center;
            }

            input := TextInput {
                horizontal-stretch: 1;
                single-line: true;
                color: Tokens.color-text;
                font-family: Tokens.font-family;
                font-size: Tokens.font-size-lg;
                vertical-alignment: center;
                selection-background-color: Tokens.color-accent;
                selection-foreground-color: Tokens.color-accent-text;
                text-cursor-width: Tokens.space-xxs;

                edited => { root.query-edited(self.text); }

                // Focus only leaves when the window loses the keyboard, and a
                // launcher nobody can type into has no business staying open.
                changed has-focus => {
                    if !self.has-focus {
                        root.dismiss();
                    }
                }

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        // The menu first, then the panel.
                        if root.menu-row >= 0 {
                            root.menu-row = -1;
                        } else {
                            root.dismiss();
                        }
                    } else if event.text == Key.Menu {
                        root.open-context-on-selected();
                    } else if event.text == Key.Return {
                        root.accept();
                    } else if root.grid && event.text == Key.LeftArrow {
                        root.move-selection(-1);
                    } else if root.grid && event.text == Key.RightArrow {
                        root.move-selection(1);
                    } else if root.grid && event.text == Key.UpArrow {
                        root.move-selection(-root.columns);
                    } else if root.grid && event.text == Key.DownArrow {
                        root.move-selection(root.columns);
                    } else if event.text == Key.UpArrow || event.text == Key.Backtab
                        || (event.text == Key.Tab && event.modifiers.shift)
                        || (event.modifiers.control && event.text == "p") {
                        root.move-selection(-1);
                    } else if event.text == Key.DownArrow || event.text == Key.Tab
                        || (event.modifiers.control && event.text == "n") {
                        root.move-selection(1);
                    } else if event.text == Key.PageUp {
                        root.move-selection(root.grid ? -root.columns * root.grid-rows : -root.max-lines);
                    } else if event.text == Key.PageDown {
                        root.move-selection(root.grid ? root.columns * root.grid-rows : root.max-lines);
                    } else {
                        return EventResult.reject;
                    }
                    return EventResult.accept;
                }
            }
        }

        Rectangle {
            x: Tokens.border-width;
            y: root.field-height;
            width: parent.width - Tokens.border-width * 2;
            height: Tokens.border-width;
            background: Tokens.color-border;
        }

        // Scroll position, in the gutter right of the rows.
        if !root.grid && root.total-rows > root.rows.length && root.rows.length > 0: Rectangle {
            property <length> track: root.rows.length * root.row-height;
            x: parent.width - Tokens.space-sm + Tokens.space-xxs;
            y: root.list-top + self.track * root.first-row / root.total-rows;
            width: Tokens.space-xxs;
            height: self.track * root.rows.length / root.total-rows;
            border-radius: Tokens.radius;
            background: Tokens.color-border;
        }

        if root.grid: Rectangle {
            x: Tokens.space-sm;
            y: root.list-top;
            width: parent.width - Tokens.space-sm * 2;
            height: root.grid-lines * Tokens.launcher-cell-height;
            clip: true;

            for row[index] in root.rows: GridCell {
                x: Math.mod(index, root.columns) * Tokens.launcher-cell-width;
                y: Math.floor(index / root.columns) * Tokens.launcher-cell-height;
                width: Tokens.launcher-cell-width;
                height: Tokens.launcher-cell-height;
                data: row;
                selected: index == root.selected;
                clicked => { root.row-clicked(index); }
                context(x, y) => { root.open-context(index, x, y); }
                scrolled(delta) => { root.wheel(delta); }
            }
        }

        if !root.grid: Rectangle {
            x: Tokens.space-sm;
            y: root.list-top;
            width: parent.width - Tokens.space-sm * 2;
            height: root.shown-lines * root.row-height;
            clip: true;

            for row[index] in root.rows: ResultRow {
                x: 0;
                y: index * root.row-height;
                width: parent.width;
                height: root.row-height;
                data: row;
                show-icon: root.icons;
                selected: index == root.selected;
                clicked => { root.row-clicked(index); }
                context(x, y) => { root.open-context(index, x, y); }
                scrolled(delta) => { root.wheel(delta); }
            }

            if root.rows.length == 0: SengiText {
                x: Tokens.space-md;
                y: 0;
                height: root.row-height;
                text: root.empty-text;
                color: Tokens.color-text-muted;
                font-size: Tokens.font-size-lg;
                vertical-alignment: center;
            }
        }

        if root.error != "": SengiText {
            x: Tokens.space-sm + Tokens.space-md;
            y: root.list-top + (root.grid
                ? root.grid-lines * Tokens.launcher-cell-height
                : root.shown-lines * root.row-height);
            width: parent.width - self.x * 2;
            height: root.row-height;
            text: root.error;
            color: Tokens.color-danger;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // A click anywhere else closes the menu and nothing more.
    if root.menu-row >= 0 && root.menu-rows.length > 0: TouchArea {
        clicked => { root.menu-row = -1; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu-row = -1;
            }
        }
    }

    if root.menu-row >= 0 && root.menu-rows.length > 0: AppMenu {
        x: clamp(root.menu-x, 0, root.width - self.width);
        y: clamp(root.menu-y, 0, root.height - self.height);
        rows: root.menu-rows;
        chosen(row) => { root.menu-chosen(row); }
    }
}
