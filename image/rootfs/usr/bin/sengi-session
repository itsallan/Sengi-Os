#!/bin/sh
# Start the Sengi OS desktop session.
export XDG_CURRENT_DESKTOP=sengi:wlroots
export XDG_SESSION_DESKTOP=sengi
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1

# The preview boot entry asks for our own compositor with a word on the
# kernel command line. It is run as a child so that a preview that cannot
# start falls back to labwc below, once, instead of leaving a black screen.
preview() {
	read -r up _ </proc/uptime
	started=${up%.*}
	systemd-cat -t sengi-compositor \
		sengi-compositor --backend drm --locker '/usr/bin/swaylock -f' \
		-s 'LABWC_PID=$SENGI_COMPOSITOR_PID sh /etc/xdg/labwc/autostart' &
	pid=$!
	# greetd ends the session by signalling this shell. The signal cuts the
	# wait short, so wait once more for the compositor to shut down.
	stopping=0
	trap 'stopping=1; kill -TERM "$pid" 2>/dev/null' TERM HUP INT
	status=0
	wait "$pid" || status=$?
	if [ "$stopping" = 1 ]; then
		status=0
		wait "$pid" || status=$?
	fi
	trap - TERM HUP INT
	read -r up _ </proc/uptime
	lasted=$((${up%.*} - started))
	if [ "$status" -eq 0 ] || [ "$lasted" -ge 10 ]; then
		exit "$status"
	fi
	echo "sengi-compositor gave up after $lasted s with status $status, starting labwc instead" |
		systemd-cat -t sengi-session -p warning
}

read -r cmdline <"${SENGI_CMDLINE:-/proc/cmdline}"
case " $cmdline " in
*" sengi.compositor=own "*) preview ;;
esac

# On a display with no GPU acceleration (plain VMs, firmware framebuffers)
# Mesa would fall back to llvmpipe, which is slower than wlroots' own
# software renderer and drags LLVM into the compositor.
if [ -z "${WLR_RENDERER:-}" ]; then
	hw=0
	for drv in /sys/class/drm/card[0-9]*/device/driver; do
		case $(basename "$(readlink -f "$drv")") in
		bochs-drm | simple-framebuffer | simpledrm | virtio-pci | virtio_gpu | "") ;;
		*) hw=1 ;;
		esac
	done
	[ $hw = 1 ] || export WLR_RENDERER=pixman
fi

exec labwc
