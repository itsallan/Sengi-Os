# The programs of the desktop session, started once its compositor is
# up: by labwc from its autostart file, by sengi-compositor from
# sengi-session. Each tells the programs it starts its own process number.
compositor=${SENGI_COMPOSITOR_PID:-${LABWC_PID:-}}
# Services the user manager starts on demand, such as notifications, need to
# know where the compositor is. This has to finish before anything can ask
# for them, so it is not run in the background. TZ is there when a time
# zone was chosen in Settings, so that those services tell the same time.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP TZ >/dev/null 2>&1
# The wallpaper is swaybg, with the picture chosen in Settings if there is one.
. /usr/lib/sengi-os/wallpaper.sh
# In the background: it waits a second to see the picture took.
sengi_wallpaper_apply >/dev/null 2>&1 &
# Bring the bar, dock and desktop back if any ever dies, for as long as this
# compositor is running. Watching the compositor's own process, not its
# socket, keeps a loop left over from a crashed session from joining the
# next one. A program that keeps dying is retried more and more slowly, and
# what it prints goes to the journal. The desktop is the icons of ~/Desktop
# and its menu, on a layer between the wallpaper and the windows.
for program in sengi-bar sengi-dock sengi-desktop; do
	(
		wait=1
		while kill -0 "$compositor" 2>/dev/null; do
			started=$(date +%s)
			systemd-cat -t "$program" "$program"
			# Ran for a while before dying: start over quickly.
			if [ $(($(date +%s) - started)) -gt 60 ]; then
				wait=1
			fi
			sleep "$wait"
			if [ "$wait" -lt 30 ]; then
				wait=$((wait * 2))
			fi
		done
	) >/dev/null 2>&1 &
done
sengi-focus >/dev/null 2>&1 &
# When the screen dims, goes off and locks are the user's to set, in
# Settings. sengi-compositor keeps those times itself, with timers that
# only wake it when something is due, and has the screen locked before
# the computer sleeps through /usr/lib/systemd/system-sleep. Only labwc,
# the fallback, needs swayidle: "sengi-lock -f" returns once every output
# is covered, and swayidle waits for that (-w) before it lets the machine
# go to sleep. swayidle cannot be given new times while it runs, so
# Settings ends the one that carries the mark below and this loop starts
# another with the times as they are now. Anything that is not a number,
# such as no answer at all, gets the default.
if [ -z "${SENGI_COMPOSITOR_PID:-}" ]; then
(
	wait=1
	while kill -0 "$compositor" 2>/dev/null; do
		blank=$(sengi-settings --get power.blank-after 2>/dev/null)
		lock=$(sengi-settings --get power.lock-after 2>/dev/null)
		on_sleep=$(sengi-settings --get power.lock-on-sleep 2>/dev/null)
		case $blank in '' | *[!0-9]* | ??????*) blank=300 ;; esac
		case $lock in '' | *[!0-9]* | ??????*) lock=@{timing.idle-lock} ;; esac
		set --
		if [ "$blank" -gt 0 ]; then
			set -- "$@" timeout "$blank" 'sengi-settings --screen off' \
				resume 'sengi-settings --screen on'
		fi
		if [ "$lock" -gt 0 ]; then
			set -- "$@" timeout "$lock" 'sengi-lock -f'
		fi
		if [ "$on_sleep" != false ]; then
			set -- "$@" before-sleep 'sengi-lock -f'
		fi
		started=$(date +%s)
		if SENGI_IDLE_SUPERVISED=1 systemd-cat -t swayidle swayidle -w "$@"; then
			# Ended on purpose, by Settings: no reason to slow down.
			wait=1
		elif [ $(($(date +%s) - started)) -gt 60 ]; then
			wait=1
		fi
		sleep "$wait"
		if [ "$wait" -lt 30 ]; then
			wait=$((wait * 2))
		fi
	done
) >/dev/null 2>&1 &
fi

# The welcome, once, on the first login of an installed system: never on the
# live image, whose kernel line has boot=sengi, and not again once it was
# seen or skipped. It waits for the desktop to come up and runs at the lowest
# priority. Nothing stays behind: the waiting shell ends with the program.
welcome_state=${XDG_STATE_HOME:-$HOME/.local/state}
welcome_live=
case " $(cat /proc/cmdline 2>/dev/null) " in *" boot=sengi "*) welcome_live=1 ;; esac
if [ -z "$welcome_live" ] && [ ! -e "$welcome_state/sengi-os/welcome-done" ]; then
	(
		sleep 3
		nice -n 19 sengi-run sengi-welcome --first-run
	) >/dev/null 2>&1 &
fi
unset welcome_state welcome_live
