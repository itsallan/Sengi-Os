<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Sengi OS</vendor>
  <vendor_url>https://github.com/itsallan/Sengi-Os</vendor_url>

  <!-- Settings, Updates runs sengi-update through pkexec. The helper takes
       one word (check, apply or status) and runs apt-get with options of
       its own; it takes no package names. Only the person at the keyboard
       of a local session may ask, and has to sign in; the answer is kept
       for a few minutes so that a second update does not ask again. -->
  <action id="org.sengi.os.update">
    <description>Update the system software</description>
    <message>Authentication is required to update the system software</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/sengi-update</annotate>
  </action>
</policyconfig>
