<svg xmlns="http://www.w3.org/2000/svg" width="@{size.dock-icon}" height="@{size.dock-icon}" viewBox="0 0 40 40">
  <!-- Settings: three sliders on the same tile the dock draws its own
       icons on. The glyph is on a 20 unit grid at twice the size, so the
       line is twice the bar's icon line, as the dock's is. -->
  <rect x="0.5" y="0.5" width="39" height="39" rx="@{radius.base}" fill="@{color.bg}" stroke="@{color.border}" stroke-width="@{border.width}"/>
  <g transform="scale(2)" fill="@{color.bg}" stroke-width="@{border.icon-stroke}" stroke-linecap="round">
    <path d="M5 6h10M5 10h10M5 14h10" stroke="@{color.text}"/>
    <g stroke="@{color.accent}">
      <circle cx="12" cy="6" r="1.75"/>
      <circle cx="7.5" cy="10" r="1.75"/>
      <circle cx="13" cy="14" r="1.75"/>
    </g>
  </g>
</svg>
