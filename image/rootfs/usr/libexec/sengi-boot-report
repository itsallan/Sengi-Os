#!/bin/sh
# Used by the QEMU boot test. Waits for the desktop, then writes the time it
# took and the idle memory use to the serial port.
port=/dev/ttyS0

# desktop_is_up, session_compositor, may_power_off and pss_kb, which the
# install test's report uses too.
. /usr/lib/sengi-os/report.sh

until desktop_is_up; do
	sleep 0.1
done
read -r up _ </proc/uptime
echo "SENGI-BOOT desktop_s=$up" >$port
# Whichever compositor the session came up on. The test knows which one
# it asked for.
compositor=$(session_compositor)

used_mb() {
	awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2}
		END {printf "%d\n", (t - a) / 1024}' /proc/meminfo
}
# The live image asks, a few seconds after the desktop is up, whether to
# install Sengi OS or try it first. Memory is measured twice: with the
# question on screen, left alone, and again once the test has chosen to try
# it first and the desktop has settled, which is the idle desktop.
n=0
until pidof sengi-welcome >/dev/null || [ $n -ge 150 ]; do
	n=$((n + 1))
	sleep 0.2
done
sleep "${SENGI_IDLE_WAIT:-30}"
asking=$(pidof -s sengi-welcome)
if [ -n "$asking" ]; then
	said=$(tr '\0' ' ' <"/proc/$asking/cmdline")
	case $said in
	*" --live "*) ;;
	*) echo "SENGI-FAIL sengi-welcome runs on the live image, but not to ask: $said" >$port ;;
	esac
	echo "SENGI-DIALOG up ram_mb=$(used_mb) pss_kb=$(pss_kb "$asking")" >$port
	n=0
	while pidof sengi-welcome >/dev/null && [ $n -lt 600 ]; do
		n=$((n + 1))
		sleep 0.2
	done
	if pidof sengi-welcome >/dev/null; then
		echo "SENGI-FAIL the live question did not close when it was answered" >$port
	else
		echo "SENGI-DIALOG gone" >$port
	fi
	if pidof sengi-installer >/dev/null; then
		echo "SENGI-FAIL choosing to try it first started the installer" >$port
	fi
	# Asking must leave nothing resident behind, the desktop portal an
	# ordinary window would start included. The kernel keeps fifteen
	# letters of a program's name.
	if pgrep -u live -x xdg-desktop-por >/dev/null || pgrep -u live -x xdg-document-po >/dev/null; then
		echo "SENGI-FAIL the live question started the desktop portal, which stays" >$port
	fi
	[ -s /home/live/.local/state/sengi-os/live-asked ] ||
		echo "SENGI-FAIL the live question was not noted as asked" >$port
else
	echo "SENGI-FAIL the live image did not ask whether to install or try first" >$port
	echo "SENGI-DIALOG missing" >$port
fi
sleep "${SENGI_SETTLE_WAIT:-15}"
echo "SENGI-IDLE ram_mb=$(used_mb)" >$port
# polkit answers logind's questions and is started by the first of them,
# which comes when the session starts: swayidle asks logind to hold off
# sleep until the screen is locked. So it is running by now, and what it
# costs is reported further down. What it must not be is started at boot
# by anything but a question.
polkit_state=$(systemctl is-enabled polkit.service 2>&1)
polkit_wanted=$(systemctl show polkit.service -p WantedBy -p RequiredBy --value | tr -d '\n')
if [ "$polkit_state" != static ] || [ -n "$polkit_wanted" ]; then
	echo "SENGI-FAIL polkit.service is started at boot ($polkit_state, wanted by '$polkit_wanted'), not on demand" >$port
fi
# Files opens USB sticks through udisksctl. udisksd is started by the bus on
# the first request, as polkit is, and must not be started at boot: it would
# cost memory on every machine for the sake of the few that have a stick.
if [ -e /usr/lib/systemd/system/udisks2.service ]; then
	udisks_state=$(systemctl is-enabled udisks2.service 2>&1)
	case $udisks_state in
	disabled | static | masked) ;;
	*) echo "SENGI-FAIL udisks2.service is enabled at boot ($udisks_state), not on demand" >$port ;;
	esac
	if systemctl is-active --quiet udisks2.service; then
		echo "SENGI-FAIL udisks2.service is running with no drive opened" >$port
	fi
	# polkit lets the person at the screen open a drive with no password
	# only when logind counts the session as active and local; said here so
	# that a session that is not shows up before a person meets it.
	session=$(loginctl list-sessions --no-legend | awk '$3 == "live" && $4 == "seat0" {print $1; exit}')
	echo "SENGI-INFO udisks2: enabled=$udisks_state active=$(systemctl is-active udisks2.service) session=${session:-none} Active=$(loginctl show-session "$session" -p Active --value 2>&1) Remote=$(loginctl show-session "$session" -p Remote --value 2>&1)" >$port
fi
{
	# When each piece of the desktop was started, in seconds since boot,
	# beside the desktop marker above, and when polkit was called for.
	for prog in "$compositor" sengi-bar sengi-dock swayidle polkitd; do
		pid=$(pidof -s "$prog") &&
			awk -v prog="$prog" '{printf "started at %.2f s: %s\n", $22 / 100, prog}' "/proc/$pid/stat"
	done
	journalctl -b --no-pager -o short-monotonic 2>&1 | grep -m4 -E 'PolicyKit1|polkit\.service'
	systemd-analyze time 2>&1
	systemd-analyze blame 2>&1 | head -15
	systemd-analyze critical-chain greetd.service 2>&1 | head -12
	ps -eo rss,comm --sort=-rss | head -32
	systemctl --failed --no-legend 2>&1
	grep -E '^(MemTotal|MemFree|MemAvailable|Shmem|Slab|SReclaimable|SUnreclaim|Cached|AnonPages|Mapped|Unevictable|Percpu):' /proc/meminfo
	journalctl -b --no-pager 2>&1 | grep -i -m6 'portal'
	ls -l /sys/class/drm/*/device/driver 2>&1 | sed 's/.*-> //' | sort -u
	echo "compositor: $compositor"
	echo "$compositor llvm maps: $(grep -c -i llvm "/proc/$(pidof "$compositor")/maps")"
	journalctl -b --no-pager -o cat -t sengi-session -t sengi-compositor 2>&1 | head -12
	df -h / /run /tmp 2>&1
} | sed 's/^/SENGI-INFO /' >$port
# Extra diagnostics can be asked for from the host without rebuilding:
#   -smbios type=11,value=io.systemd.credential:sengi.test.debug=COMMANDS
debug=/run/credentials/@system/sengi.test.debug
if [ -r "$debug" ]; then
	sh "$debug" 2>&1 | sed 's/^/SENGI-DEBUG /' >$port
fi

# A desktop that came up and then lost a piece is a failed boot.
# sengi-compositor keeps the idle times itself; only labwc needs swayidle.
idler=swayidle
[ "$compositor" = sengi-compositor ] && idler=
# shellcheck disable=SC2086
for prog in "$compositor" sengi-bar sengi-dock $idler swaybg sengi-focus; do
	pidof "$prog" >/dev/null || echo "SENGI-FAIL $prog is not running" >$port
done
# Settings is a program that is started and goes away again. One that is
# here now, with nobody having opened it, was left behind by the session.
if pidof sengi-settings >/dev/null; then
	echo "SENGI-FAIL sengi-settings is running with nothing open" >$port
fi
# The lock screen is our own. Nothing may be left of the one it replaced,
# and without its PAM service it would refuse to lock.
if command -v swaylock >/dev/null 2>&1 || [ -e /etc/swaylock ] || [ -e /etc/pam.d/swaylock ]; then
	echo "SENGI-FAIL swaylock is still in the image" >$port
fi
[ -x /usr/bin/sengi-lock ] || echo "SENGI-FAIL sengi-lock is not in the image" >$port
# PAM checks a user's own password through this helper, which reads
# /etc/shadow by being in its group.
if ! [ -g /usr/sbin/unix_chkpwd ] || [ "$(stat -c %G /etc/shadow)" != shadow ]; then
	echo "SENGI-FAIL unix_chkpwd cannot read /etc/shadow, so no password can be checked" >$port
fi
[ -u /usr/bin/sudo ] || echo "SENGI-FAIL sudo has lost its setuid bit" >$port
[ -f /etc/pam.d/sengi-lock ] || echo "SENGI-FAIL sengi-lock has no PAM service" >$port
if pidof sengi-lock >/dev/null; then
	echo "SENGI-FAIL sengi-lock is running on a session nobody locked" >$port
fi
# The session's start-up script asks it for the idle times.
lock_after=$(sengi-settings --get power.lock-after 2>/dev/null)
case $lock_after in
'' | *[!0-9]*) echo "SENGI-FAIL sengi-settings --get power.lock-after gave '$lock_after', not a number" >$port ;;
esac

# The lid and the power button are logind's, set by the image, and the
# screen is locked before the computer sleeps by a hook systemd runs.
# loginctl show does not list these; the merged configuration logind reads
# does, the last assignment of a name winning.
logind_conf=$(systemd-analyze cat-config systemd/logind.conf 2>/dev/null)
for pair in HandleLidSwitch=suspend HandleLidSwitchExternalPower=suspend \
	HandleLidSwitchDocked=ignore HandlePowerKey=suspend HandlePowerKeyLongPress=poweroff; do
	got=$(printf '%s\n' "$logind_conf" | grep "^${pair%%=*}=" | tail -n 1)
	[ "$got" = "$pair" ] || echo "SENGI-FAIL logind config has '$got', not $pair" >$port
done
[ -x /usr/lib/systemd/system-sleep/sengi-lock-on-sleep ] ||
	echo "SENGI-FAIL the lock before sleep is not in the image" >$port

# Restart and Shut down in the session menu go through logind.
may_power_off live
# shellcheck disable=SC2046
echo "SENGI-POLKIT pss_kb=$(pss_kb $(pidof polkitd))" >$port

# Sound, on the card the test gives the guest. This comes after the idle
# figure: playing starts things that are not resident before.
default_sink() {
	as_live wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
		sed -n 's/.*node\.name = "\(.*\)"/\1/p'
}
sink=
n=0
while [ $n -lt 50 ]; do
	sink=$(default_sink)
	case $sink in
	'' | auto_null) ;;
	*) break ;;
	esac
	sleep 0.2
	n=$((n + 1))
done
case $sink in
'' | auto_null) echo "SENGI-FAIL there is no sound output (default sink: ${sink:-none})" >$port ;;
esac
echo "SENGI-INFO sound sink: ${sink:-none}" >$port
LC_ALL=C aplay -l 2>&1 | sed 's/^/SENGI-INFO aplay -l: /' >$port
LC_ALL=C aplay -l 2>/dev/null | grep -q '^card ' ||
	echo "SENGI-FAIL aplay -l lists no sound card" >$port
as_live wpctl status 2>/dev/null | sed -n '/^Audio/,/^Video/s/^/SENGI-INFO wpctl: /p' >$port
# Most programs speak to the PulseAudio server. It has to be listening, not
# running, and start when something connects.
pulse() {
	as_live systemctl --user is-active pipewire-pulse.socket pipewire-pulse.service |
		tr '\n' ' '
}
idle_pulse=$(pulse)
[ "$idle_pulse" = "active inactive " ] ||
	echo "SENGI-FAIL pipewire-pulse socket and service are '$idle_pulse' at idle, not 'active inactive '" >$port
as_live logger --socket /run/user/1000/pulse/native boot-test >/dev/null 2>&1
n=0
while [ "$(pulse)" != "active active " ] && [ $n -lt 25 ]; do
	sleep 0.2
	n=$((n + 1))
done
[ "$(pulse)" = "active active " ] ||
	echo "SENGI-FAIL connecting to the PulseAudio socket did not start pipewire-pulse ($(pulse))" >$port
# A second of square wave at $1 Hz, which has to divide 24000, as a WAV file
# of 48 kHz stereo.
tone() {
	high=
	low=
	i=0
	while [ $i -lt $((24000 / $1)) ]; do
		high="$high\\000\\040\\000\\040"
		low="$low\\000\\340\\000\\340"
		i=$((i + 1))
	done
	printf 'RIFF\044\356\002\000WAVEfmt \020\000\000\000\001\000\002\000\200\273\000\000\000\356\002\000\004\000\020\000data\000\356\002\000'
	i=0
	while [ $i -lt "$1" ]; do
		# shellcheck disable=SC2059
		printf "$high$low"
		i=$((i + 1))
	done
}
# Two ways in, told apart by the test by their pitch: PipeWire's own, and
# ALSA's default device, which has to lead to PipeWire too.
tone 400 >/run/sengi-tone-400.wav
tone 1000 >/run/sengi-tone-1000.wav
chmod 0644 /run/sengi-tone-400.wav /run/sengi-tone-1000.wav
said=$(as_live timeout 10 pw-play /run/sengi-tone-400.wav 2>&1) ||
	echo "SENGI-FAIL pw-play could not play: $(echo "$said" | tail -n 1)" >$port
sleep 1
said=$(as_live env LC_ALL=C timeout 10 aplay -v /run/sengi-tone-1000.wav 2>&1) ||
	echo "SENGI-FAIL aplay could not play: $(echo "$said" | tail -n 1)" >$port
echo "$said" | grep -q 'PipeWire' ||
	echo "SENGI-FAIL ALSA's default device is not PipeWire" >$port
rm -f /run/sengi-tone-400.wav /run/sengi-tone-1000.wav
# The volume up key, which the test presses now.
level() {
	as_live wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null
}
before=$(level)
after=$before
echo "SENGI-SOUND keys ready" >$port
n=0
while [ "$after" = "$before" ] && [ $n -lt 75 ]; do
	sleep 0.2
	after=$(level)
	n=$((n + 1))
done
echo "SENGI-INFO volume up key: '$before' then '$after'" >$port
[ "$after" != "$before" ] ||
	echo "SENGI-FAIL the volume up key did not change the volume ($before)" >$port
as_live wpctl set-volume @DEFAULT_AUDIO_SINK@ "${before#Volume: }" >/dev/null 2>&1
# The Bluetooth side of sound must be there, and cost nothing on a machine
# with no adapter.
if journalctl -b --no-pager -o cat | grep -q 'BlueZ SPA plugin is missing'; then
	echo "SENGI-FAIL PipeWire cannot do Bluetooth audio" >$port
fi
if pidof bluetoothd >/dev/null; then
	echo "SENGI-FAIL bluetoothd is running with no Bluetooth adapter" >$port
fi
# The bar looks at the volume four times a minute: let it see the old one
# again before the test starts comparing screens.
sleep 16
echo "SENGI-DONE" >$port

# The boot test goes on to open Settings and close it, and then to lock
# the screen and unlock it. Say when each one's process is there and when
# it has gone again, then stop watching.
watch() {
	seen=0
	n=0
	while [ $n -lt 900 ]; do
		if pidof "$1" >/dev/null; then
			[ $seen = 1 ] || echo "$2 running" >$port
			seen=1
		elif [ $seen = 1 ]; then
			echo "$2 gone" >$port
			break
		fi
		sleep 0.2
		n=$((n + 1))
	done
}
watch sengi-settings SENGI-SETTINGS
# The test types a wrong password first. Say when PAM has turned it down,
# so the test need not guess how long that takes.
journalctl -f -n 0 -o cat -t sengi-lock 2>/dev/null | while IFS= read -r line; do
	case $line in
	*'authentication failure'*) echo "SENGI-LOCK refused" >$port ;;
	esac
done &
watch sengi-lock SENGI-LOCK

# The lock once more, asked for the way the idle timer, the session menu
# and quick settings ask: by running sengi-lock. Under sengi-compositor
# that passes the request on to the compositor, which is asked afterwards
# what it holds. The test has to have seen the desktop back first. Then
# it types the password, and this waits for the lock screen to go.
sleep 6
as_live sengi-lock -f
status=$?
held=
if [ "$compositor" = sengi-compositor ]; then
	# Only what the compositor says after this request is its answer: an
	# older report of the session would look the same.
	before=$(journalctl -b --no-pager -o cat -t sengi-compositor | grep -c 'session ')
	kill -USR1 "$(session_compositor_pid)"
	sleep 0.5
	held=$(journalctl -b --no-pager -o cat -t sengi-compositor | grep 'session ' |
		tail -n +"$((before + 1))" | tail -n 1 | sed 's/.*session /session /')
fi
echo "SENGI-FORWARD exit=$status $held" >$port
n=0
while pidof sengi-lock >/dev/null && [ $n -lt 300 ]; do
	sleep 0.2
	n=$((n + 1))
done
if pidof sengi-lock >/dev/null; then
	echo "SENGI-FORWARD still locked" >$port
else
	echo "SENGI-FORWARD unlocked" >$port
fi

# Then three things Settings drives, each changed the way the window
# changes it and without logging out. What came of it is reported as it
# was found; the test knows what to expect of which compositor.
#
# A second keyboard layout and a key to switch to it. The test switches
# and types "touch z" into the terminal: on the German layout that key
# gives a y, and the file's name says which it was.
rm -f /home/live/y /home/live/z
as_live sengi-settings --set keyboard.switch grp:alt_shift_toggle
as_live sengi-settings --set keyboard.layouts us,de
echo "SENGI-KEYBOARD set exit=$?" >$port
typed=nothing
n=0
while [ $n -lt 150 ]; do
	if [ -e /home/live/y ]; then typed=y; break; fi
	if [ -e /home/live/z ]; then typed=z; break; fi
	sleep 0.2
	n=$((n + 1))
done
echo "SENGI-KEYBOARD typed=$typed" >$port
as_live sengi-settings --set keyboard.layouts us
as_live sengi-settings --set keyboard.switch ''
rm -f /home/live/y /home/live/z

# A pointer setting. sengi-compositor says on SIGUSR1 what each device is
# set to, as libinput has it; labwc has no way of being asked.
as_live sengi-settings --set mouse.natural-scroll true
echo "SENGI-POINTER set exit=$?" >$port
if [ "$compositor" = sengi-compositor ]; then
	sleep 0.5
	kill -USR1 "$(session_compositor_pid)"
	sleep 0.5
	journalctl -b --no-pager -o cat -t sengi-compositor | grep 'input: ' | tail -n 4 |
		sed 's/.*input: /SENGI-POINTER device /' >$port
fi
as_live sengi-settings --set mouse.natural-scroll false
echo "SENGI-POINTER done" >$port

# The screen off, as the idle timer asks for it, and on again. The kernel
# says whether the panel is driven. The test presses a key: under
# sengi-compositor that lights the screen; labwc leaves that to swayidle,
# which has not timed out here, so it is asked.
dpms() {
	cat /sys/class/drm/card*-*/dpms 2>/dev/null | tr '\n' ' '
}
as_live sengi-settings --screen off
status=$?
sleep 1
echo "SENGI-SCREEN asked exit=$status dpms=$(dpms)" >$port
# Left alone it has to stay off. Only when the test has seen that does it
# press the key, so a screen that came back by itself is not taken for
# one the key lit.
sleep 3
echo "SENGI-SCREEN still dpms=$(dpms)" >$port
lit=request
n=0
while [ $n -lt 40 ]; do
	case $(dpms) in
	*Off*) ;;
	*) lit=key; break ;;
	esac
	sleep 0.2
	n=$((n + 1))
done
[ "$lit" = key ] || as_live sengi-settings --screen on
sleep 1
echo "SENGI-SCREEN lit by=$lit dpms=$(dpms)" >$port

# What foot said of the compositor when the test opened a terminal. It
# names each thing it would use and does not find. Its words reach the
# journal only under sengi-compositor, which starts it; there it must
# have spoken, of the things still missing, and not of these three.
if [ "$compositor" = sengi-compositor ]; then
	said=$(journalctl -b --no-pager -o cat -t sengi-compositor | grep -E 'warn: wayland\.c')
	spoke=$(printf '%s\n' "$said" | grep -c .)
	missing=$(printf '%s\n' "$said" |
		grep -c -E 'primary selection|XDG activation|fractional scaling')
	echo "SENGI-FOOT spoke=$spoke missing=$missing" >$port
else
	echo "SENGI-FOOT skipped" >$port
fi

# A terminal that asks to fill the screen from the start, for the test to
# see over the bar and the dock, and then closed again. The test has to
# have taken its picture of the desktop first.
sleep 6
as_live foot --fullscreen --app-id sengi-fullscreen-test sleep 600 >/dev/null 2>&1 &
sleep 3
# The question was answered long ago and nothing of it stays; the welcome
# itself is for an installed system, never this one.
if pidof sengi-welcome >/dev/null; then
	echo "SENGI-FAIL sengi-welcome is running after the live question was answered" >$port
fi
if pgrep -u live -f 'app-id sengi-fullscreen-test' >/dev/null; then
	echo "SENGI-FULLSCREEN up" >$port
else
	echo "SENGI-FULLSCREEN failed" >$port
fi
sleep 6
pkill -u live -f 'app-id sengi-fullscreen-test'
sleep 2
echo "SENGI-FULLSCREEN down" >$port

# Last, the test logs out. greetd then starts the login screen in a
# compositor of its own, both as its own user. Say when they are up, what
# they cost and whether they may turn the machine off; then when PAM has
# turned the wrong password down; then when they have gone and the
# desktop is back, and for whom.
greeter() {
	pgrep -u _greetd -x "$1"
}
n=0
until [ -n "$(greeter sengi-greeter)" ] && greeter_compositor >/dev/null; do
	n=$((n + 1))
	[ $n -lt 900 ] || exit 0
	sleep 0.2
done
# Give it a moment to have drawn, and the session it follows to have gone.
sleep 3
if pidof sengi-bar sengi-dock >/dev/null; then
	echo "SENGI-FAIL the desktop is still running under the login screen" >$port
fi
if pidof sengi-welcome >/dev/null; then
	echo "SENGI-FAIL sengi-welcome is running under the login screen" >$port
fi
# shellcheck disable=SC2046
echo "SENGI-GREETER running pss_kb=$(pss_kb $(greeter_pids)) compositor=$(greeter_compositor)" >$port
ps -u _greetd -o rss=,args= | sed 's/^/SENGI-INFO _greetd runs: /' >$port
may_power_off _greetd
journalctl -f -n 0 -o cat -t greetd 2>/dev/null | while IFS= read -r line; do
	case $line in
	*'authentication failure'*) echo "SENGI-GREETER refused" >$port ;;
	esac
done &
echo "SENGI-GREETER ready" >$port

n=0
while [ -n "$(greeter sengi-greeter)" ]; do
	n=$((n + 1))
	[ $n -lt 900 ] || exit 0
	sleep 0.2
done
echo "SENGI-GREETER gone" >$port
n=0
until desktop_is_up; do
	n=$((n + 1))
	[ $n -lt 150 ] || break
	sleep 0.2
done
sleep 2
left=$(greeter_pids | tr '\n' ' ')
owner=$(loginctl list-sessions --no-legend | awk '$4 == "seat0" && $6 == "user" {print $3; exit}')
desktop=down
if [ "$(session_compositor)" = "$compositor" ] && [ -n "$(session_compositor_pid)" ] &&
	pidof sengi-bar >/dev/null && pidof sengi-dock >/dev/null; then
	desktop=up
fi
echo "SENGI-GREETER after desktop=$desktop session=${owner:-nobody} left=${left:-nothing}" >$port
# The live question is asked once per start, not at every login. By now this
# session would have shown it again.
sleep 6
if pidof sengi-welcome >/dev/null; then
	echo "SENGI-FAIL the live question came back after logging in again" >$port
fi
# What the compositors said as they came and went, with logind's view of
# the sessions between them: how the display passed from one to the next.
journalctl -b --no-pager -o short-monotonic -t sengi-compositor -t sengi-session -t systemd-logind |
	grep -E 'restore|clear state|drm master|New session|Removed session|gave up|started in' |
	tail -n 24 | sed 's/^/SENGI-INFO handover: /' >$port
echo "SENGI-HANDOVER reported" >$port
