#!/bin/sh
# Used by the QEMU boot test. Waits for the desktop, then writes the time it
# took and the idle memory use to the serial port.
port=/dev/ttyS0

until [ -S /run/user/1000/wayland-0 ] && pidof sengi-bar >/dev/null && pidof sengi-dock >/dev/null && pidof mako >/dev/null; do
	sleep 0.1
done
read -r up _ </proc/uptime
echo "SENGI-BOOT desktop_s=$up" >$port

sleep "${SENGI_IDLE_WAIT:-30}"
awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2}
	END {printf "SENGI-IDLE ram_mb=%d\n", (t - a) / 1024}' /proc/meminfo >$port
{
	systemd-analyze time 2>&1
	systemd-analyze blame 2>&1 | head -15
	systemd-analyze critical-chain greetd.service 2>&1 | head -12
	ps -eo rss,comm --sort=-rss | head -32
	systemctl --failed --no-legend 2>&1
	grep -E '^(MemTotal|MemFree|MemAvailable|Shmem|Slab|SReclaimable|SUnreclaim|Cached|AnonPages|Mapped|Unevictable|Percpu):' /proc/meminfo
	journalctl -b --no-pager 2>&1 | grep -i -m6 'portal'
	ls -l /sys/class/drm/*/device/driver 2>&1 | sed 's/.*-> //' | sort -u
	echo "labwc llvm maps: $(grep -c -i llvm "/proc/$(pidof labwc)/maps")"
	df -h / /run /tmp 2>&1
} | sed 's/^/SENGI-INFO /' >$port
# Extra diagnostics can be asked for from the host without rebuilding:
#   -smbios type=11,value=io.systemd.credential:sengi.test.debug=COMMANDS
debug=/run/credentials/@system/sengi.test.debug
if [ -r "$debug" ]; then
	sh "$debug" 2>&1 | sed 's/^/SENGI-DEBUG /' >$port
fi

# A desktop that came up and then lost a piece is a failed boot.
for prog in labwc sengi-bar sengi-dock mako swayidle swaybg sengi-focus; do
	pidof "$prog" >/dev/null || echo "SENGI-FAIL $prog is not running" >$port
done
echo "SENGI-DONE" >$port
