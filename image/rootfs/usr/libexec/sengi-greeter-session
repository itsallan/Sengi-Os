#!/bin/sh
# Started by greetd, as its own user, whenever nobody is logged in: the
# login screen and a compositor for it to be shown in.
#
# The compositor is the one the session will run on, by the same choice;
# see compositor.sh. Ours is started as the login screen's: no key
# bindings, no locker, and the keyboard layout from the same file labwc
# takes it from, where the installer wrote the one chosen. Either ends
# when the login screen does, which is what lets greetd start the session
# of whoever logged in.
. /usr/lib/sengi-os/compositor.sh

if [ "$(wanted_compositor)" = own ]; then
	export_environment /usr/share/sengi-os/greeter/environment
	own_compositor --greeter --session /usr/bin/sengi-greeter
fi

# labwc is given a configuration directory of its own. With that it reads
# nothing from /etc/xdg/labwc and nothing from a home directory, so none
# of the desktop's key bindings, menus or start-up programs exist here.
. /usr/lib/sengi-os/renderer.sh

exec labwc -C /usr/share/sengi-os/greeter -S /usr/bin/sengi-greeter
