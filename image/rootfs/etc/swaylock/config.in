# Sengi OS lock screen. Rendered from tokens/sengi.toml.
daemonize
show-failed-attempts
indicator-idle-visible
color=@{color.desktop|nohash}
font=@{type.family}
font-size=@{type.size-lg}
indicator-radius=@{size.lock-indicator}
indicator-thickness=@{size.lock-ring}
inside-color=@{color.surface|hex8}
inside-clear-color=@{color.surface|hex8}
inside-ver-color=@{color.surface|hex8}
inside-wrong-color=@{color.surface|hex8}
ring-color=@{color.border|hex8}
ring-clear-color=@{color.warning|hex8}
ring-ver-color=@{color.accent|hex8}
ring-wrong-color=@{color.danger|hex8}
key-hl-color=@{color.accent|hex8}
bs-hl-color=@{color.danger|hex8}
line-color=@{color.desktop|hex8}
line-clear-color=@{color.desktop|hex8}
line-ver-color=@{color.desktop|hex8}
line-wrong-color=@{color.desktop|hex8}
separator-color=@{color.desktop|hex8}
text-color=@{color.text|hex8}
text-clear-color=@{color.text|hex8}
text-ver-color=@{color.text|hex8}
text-wrong-color=@{color.danger|hex8}
