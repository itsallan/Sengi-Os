# Sengi OS notifications. Rendered from tokens/sengi.toml.
font=@{type.family} @{type.pt-md}
anchor=top-right
layer=overlay
width=@{size.notification-width}
margin=@{space.sm}
padding=@{space.md}
border-size=@{border.width}
border-radius=@{radius.base}
background-color=#@{color.surface|hex8}
text-color=#@{color.text|hex8}
border-color=#@{color.border|hex8}
progress-color=over #@{color.accent|hex8}
default-timeout=@{timing.notification-timeout}
max-visible=4
icons=0

[urgency=critical]
border-color=#@{color.danger|hex8}
default-timeout=0
