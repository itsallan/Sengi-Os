# Started by labwc once the compositor is up.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP >/dev/null 2>&1 &
swaybg -c '@{color.desktop}' >/dev/null 2>&1 &
waybar >/dev/null 2>&1 &
# Waybar asks the desktop portal for the colour scheme as it starts, which
# would wake about 50 MB of portal services on every login. The portal's
# D-Bus activation file is diverted at build time and only put in place here,
# once Waybar is up, so apps still get the portal on demand. This goes away
# with Waybar in 0.2.
(
	sleep 5
	mkdir -p "$XDG_RUNTIME_DIR/dbus-1/services"
	cp /usr/share/sengi-os/dbus/org.freedesktop.portal.Desktop.service \
		"$XDG_RUNTIME_DIR/dbus-1/services/"
	dbus-send --session --dest=org.freedesktop.DBus --type=method_call \
		/org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig
) >/dev/null 2>&1 &
mako -c /etc/xdg/mako/config >/dev/null 2>&1 &
swayidle -w timeout @{timing.idle-lock} 'swaylock -f' before-sleep 'swaylock -f' >/dev/null 2>&1 &
