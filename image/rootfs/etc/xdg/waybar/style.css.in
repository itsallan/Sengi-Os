/* The dock. Rendered from tokens/sengi.toml. */

* {
    font-family: "@{type.family}";
    font-size: @{type.size-md}px;
    font-weight: @{type.weight-regular};
    border: none;
    border-radius: 0;
    min-height: 0;
    box-shadow: none;
    text-shadow: none;
}

window#waybar.dock {
    background: transparent;
}

window#waybar.dock .modules-center {
    background: @{color.dock|rgba};
    border: @{border.width}px solid @{color.border};
    border-radius: @{radius.base}px;
    padding: @{size.dock-padding}px;
}

window#waybar.dock #image,
#taskbar button {
    padding: @{space.xxs}px;
    border-radius: @{radius.base}px;
    transition: background-color @{motion.fast}ms @{motion.easing};
}

window#waybar.dock #image:hover,
#taskbar button:hover {
    background: @{color.surface-hover};
}

#taskbar button.active {
    background: @{color.surface-raised};
    box-shadow: inset 0 -@{space.xxs}px @{color.accent};
}

tooltip {
    background: @{color.surface};
    border: @{border.width}px solid @{color.border};
    border-radius: @{radius.base}px;
}

tooltip label {
    color: @{color.text};
    font-size: @{type.size-sm}px;
}
