// The dock. The top bar is sengi-bar; Waybar only draws this until sengi-dock
// replaces it.
[
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "margin-bottom": @{space.sm},
    "spacing": @{space.xs},
    "modules-center": ["image#launcher", "image#terminal", "wlr/taskbar"],

    "image#launcher": {
      "path": "/usr/share/sengi-os/icons/launcher.svg",
      "size": @{size.dock-icon},
      "tooltip": false,
      "on-click": "fuzzel"
    },
    "image#terminal": {
      "path": "/usr/share/sengi-os/icons/terminal.svg",
      "size": @{size.dock-icon},
      "tooltip": false,
      "on-click": "sengi-run foot"
    },
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": @{size.dock-icon},
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close"
    }
  }
]
