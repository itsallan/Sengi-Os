# Builder for the Sengi OS ISO. The build tools come from the same Debian
# snapshot as the image itself, so the toolchain is pinned too. That takes
# the snapshot's updates and security suites as well: the base image already
# carries fixes from them, and a -dev package wants its library at the very
# same version.
FROM docker.io/library/debian:trixie-slim

ARG SNAPSHOT
ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/sources.list.d/* \
 && printf 'deb http://snapshot.debian.org/archive/%s trixie%s main\n' \
      "debian/${SNAPSHOT}" "" "debian/${SNAPSHOT}" -updates "debian-security/${SNAPSHOT}" -security \
      >/etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends \
      mmdebstrap squashfs-tools xorriso mtools dosfstools \
      grub-common grub-pc-bin grub-efi-amd64-bin \
      ca-certificates zstd faketime rustup gcc libc6-dev pkg-config libfontconfig-dev libxkbcommon-dev \
      libseat-dev libinput-dev libudev-dev libgbm-dev libpixman-1-dev \
 && rm -rf /var/lib/apt/lists/*

# Slint needs a newer Rust than Debian stable ships, so the compiler comes
# from rustup at the exact version rust-toolchain.toml names.
ARG RUST_VERSION
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN rustup toolchain install "${RUST_VERSION}" --profile minimal \
 && rustup default "${RUST_VERSION}"
