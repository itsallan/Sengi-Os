# Builder for the Sengi OS ISO. The build tools come from the same Debian
# snapshot as the image itself, so the toolchain is pinned too.
FROM docker.io/library/debian:trixie-slim

ARG SNAPSHOT
ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/sources.list.d/* \
 && echo "deb http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie main" >/etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends \
      mmdebstrap squashfs-tools xorriso mtools dosfstools \
      grub-common grub-pc-bin grub-efi-amd64-bin \
      ca-certificates zstd \
 && rm -rf /var/lib/apt/lists/*
