# Packages in the Sengi OS base image, one per line.
# Recommends are off, so anything we rely on has to be listed here.

# Base system
systemd-sysv
systemd-resolved
systemd-timesyncd
systemd-oomd
systemd-zram-generator
libpam-systemd
libnss-systemd
dbus-user-session
udev
kmod
procps
iproute2
ca-certificates
sudo
less
nano

# Kernel and initramfs
linux-image-amd64
initramfs-tools
busybox
zstd

# Session
greetd
# logind asks polkit whether a user may restart or shut down the machine,
# or hold off sleep until the screen is locked, and without it refuses
# everyone but root. Not enabled: logind's first question starts it, which
# is swayidle's when the session comes up.
polkitd
# Settings, Updates runs sengi-update as root through pkexec, which brings
# its own password prompt for a program that has no polkit agent. Nothing
# is resident: pkexec runs for the length of one update.
pkexec
#
# Files opens USB sticks and external disks through udisksctl, which asks
# udisksd, which asks polkit. Its stock policy lets the person at the screen
# open and eject a drive with no password, so no rule of ours is needed.
# udisksd is started by the bus on the first request and is not enabled at
# boot (see customize.sh); the file system drivers it uses are the
# kernel's (vfat, exfat, ntfs3, ext4).
udisks2
labwc
xwayland
swayidle
swaybg
foot
libgl1-mesa-dri
librsvg2-common
libfontconfig1
libxkbcommon0
# sengi-lock checks the password through PAM, with pam_unix and its helper.
libpam0g
libpam-modules
libx11-data
hicolor-icon-theme
fonts-inter
fonts-dejavu-mono

# Audio, network, bluetooth
pipewire
pipewire-pulse
wireplumber
# ALSA's default device leads to PipeWire, for programs that know only ALSA.
pipewire-alsa
# Which switches and levels make up the speakers, headphones and microphones
# of cards that run through a sound DSP, as many laptops' do.
alsa-ucm-conf
# aplay and amixer to look at a card with, and alsactl, which udev runs to
# set a new card's levels and to keep them across a restart. Nothing stays
# running.
alsa-utils
# Bluetooth headphones and speakers: a plugin WirePlumber loads.
libspa-0.2-bluetooth
# The DSP firmware those cards need is not free software and is added by
# build.sh with the rest of the firmware.
iwd
bluez

# Apps
flatpak
xdg-desktop-portal-gtk

# The installer. sengi-install partitions with sfdisk, makes the file
# systems, and installs GRUB for both kinds of firmware. All of it stays
# on the installed system, which needs fsck, and GRUB to take a new kernel.
# The grub-pc and grub-efi-amd64 packages themselves are left out: they
# would install a boot loader on whatever machine builds the image.
fdisk
dosfstools
e2fsprogs
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
# Installing beside another system: update-grub runs os-prober to put
# Windows and other systems in the boot menu.
os-prober
# Making Windows smaller to install beside it: ntfsresize and ntfs-3g.probe.
# For the live system only; sengi-install takes it off what it installs.
ntfs-3g
